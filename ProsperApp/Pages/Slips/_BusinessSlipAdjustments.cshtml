@model SlipEditModel
@{
    var adjustments = Model.Detail?.ChargeLines
        .Where(x => string.Equals(x.Status, "active", StringComparison.Ordinal) && string.Equals(x.ChargeType, "adjustment", StringComparison.Ordinal))
        .OrderBy(x => x.LineNo)
        .ToList() ?? [];
}

<div data-business-slip-editor-result="adjustments">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <section class="slip-create__panel">
        <div class="slip-create__panel-title">
            <div class="slip-create__panel-heading">
                <h3>自由入力明細</h3>
                <small>@adjustments.Count 件 / @StoreUiText.Yen(adjustments.Sum(x => x.Amount))</small>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0 slip-detail-table">
                <thead><tr><th>明細</th><th class="text-end">金額</th></tr></thead>
                <tbody>
                    @if (adjustments.Count == 0)
                    {
                        <tr><td colspan="2" class="text-muted">自由入力明細はまだ登録されていません。</td></tr>
                    }
                    else
                    {
                        @foreach (var adjustment in adjustments)
                        {
                            <tr><td>@adjustment.LineName</td><td class="text-end">@StoreUiText.Amount(adjustment.Amount)</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <form method="post" asp-page-handler="AddAdjustment" class="slip-create__panel mt-3" data-business-slip-editor-form data-business-adjustment-form data-loading-lock="false">
        <input type="hidden" asp-for="SlipId" />
        <input type="hidden" name="EditorSurface" value="business-home" />
        <div class="slip-create__panel-title"><h3>自由入力明細を追加</h3></div>
        <div class="row g-3 align-items-end">
            <div class="col-md-7">
                <label class="form-label" asp-for="AdjustmentInput.LineName">明細名</label>
                <input class="form-control form-control-lg" asp-for="AdjustmentInput.LineName" maxlength="160" placeholder="例: 値引き" data-business-adjustment-name />
                <span asp-validation-for="AdjustmentInput.LineName" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="AdjustmentInput.Amount">価格</label>
                <input class="form-control form-control-lg" asp-for="AdjustmentInput.Amount" type="number" step="1" placeholder="0" data-business-adjustment-amount />
                <span asp-validation-for="AdjustmentInput.Amount" class="text-danger"></span>
                <small class="text-muted">値引きはマイナスで入力できます。</small>
            </div>
            <div class="col-md-2 d-grid"><button class="btn btn-primary btn-lg" type="submit">追加</button></div>
        </div>
    </form>
</div>
