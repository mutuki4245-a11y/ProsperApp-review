@using ProsperApp.Models
@model SlipEditModel
@if (string.Equals(Model.EditorSurface, "business-home", StringComparison.Ordinal))
{
    @if (Model.IsOpenSlip)
    {
        <partial name="_BusinessSlipNominations" model="Model" />
    }
    else
    {
        <div class="alert alert-warning mb-0" role="alert">この伝票は会計準備中または会計済みのため編集できません。営業中一覧を再表示してください。</div>
    }
}
else
{
    var nominationOptions = Model.NominationOptions
        .Select(x => (Value: x.NominationKind, Label: x.DisplayName))
        .ToArray();
    var hasNominationOptions = nominationOptions.Length > 0;
    var nominationCount = Model.Detail?.Nominations.Count ?? 0;
    var nominationTotal = Model.Detail?.Nominations.Sum(x => x.NominationPrice) ?? 0;

<div class="slip-create__panel" id="slipNominationsPanel">
    <div class="slip-create__panel-title">
        <div class="slip-create__panel-heading">
            <h2>指名一覧</h2>
            <small>@nominationCount 件 / @StoreUiText.Yen(nominationTotal)</small>
        </div>
        <div class="slip-create__panel-title-actions">
            @if (Model.IsOpenSlip && Model.AttendanceCasts.Count > 0)
            {
                <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#addNominationModal" disabled="@(!hasNominationOptions)">指名を追加</button>
            }
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0 slip-detail-table slip-detail-table--nominations">
            <colgroup>
                <col class="slip-detail-table__col--time" />
                <col class="slip-detail-table__col--type" />
                <col class="slip-detail-table__col--primary" />
                <col class="slip-detail-table__col--amount" />
            </colgroup>
            <thead>
                <tr>
                    <th class="slip-detail-table__time">時刻</th>
                    <th class="slip-detail-table__type">区分</th>
                    <th class="slip-detail-table__primary">キャスト</th>
                    <th class="slip-detail-table__amount text-end">指名料金</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Detail is null || Model.Detail.Nominations.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-muted">指名はまだ登録されていません。</td>
                    </tr>
                }
                else
                {
                    @foreach (var nomination in Model.Detail.Nominations.OrderBy(x => x.StartedAt))
                    {
                        <tr>
                            <td class="slip-detail-table__time">@Model.FormatStoreTime(nomination.StartedAt)</td>
                            <td class="slip-detail-table__type">@nomination.NominationDisplayName</td>
                            <td class="slip-detail-table__primary">@nomination.CastDisplayName</td>
                            <td class="slip-detail-table__amount text-end">@StoreUiText.Amount(nomination.NominationPrice)</td>
                        </tr>
                    }
                }
                @if (Model.IsOpenSlip && Model.AttendanceCasts.Count == 0)
                {
                    <tr class="slip-detail-add-row">
                        <td colspan="4">
                            <div class="alert alert-secondary mb-0">出勤キャストが未登録です。指名を追加するには勤怠入力で出勤者を登録してください。</div>
                        </td>
                    </tr>
                }
                @if (Model.IsOpenSlip && Model.AttendanceCasts.Count > 0 && !hasNominationOptions)
                {
                    <tr class="slip-detail-add-row">
                        <td colspan="4">
                            <div class="alert alert-secondary mb-0">指名種別マスタが未登録です。</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.IsOpenSlip && Model.AttendanceCasts.Count > 0 && hasNominationOptions)
{
    <div class="modal fade" id="addNominationModal" tabindex="-1" aria-labelledby="addNominationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <form method="post" asp-page-handler="AddNominations" data-nomination-row data-partial-form="nominations">
                    <div class="modal-header">
                        <div>
                            <p class="store-home__eyebrow mb-1">指名一覧</p>
                            <h2 class="modal-title fs-5" id="addNominationModalLabel">指名を追加</h2>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                    </div>
                    <div class="modal-body slip-modal-form">
                        <input type="hidden" asp-for="SlipId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                        <span asp-validation-for="AddNominationsInput.CastNominations" class="text-danger"></span>
                        <partial name="_SlipNominationAddFields" model="Model" />
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">閉じる</button>
                        <button class="btn btn-primary btn-lg" type="submit">保存</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
}
