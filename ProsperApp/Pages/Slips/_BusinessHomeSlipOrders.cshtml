@using ProsperApp.Models
@model SlipEditModel
@{
    var orders = Model.Detail?.Orders.Where(x => string.Equals(x.Status, "active", StringComparison.Ordinal)).OrderBy(x => x.OrderedAt).ThenBy(x => x.LineNo).ToList() ?? [];
    var orderableItems = Model.OrderItems.Where(x => x.IsStandard).ToList();
}

<div data-business-slip-editor-result="orders" data-business-slip-editor-manager>
    <section class="slip-create__panel business-slip-editor-list">
        <div class="slip-create__panel-title">
            <div class="slip-create__panel-heading"><h3>注文</h3><small>@orders.Count 件 / @StoreUiText.Yen(orders.Sum(x => x.Amount))</small></div>
            @if (orderableItems.Count > 0)
            {
                <button class="btn btn-sm btn-primary" type="button" data-business-editor-action="order_add">注文を追加</button>
            }
        </div>
        <div class="business-slip-editor-list__rows">
            @if (orders.Count == 0)
            {
                <p class="text-muted mb-0">注文はまだ登録されていません。</p>
            }
            else
            {
                @foreach (var order in orders)
                {
                    <article class="business-slip-editor-list__row">
                        <div>
                            <strong>@order.ItemNameSnapshot</strong>
                            <span>@Model.FormatStoreTime(order.OrderedAt) / @StoreUiText.Amount(order.UnitPrice) × @StoreUiText.Quantity(order.Quantity)@(!string.IsNullOrWhiteSpace(order.BackCastDisplayName) ? $" / {order.BackCastDisplayName}" : string.Empty) / @StoreUiText.Amount(order.Amount)</span>
                        </div>
                        @if (order.IsStandard)
                        {
                            <button class="btn btn-sm btn-outline-danger" type="button" data-business-editor-action="order_delete" data-business-editor-record-id="@order.OrderLineId" data-business-editor-record-display="@order.ItemNameSnapshot">削除</button>
                        }
                        else
                        {
                            <span class="text-muted">削除不可</span>
                        }
                    </article>
                }
            }
        </div>
    </section>

    @if (orderableItems.Count == 0)
    {
        <div class="alert alert-secondary mt-3 mb-0">注文可能な商品が未登録です。</div>
    }

    <template data-business-editor-template="order_add">
        <form class="slip-create__panel business-slip-editor-action-form" data-business-slip-editor-form data-business-order-queue-form data-loading-lock="false">
            <input type="hidden" name="SlipId" value="@Model.SlipId" />
            <div class="business-slip-editor-action-form__title"><button class="btn btn-sm btn-outline-secondary" type="button" data-business-editor-action="back">戻る</button><h3>注文を追加</h3></div>
            <input type="hidden" name="OrderQueueJson" id="detailOrderQueueJson" value="[]" />
            <span class="text-danger" data-business-order-queue-error></span>
            <div hidden data-business-order-casts>
                @foreach (var cast in Model.AttendanceCasts)
                {
                    <span data-business-order-cast-id="@cast.CastId" data-business-order-cast-name="@cast.DisplayName" data-business-order-cast-memo="@cast.DrinkMemo"></span>
                }
            </div>
            <partial name="_SlipOrderQueueFields" model="Model" />
            <button class="btn btn-primary btn-lg align-self-end" type="submit" id="detailSubmitOrderButton" data-submit-base-disabled="@((orderableItems.Count == 0).ToString().ToLowerInvariant())" disabled>オーダー保存</button>
        </form>
    </template>
</div>
