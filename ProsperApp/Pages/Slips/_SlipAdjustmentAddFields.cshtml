@model SlipEditModel

<div class="row g-3">
    <div class="col-12">
        <label class="form-label" asp-for="AdjustmentInput.LineName">明細名</label>
        <input class="form-control form-control-lg" asp-for="AdjustmentInput.LineName" maxlength="160" placeholder="例: 値引き" data-adjustment-name />
        <span asp-validation-for="AdjustmentInput.LineName" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label class="form-label" asp-for="AdjustmentInput.Amount">価格</label>
        <input class="form-control form-control-lg" asp-for="AdjustmentInput.Amount" type="number" step="1" placeholder="0" data-adjustment-amount />
        <span asp-validation-for="AdjustmentInput.Amount" class="text-danger"></span>
        <small class="text-muted">値引きはマイナスで入力できます。</small>
    </div>
</div>
