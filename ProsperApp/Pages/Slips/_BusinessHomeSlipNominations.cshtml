@model SlipEditModel
@{
    var nominations = Model.Detail?.Nominations
        .Where(x => string.Equals(x.Status, "active", StringComparison.Ordinal))
        .OrderBy(x => x.StartedAt)
        .ToList() ?? [];
    var canAdd = Model.AttendanceCasts.Count > 0 && Model.NominationOptions.Count > 0;
}

<div data-business-slip-editor-result="nominations" data-business-slip-editor-manager>
    <section class="slip-create__panel business-slip-editor-list">
        <div class="slip-create__panel-title">
            @if (canAdd)
            {
                <button class="btn btn-sm btn-primary" type="button" data-business-editor-action="nomination_add">指名を追加</button>
            }
        </div>
        <div class="business-slip-editor-list__rows">
            @if (nominations.Count == 0)
            {
                <p class="text-muted mb-0">指名はまだ登録されていません。</p>
            }
            else
            {
                @foreach (var nomination in nominations)
                {
                    <article class="business-slip-editor-list__row">
                        <div><strong>@nomination.CastDisplayName</strong><span>@nomination.NominationDisplayName</span></div>
                        <button class="btn btn-sm btn-outline-danger" type="button" data-business-editor-action="nomination_delete" data-business-editor-record-id="@nomination.SlipCastId" data-business-editor-record-display="@nomination.CastDisplayName（@nomination.NominationDisplayName）">削除</button>
                    </article>
                }
            }
        </div>
    </section>

    @if (!canAdd)
    {
        <div class="alert alert-secondary mt-3 mb-0">@(Model.AttendanceCasts.Count == 0 ? "出勤キャストが未登録です。" : "指名種別マスタが未登録です。")</div>
    }

    <template data-business-editor-template="nomination_add">
        <form class="slip-create__panel business-slip-editor-action-form" data-business-slip-editor-form data-loading-lock="false">
            <input type="hidden" name="SlipId" value="@Model.SlipId" />
            <div class="business-slip-editor-action-form__title"><button class="btn btn-sm btn-outline-secondary" type="button" data-business-editor-action="back">戻る</button><h3>指名を追加</h3></div>
            <partial name="_SlipNominationAddFields" model="Model" />
            <button class="btn btn-primary btn-lg align-self-end" type="submit">追加を保存</button>
        </form>
    </template>
</div>
