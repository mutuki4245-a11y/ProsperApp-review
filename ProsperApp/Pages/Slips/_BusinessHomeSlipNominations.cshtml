@using ProsperApp.Models
@model SlipEditModel
@{
    var nominationOptions = Model.NominationOptions
        .Select(x => (Value: x.NominationKind, Label: x.DisplayName, IsCompanion: string.Equals(x.NominationType, "companion", StringComparison.Ordinal)))
        .ToArray();
    var nominations = Model.Detail?.Nominations
        .Where(x => string.Equals(x.Status, "active", StringComparison.Ordinal))
        .OrderBy(x => x.StartedAt)
        .ToList() ?? [];
    var addNomination = Model.AddNominationsInput.CastNominations.FirstOrDefault() ?? new CastNominationInputModel { NominationKind = nominationOptions.FirstOrDefault().Value };
    var nominationPriceOptions = Enumerable.Range(1, 20).Select(x => x * 1000).ToArray();
    var canAdd = Model.AttendanceCasts.Count > 0 && nominationOptions.Length > 0;
}

<div data-business-slip-editor-result="nominations" data-business-slip-editor-manager>
    <section class="slip-create__panel business-slip-editor-list">
        <div class="slip-create__panel-title">
            <div class="slip-create__panel-heading"><h3>指名一覧</h3><small>@nominations.Count 件 / @StoreUiText.Yen(nominations.Sum(x => x.NominationPrice))</small></div>
            @if (canAdd)
            {
                <button class="btn btn-sm btn-primary" type="button" data-business-editor-action="nomination_add">指名を追加</button>
            }
        </div>
        <div class="business-slip-editor-list__rows">
            @if (nominations.Count == 0)
            {
                <p class="text-muted mb-0">指名はまだ登録されていません。</p>
            }
            else
            {
                @foreach (var nomination in nominations)
                {
                    <article class="business-slip-editor-list__row">
                        <div><strong>@nomination.CastDisplayName</strong><span>@nomination.NominationDisplayName / @StoreUiText.Amount(nomination.NominationPrice) / @Model.FormatStoreTime(nomination.StartedAt)</span></div>
                        <button class="btn btn-sm btn-outline-danger" type="button" data-business-editor-action="nomination_delete" data-business-editor-record-id="@nomination.SlipCastId" data-business-editor-record-display="@nomination.CastDisplayName（@nomination.NominationDisplayName）">削除</button>
                    </article>
                }
            }
        </div>
    </section>

    @if (!canAdd)
    {
        <div class="alert alert-secondary mt-3 mb-0">@(Model.AttendanceCasts.Count == 0 ? "出勤キャストが未登録です。" : "指名種別マスタが未登録です。")</div>
    }

    <template data-business-editor-template="nomination_add">
        <form class="slip-create__panel business-slip-editor-action-form" data-business-slip-editor-form data-loading-lock="false">
            <input type="hidden" name="SlipId" value="@Model.SlipId" />
            <div class="business-slip-editor-action-form__title"><button class="btn btn-sm btn-outline-secondary" type="button" data-business-editor-action="back">戻る</button><h3>指名を追加</h3></div>
            <div class="row g-3 align-items-end">
                <div class="col-md-4"><label class="form-label">指名区分</label><select class="form-select form-select-lg nomination-row__kind" name="AddNominationsInput.CastNominations[0].NominationKind" required>@foreach (var option in nominationOptions) { <option value="@option.Value" selected="@(addNomination.NominationKind == option.Value)" data-companion="@option.IsCompanion.ToString().ToLowerInvariant()">@option.Label</option> }</select></div>
                <div class="col-md-3"><label class="form-label">指名料金</label><select class="form-select form-select-lg nomination-row__price" name="AddNominationsInput.CastNominations[0].NominationPrice">@foreach (var price in nominationPriceOptions) { <option value="@price" selected="@(addNomination.NominationPrice == price)">@StoreUiText.Yen(price)</option> }</select></div>
                <div class="col-md-3"><label class="form-label">キャスト</label><select class="form-select form-select-lg" name="AddNominationsInput.CastNominations[0].CastId" required><option value="">キャストを選択</option>@foreach (var cast in Model.AttendanceCasts) { var label = string.IsNullOrWhiteSpace(cast.DepartmentName) ? cast.DisplayName : $"{cast.DisplayName} / {cast.DepartmentName}"; <option value="@cast.CastId" selected="@(addNomination.CastId == cast.CastId)">@label</option> }</select></div>
                <div class="col-md-2 d-grid"><button class="btn btn-primary btn-lg" type="submit">追加を保存</button></div>
            </div>
        </form>
    </template>
</div>
