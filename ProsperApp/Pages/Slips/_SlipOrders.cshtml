@model SlipEditModel
@{
    var detail = Model.Detail!;
    var activeOrders = detail.Orders
        .Where(x => string.Equals(x.Status, "active", StringComparison.Ordinal))
        .OrderBy(x => x.LineNo)
        .ToList();
    var activeNonKaraokeOrders = activeOrders
        .Where(x => !x.IsKaraoke)
        .ToList();
    var activeKaraokeOrder = activeOrders
        .Where(x => x.IsKaraoke)
        .OrderBy(x => x.LineNo)
        .FirstOrDefault();
    var activeKaraokeQuantity = activeOrders
        .Where(x => x.IsKaraoke)
        .Sum(x => x.Quantity);
    var orderableItems = Model.OrderItems
        .Where(x => !x.IsKaraoke)
        .ToList();
    var karaokeItem = Model.OrderItems.FirstOrDefault(x => x.IsKaraoke);
    var karaokeUnitPrice = activeKaraokeOrder?.UnitPrice ?? karaokeItem?.DefaultPrice ?? 200;
    var karaokeAmount = activeKaraokeQuantity * karaokeUnitPrice;
    var activeOrderTotal = activeOrders.Sum(x => x.Amount);
    var nonKaraokeOrderTotal = activeOrderTotal - (activeKaraokeOrder?.Amount ?? 0);
    var firstCustomer = detail.Customers
        .Where(x => !string.Equals(x.Status, "cancelled", StringComparison.Ordinal))
        .OrderBy(x => x.EnteredAt)
        .FirstOrDefault();
    var karaokeOrderedAt = activeKaraokeOrder?.OrderedAt ?? firstCustomer?.EnteredAt ?? detail.OpenedAt;
    var showKaraokeOrderRow = Model.IsOpenSlip || activeKaraokeQuantity > 0;
    var activeCharges = detail.ChargeLines
        .Where(x => string.Equals(x.Status, "active", StringComparison.Ordinal))
        .OrderBy(x => x.LineNo)
        .ToList();
    var activeAdjustments = activeCharges
        .Where(x => string.Equals(x.ChargeType, "adjustment", StringComparison.Ordinal))
        .ToList();
    var chargeTotal = activeAdjustments.Sum(x => x.Amount);
    var orderItemGroups = orderableItems
        .GroupBy(x => x.CategoryName)
        .ToList();
}

        <div class="slip-create__panel">
            <div class="slip-create__panel-title">
                <div class="slip-create__panel-heading">
                    <h2>オーダー一覧</h2>
                    <small>@activeOrders.Count 件 / @activeOrderTotal.ToString("N0") 円</small>
                </div>
                <div class="slip-create__panel-title-actions">
                    @if (Model.IsOpenSlip && showKaraokeOrderRow)
                    {
                        <output class="terminal-save-status" data-detail-karaoke-status data-save-state="saved" aria-live="polite">保存済み</output>
                    }
                    <span class="terminal-count-badge">@activeOrders.Count 件</span>
                </div>
            </div>

            @if (showKaraokeOrderRow && Model.IsOpenSlip)
            {
                <form method="post" asp-page-handler="SaveKaraoke" id="detailKaraokeForm" data-detail-karaoke-form></form>
            }

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 slip-detail-table slip-detail-table--orders">
                    <colgroup>
                        <col class="slip-detail-table__col--time" />
                        <col class="slip-detail-table__col--primary" />
                        <col class="slip-detail-table__col--amount" />
                        <col class="slip-detail-table__col--quantity" />
                        <col class="slip-detail-table__col--amount" />
                        <col class="slip-detail-table__col--action" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="slip-detail-table__time">時刻</th>
                            <th class="slip-detail-table__primary">商品</th>
                            <th class="slip-detail-table__amount text-end">単価</th>
                            <th class="slip-detail-table__quantity text-end">数量</th>
                            <th class="slip-detail-table__amount text-end">小計</th>
                            <th class="slip-detail-table__action text-end">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (activeNonKaraokeOrders.Count == 0 && !showKaraokeOrderRow)
                        {
                            <tr>
                                <td colspan="6" class="text-muted">注文はまだ登録されていません。</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in activeNonKaraokeOrders)
                            {
                                <tr>
                                    <td class="slip-detail-table__time">@Model.FormatStoreTime(order.OrderedAt)</td>
                                    <td class="slip-detail-table__primary">@order.ItemNameSnapshot</td>
                                    <td class="slip-detail-table__amount text-end">@order.UnitPrice.ToString("N0")</td>
                                    <td class="slip-detail-table__quantity text-end">@order.Quantity.ToString("0.##")</td>
                                    <td class="slip-detail-table__amount text-end">@order.Amount.ToString("N0")</td>
                                    <td class="slip-detail-table__action text-end">
                                        <form method="post" asp-page-handler="VoidOrder" class="d-inline">
                                            <input type="hidden" asp-for="SlipId" />
                                            <input type="hidden" name="orderLineId" value="@order.OrderLineId" />
                                            <button class="btn btn-outline-danger btn-sm" type="submit">削除</button>
                                        </form>
                                    </td>
                                </tr>
                            }

                            @if (showKaraokeOrderRow)
                            {
                                <tr>
                                    <td class="slip-detail-table__time">@Model.FormatStoreTime(karaokeOrderedAt)</td>
                                    <td class="slip-detail-table__primary">カラオケ</td>
                                    <td class="slip-detail-table__amount text-end">@karaokeUnitPrice.ToString("N0")</td>
                                    <td class="slip-detail-table__quantity text-end">
                                        @if (Model.IsOpenSlip)
                                        {
                                            <input form="detailKaraokeForm" type="hidden" name="SlipId" value="@detail.SlipId" />
                                            <input form="detailKaraokeForm" type="hidden" name="KaraokeLines[0].SlipId" value="@detail.SlipId" />
                                            <input form="detailKaraokeForm" type="hidden" name="KaraokeLines[0].Quantity" value="@activeKaraokeQuantity" data-detail-karaoke-input />
                                            <div class="quantity-stepper quantity-stepper--compact">
                                                <button class="btn btn-outline-secondary btn-sm" type="button" data-detail-karaoke-decrement>-</button>
                                                <strong data-detail-karaoke-display>@activeKaraokeQuantity.ToString("0")</strong>
                                                <button class="btn btn-outline-primary btn-sm" type="button" data-detail-karaoke-increment>+</button>
                                            </div>
                                        }
                                        else
                                        {
                                            @activeKaraokeQuantity.ToString("0.##")
                                        }
                                    </td>
                                    <td class="slip-detail-table__amount text-end" data-detail-karaoke-amount data-detail-karaoke-unit-price="@karaokeUnitPrice">@karaokeAmount.ToString("N0")</td>
                                    <td class="slip-detail-table__action text-end">
                                        @if (Model.IsOpenSlip)
                                        {
                                            <button class="btn btn-primary btn-sm" type="submit" form="detailKaraokeForm" data-detail-karaoke-save disabled>保存</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        <tr class="slip-detail-add-row">
                            <td colspan="6">
                                @if (Model.CanAddOrders)
                                {
                                    <button class="btn btn-outline-primary w-100" type="button" data-bs-toggle="modal" data-bs-target="#slipOrderModal">オーダー追加</button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary w-100" type="button" disabled>オーダー追加できません</button>
                                }
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="4">商品小計</th>
                            <th class="slip-detail-table__amount text-end" data-detail-order-total data-detail-order-base-total="@nonKaraokeOrderTotal">@activeOrderTotal.ToString("N0")</th>
                            <th class="slip-detail-table__action">円</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="slip-create__panel">
            <div class="slip-create__panel-title">
                <div class="slip-create__panel-heading">
                    <h2>自由入力明細</h2>
                    <small>@activeAdjustments.Count 件 / @chargeTotal.ToString("N0") 円</small>
                </div>
                <span class="terminal-count-badge">@chargeTotal.ToString("N0") 円</span>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 slip-detail-table">
                    <colgroup>
                        <col class="slip-detail-table__col--type" />
                        <col class="slip-detail-table__col--primary" />
                        <col class="slip-detail-table__col--quantity" />
                        <col class="slip-detail-table__col--amount" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>種別</th>
                            <th>明細</th>
                            <th class="text-end">数量</th>
                            <th class="text-end">金額</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (activeAdjustments.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-muted">自由入力明細はまだ登録されていません。</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var charge in activeAdjustments)
                            {
                                <tr>
                                    <td>@charge.ChargeTypeDisplayName</td>
                                    <td>@charge.LineName</td>
                                    <td class="text-end">@charge.Quantity.ToString("0.##")</td>
                                    <td class="text-end">@charge.Amount.ToString("N0")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.IsOpenSlip)
            {
                <div class="slip-charge-editor">
                    <form method="post" asp-page-handler="SaveAdjustments" data-adjustment-form>
                        <input type="hidden" asp-for="SlipId" />
                        <div class="slip-create__panel-title">
                            <div class="slip-create__panel-heading">
                                <h3>自由入力明細</h3>
                                <small>明細名と金額を入力して保存</small>
                            </div>
                            <div class="slip-create__panel-title-actions">
                                <output class="terminal-save-status" data-adjustment-status data-save-state="saved" aria-live="polite">保存済み</output>
                                <button class="btn btn-outline-primary" type="button" data-add-adjustment-row>明細を追加</button>
                            </div>
                        </div>
                        <span asp-validation-for="AdjustmentsInput.Lines" class="text-danger"></span>
                        <div class="adjustment-list" data-adjustment-list>
                            @for (var i = 0; i < Model.AdjustmentsInput.Lines.Count; i++)
                            {
                                <div class="adjustment-row" data-adjustment-row>
                                    <input class="form-control" name="AdjustmentsInput.Lines[@i].LineName" value="@Model.AdjustmentsInput.Lines[i].LineName" maxlength="160" placeholder="明細名" data-adjustment-name />
                                    <input class="form-control" name="AdjustmentsInput.Lines[@i].Amount" value="@Model.AdjustmentsInput.Lines[i].Amount" type="number" step="1" placeholder="価格" data-adjustment-amount />
                                    <button class="btn btn-outline-danger" type="button" data-remove-adjustment-row>削除</button>
                                </div>
                            }
                        </div>
                        <div class="slip-detail-add-actions">
                            <button class="btn btn-primary" type="submit">調整明細を保存</button>
                        </div>
                    </form>
                </div>
            }
        </div>

        @if (Model.CanAddOrders)
        {
            <div class="modal fade" id="slipOrderModal" tabindex="-1" aria-labelledby="slipOrderModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                        <form method="post" asp-page-handler="AddOrders" id="slipOrderForm">
                            <div class="modal-header">
                                <div>
                                    <p class="store-home__eyebrow mb-1">@detail.TableDisplayName</p>
                                    <h2 class="modal-title fs-4" id="slipOrderModalLabel">オーダー追加</h2>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                            </div>
                            <div class="modal-body slip-modal-form">
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                                <input type="hidden" asp-for="SlipId" />
                                <div id="detailOrderQueueFields"></div>

                                @if (orderableItems.Count == 0)
                                {
                                    <div class="alert alert-secondary mb-0">注文可能な商品が未登録です。</div>
                                }
                                else
                                {
                                    <div class="order-entry__grid order-entry__grid--modal">
                                        <section class="slip-create__panel order-entry__items">
                                            <div class="slip-create__panel-title">
                                                <h3>商品一覧</h3>
                                                <span class="badge text-bg-secondary">@detail.TableDisplayName</span>
                                            </div>

                                            <div class="order-category-tabs" role="tablist" aria-label="商品カテゴリ">
                                                @for (var i = 0; i < orderItemGroups.Count; i++)
                                                {
                                                    <button class="order-category-tab @(i == 0 ? "is-active" : "")" type="button" data-detail-category-tab="@i">
                                                        @orderItemGroups[i].Key
                                                    </button>
                                                }
                                            </div>
                                            <div class="order-item-groups">
                                                @for (var groupIndex = 0; groupIndex < orderItemGroups.Count; groupIndex++)
                                                {
                                                    var group = orderItemGroups[groupIndex];
                                                    <section class="order-item-group @(groupIndex == 0 ? "is-active" : "")" data-detail-category-panel="@groupIndex">
                                                        <h3>@group.Key</h3>
                                                        <div class="order-item-grid">
                                                            @foreach (var item in group)
                                                            {
                                                                <button
                                                                    class="order-item-button"
                                                                    type="button"
                                                                    data-detail-item-id="@item.ItemId">
                                                                    <strong>@item.ItemName</strong>
                                                                    <span>@item.DefaultPrice.ToString("N0") 円</span>
                                                                    @if (item.IsCastBackTarget)
                                                                    {
                                                                        <small>通常 @item.CastBackRegularUnitAmount.ToString("N0") 円 / 指名 @item.CastBackNominationUnitAmount.ToString("N0") 円</small>
                                                                    }
                                                                </button>
                                                            }
                                                        </div>
                                                    </section>
                                                }
                                            </div>
                                        </section>

                                        <section class="slip-create__panel order-entry__queue">
                                            <div class="slip-create__panel-title">
                                                <div>
                                                    <h3>注文キュー</h3>
                                                    <small>@detail.TableDisplayName</small>
                                                </div>
                                                <div class="slip-create__panel-title-actions">
                                                    <span class="terminal-save-status" data-save-state="saved" id="detailOrderQueueStatus" aria-live="polite">空</span>
                                                    <button class="btn btn-outline-secondary" type="button" id="detailClearQueueButton">クリア</button>
                                                </div>
                                            </div>
                                            <span asp-validation-for="QueueLines" class="text-danger"></span>

                                            <div class="order-queue" id="detailOrderQueueList"></div>
                                            <div class="order-queue__empty" id="detailOrderQueueEmpty">商品を選択してください。</div>

                                            <div class="order-queue__total">
                                                <span>合計</span>
                                                <strong id="detailOrderQueueTotal">0 円</strong>
                                            </div>
                                        </section>
                                    </div>
                                }
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">閉じる</button>
                                <button
                                    class="btn btn-primary btn-lg"
                                    type="submit"
                                    id="detailSubmitOrderButton"
                                    @(Model.OrderItems.Count == 0 ? "disabled" : null)>
                                    オーダー保存
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="orderAttendingCastSelectModal" tabindex="-1" aria-labelledby="orderAttendingCastSelectModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title fs-5" id="orderAttendingCastSelectModalLabel">バック対象キャスト選択</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                        </div>
                        <div class="modal-body cast-select-modal">
                            <div class="cast-select-modal__list" id="orderAttendingCastModalList"></div>
                        </div>
                    </div>
                </div>
            </div>
        }
