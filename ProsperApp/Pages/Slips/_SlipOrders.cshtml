@model SlipEditModel
@{
    var detail = Model.Detail!;
    var activeOrders = detail.Orders
        .Where(x => string.Equals(x.Status, "active", StringComparison.Ordinal))
        .OrderBy(x => x.LineNo)
        .ToList();
    var activeStandardOrders = activeOrders
        .Where(x => x.IsStandard)
        .ToList();
    var activeSystemOrders = activeOrders
        .Where(x => !x.IsStandard)
        .ToList();
    var orderableItems = Model.OrderItems
        .Where(x => x.IsStandard)
        .ToList();
    var activeOrderTotal = activeOrders.Sum(x => x.Amount);
    var fixedSystemOrderTotal = activeSystemOrders.Sum(x => x.Amount);
    var activeCharges = detail.ChargeLines
        .Where(x => string.Equals(x.Status, "active", StringComparison.Ordinal))
        .OrderBy(x => x.LineNo)
        .ToList();
    var activeAdjustments = activeCharges
        .Where(x => string.Equals(x.ChargeType, "adjustment", StringComparison.Ordinal))
        .ToList();
    var chargeTotal = activeAdjustments.Sum(x => x.Amount);
    var orderItemGroups = orderableItems
        .GroupBy(x => x.CategoryName)
        .ToList();
}

        <div class="slip-create__panel" data-order-correction-panel>
            <div class="slip-create__panel-title">
                <div class="slip-create__panel-heading">
                    <h2>オーダー一覧</h2>
                    <small>@activeOrders.Count 件 / @StoreUiText.Yen(activeOrderTotal)</small>
                </div>
                <div class="slip-create__panel-title-actions">
                    @if (Model.IsOpenSlip && activeStandardOrders.Count > 0)
                    {
                        <output class="terminal-save-status" data-order-quantity-status data-save-state="saved" aria-live="polite">保存済み</output>
                        <button class="btn btn-outline-primary" type="button" data-order-correction-toggle aria-pressed="false">訂正モード</button>
                        <button class="btn btn-primary" type="submit" form="orderQuantityForm" data-order-quantity-save hidden disabled>数量を保存</button>
                    }
                    @if (Model.CanAddOrders)
                    {
                        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#slipOrderModal">オーダー追加</button>
                    }
                    <span class="terminal-count-badge">@activeOrders.Count 件</span>
                </div>
            </div>

            @if (Model.IsOpenSlip && activeStandardOrders.Count > 0)
            {
                <form method="post" asp-page-handler="SaveOrderQuantities" id="orderQuantityForm" data-order-quantity-form data-partial-form="orders">
                    <input type="hidden" asp-for="SlipId" />
                </form>
            }

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 slip-detail-table slip-detail-table--orders">
                    <colgroup>
                        <col class="slip-detail-table__col--time" />
                        <col class="slip-detail-table__col--primary" />
                        <col class="slip-detail-table__col--amount" />
                        <col class="slip-detail-table__col--quantity" />
                        <col class="slip-detail-table__col--amount" />
                        <col class="slip-detail-table__col--action" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="slip-detail-table__time">時刻</th>
                            <th class="slip-detail-table__primary">商品</th>
                            <th class="slip-detail-table__amount text-end">単価</th>
                            <th class="slip-detail-table__quantity text-end">数量</th>
                            <th class="slip-detail-table__amount text-end">小計</th>
                            <th class="slip-detail-table__action text-end">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (activeStandardOrders.Count == 0 && activeSystemOrders.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-muted">注文はまだ登録されていません。</td>
                            </tr>
                        }
                        else
                        {
                            var editableOrderIndex = 0;
                            @foreach (var order in activeStandardOrders)
                            {
                                var quantityIndex = editableOrderIndex++;
                                <tr data-order-line-row data-order-line-id="@order.OrderLineId" data-order-unit-price="@order.UnitPrice" data-order-initial-quantity="@StoreUiText.Quantity(order.Quantity)">
                                    <td class="slip-detail-table__time">@Model.FormatStoreTime(order.OrderedAt)</td>
                                    <td class="slip-detail-table__primary">
                                        <span>@order.ItemNameSnapshot</span>
                                        @if (order.HasCastBack)
                                        {
                                            <small class="slip-order-back-cast">バック: @order.BackCastDisplayName</small>
                                        }
                                    </td>
                                    <td class="slip-detail-table__amount text-end">@StoreUiText.Amount(order.UnitPrice)</td>
                                    <td class="slip-detail-table__quantity text-end">
                                        <span data-order-quantity-text>@StoreUiText.Quantity(order.Quantity)</span>
                                        @if (Model.IsOpenSlip)
                                        {
                                            <input form="orderQuantityForm" type="hidden" name="OrderQuantityLines[@quantityIndex].OrderLineId" value="@order.OrderLineId" />
                                            <input form="orderQuantityForm" type="hidden" name="OrderQuantityLines[@quantityIndex].Quantity" value="@StoreUiText.Quantity(order.Quantity)" data-order-quantity-input />
                                            <div class="quantity-stepper quantity-stepper--compact order-correction-control" data-order-quantity-control hidden>
                                                <button class="btn btn-outline-secondary btn-sm" type="button" data-order-quantity-decrement>-</button>
                                                <strong data-order-quantity-display>@StoreUiText.Quantity(order.Quantity)</strong>
                                                <button class="btn btn-outline-primary btn-sm" type="button" data-order-quantity-increment>+</button>
                                            </div>
                                        }
                                    </td>
                                    <td class="slip-detail-table__amount text-end" data-order-line-amount>@StoreUiText.Amount(order.Amount)</td>
                                    <td class="slip-detail-table__action text-end">
                                        <form method="post" asp-page-handler="VoidOrder" class="d-inline" data-partial-form="orders">
                                            <input type="hidden" asp-for="SlipId" />
                                            <input type="hidden" name="orderLineId" value="@order.OrderLineId" />
                                            <button class="btn btn-outline-danger btn-sm" type="submit">削除</button>
                                        </form>
                                    </td>
                                </tr>
                            }

                            @foreach (var order in activeSystemOrders)
                            {
                                <tr class="slip-detail-table__system-row">
                                    <td class="slip-detail-table__time">@Model.FormatStoreTime(order.OrderedAt)</td>
                                    <td class="slip-detail-table__primary">
                                        @order.ItemNameSnapshot
                                        <span class="badge text-bg-secondary">自動</span>
                                        @if (order.HasCastBack)
                                        {
                                            <small class="slip-order-back-cast">バック: @order.BackCastDisplayName</small>
                                        }
                                    </td>
                                    <td class="slip-detail-table__amount text-end">@StoreUiText.Amount(order.UnitPrice)</td>
                                    <td class="slip-detail-table__quantity text-end">@StoreUiText.Quantity(order.Quantity)</td>
                                    <td class="slip-detail-table__amount text-end">@StoreUiText.Amount(order.Amount)</td>
                                    <td class="slip-detail-table__action text-end">
                                        <span class="text-muted">削除不可</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="4">商品小計</th>
                            <th class="slip-detail-table__amount text-end" data-detail-order-total data-detail-order-base-total="@fixedSystemOrderTotal">@StoreUiText.Amount(activeOrderTotal)</th>
                            <th class="slip-detail-table__action">円</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="slip-create__panel">
            <div class="slip-create__panel-title">
                <div class="slip-create__panel-heading">
                    <h2>自由入力明細</h2>
                    <small>@activeAdjustments.Count 件 / @StoreUiText.Yen(chargeTotal)</small>
                </div>
                <div class="slip-create__panel-title-actions">
                    @if (Model.IsOpenSlip)
                    {
                        <output class="terminal-save-status" data-adjustment-status data-save-state="saved" aria-live="polite">保存済み</output>
                        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#adjustmentModal">自由入力明細を追加</button>
                    }
                    <span class="terminal-count-badge">@StoreUiText.Yen(chargeTotal)</span>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 slip-detail-table">
                    <colgroup>
                        <col class="slip-detail-table__col--primary" />
                        <col class="slip-detail-table__col--amount" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>明細</th>
                            <th class="text-end">金額</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (activeAdjustments.Count == 0)
                        {
                            <tr>
                                <td colspan="2" class="text-muted">自由入力明細はまだ登録されていません。</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var charge in activeAdjustments)
                            {
                                <tr>
                                    <td>@charge.LineName</td>
                                    <td class="text-end">@StoreUiText.Amount(charge.Amount)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.IsOpenSlip)
        {
            <div class="modal fade" id="adjustmentModal" tabindex="-1" aria-labelledby="adjustmentModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <form method="post" asp-page-handler="AddAdjustment" data-adjustment-form data-partial-form="orders">
                            <div class="modal-header">
                                <div>
                                    <p class="store-home__eyebrow mb-1">自由入力明細</p>
                                    <h2 class="modal-title fs-5" id="adjustmentModalLabel">自由入力明細を追加</h2>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                            </div>
                            <div class="modal-body slip-modal-form">
                                <input type="hidden" asp-for="SlipId" />
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                                <span asp-validation-for="AdjustmentInput" class="text-danger"></span>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label" asp-for="AdjustmentInput.LineName">明細名</label>
                                        <input class="form-control form-control-lg" asp-for="AdjustmentInput.LineName" maxlength="160" placeholder="例: 値引き" data-adjustment-name />
                                        <span asp-validation-for="AdjustmentInput.LineName" class="text-danger"></span>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" asp-for="AdjustmentInput.Amount">価格</label>
                                        <input class="form-control form-control-lg" asp-for="AdjustmentInput.Amount" type="number" step="1" placeholder="0" data-adjustment-amount />
                                        <span asp-validation-for="AdjustmentInput.Amount" class="text-danger"></span>
                                        <small class="text-muted">値引きはマイナスで入力できます。</small>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">閉じる</button>
                                <button class="btn btn-primary btn-lg" type="submit">追加</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }

        @if (Model.CanAddOrders)
        {
            <div class="modal fade" id="slipOrderModal" tabindex="-1" aria-labelledby="slipOrderModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                        <form method="post" asp-page-handler="AddOrders" id="slipOrderForm" data-partial-form="orders">
                            <div class="modal-header">
                                <div>
                                    <p class="store-home__eyebrow mb-1">@detail.TableDisplayName</p>
                                    <h2 class="modal-title fs-4" id="slipOrderModalLabel">オーダー追加</h2>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                            </div>
                            <div class="modal-body slip-modal-form">
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                                <input type="hidden" asp-for="SlipId" />
                                <input type="hidden" asp-for="OrderQueueJson" id="detailOrderQueueJson" value="[]" />
                                <div id="detailOrderQueueFields"></div>

                                @if (orderableItems.Count == 0)
                                {
                                    <div class="alert alert-secondary mb-0">注文可能な商品が未登録です。</div>
                                }
                                else
                                {
                                    <div class="order-entry__grid order-entry__grid--modal">
                                        <section class="slip-create__panel order-entry__items">
                                            <div class="slip-create__panel-title">
                                                <h3>商品一覧</h3>
                                                <span class="badge text-bg-secondary">@detail.TableDisplayName</span>
                                            </div>

                                            <div class="order-category-tabs" role="tablist" aria-label="商品カテゴリ">
                                                @for (var i = 0; i < orderItemGroups.Count; i++)
                                                {
                                                    <button class="order-category-tab @(i == 0 ? "is-active" : "")" type="button" data-detail-category-tab="@i">
                                                        @orderItemGroups[i].Key
                                                    </button>
                                                }
                                            </div>
                                            <div class="order-item-groups">
                                                @for (var groupIndex = 0; groupIndex < orderItemGroups.Count; groupIndex++)
                                                {
                                                    var group = orderItemGroups[groupIndex];
                                                    <section class="order-item-group @(groupIndex == 0 ? "is-active" : "")" data-detail-category-panel="@groupIndex">
                                                        <h3 class="visually-hidden">@group.Key</h3>
                                                        <div class="order-item-grid">
                                                            @foreach (var item in group)
                                                            {
                                                                <button
                                                                    class="order-item-button"
                                                                    type="button"
                                                                    data-detail-item-id="@item.ItemId">
                                                                    <strong>@item.ItemName</strong>
                                                                    <span>@item.DefaultPriceText</span>
                                                                    @if (item.IsCastBackTarget)
                                                                    {
                                                                        <small>@item.CastBackSummaryText</small>
                                                                    }
                                                                </button>
                                                            }
                                                        </div>
                                                    </section>
                                                }
                                            </div>
                                        </section>

                                        <section class="slip-create__panel order-entry__queue">
                                            <div class="slip-create__panel-title">
                                                <div>
                                                    <h3>注文キュー</h3>
                                                    <small>@detail.TableDisplayName</small>
                                                </div>
                                                <div class="slip-create__panel-title-actions">
                                                    <span class="terminal-save-status" data-save-state="saved" id="detailOrderQueueStatus" aria-live="polite">空</span>
                                                    <button class="btn btn-outline-secondary" type="button" id="detailClearQueueButton">クリア</button>
                                                </div>
                                            </div>
                                            <span asp-validation-for="QueueLines" class="text-danger"></span>

                                            <div class="order-queue" id="detailOrderQueueList"></div>
                                            <div class="order-queue__empty" id="detailOrderQueueEmpty">商品を選択してください。</div>

                                            <div class="order-queue__total">
                                                <span>合計</span>
                                                <strong id="detailOrderQueueTotal">0 円</strong>
                                            </div>
                                        </section>
                                    </div>
                                }
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">閉じる</button>
                                <button
                                    class="btn btn-primary btn-lg"
                                    type="submit"
                                    id="detailSubmitOrderButton"
                                    data-submit-base-disabled="@((Model.OrderItems.Count == 0).ToString().ToLowerInvariant())"
                                    @(Model.OrderItems.Count == 0 ? "disabled" : null)>
                                    オーダー保存
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="orderAttendingCastSelectModal" tabindex="-1" aria-labelledby="orderAttendingCastSelectModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title fs-5" id="orderAttendingCastSelectModalLabel">バック対象キャスト選択</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                        </div>
                        <div class="modal-body cast-select-modal">
                            <div class="cast-select-modal__list" id="orderAttendingCastModalList"></div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">閉じる</button>
                        </div>
                    </div>
                </div>
            </div>
        }
