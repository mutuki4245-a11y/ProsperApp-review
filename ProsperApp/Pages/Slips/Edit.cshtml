@page
@model SlipEditModel
@{
    ViewData["Title"] = "伝票詳細";
    ViewData["HasCurrentBusinessDay"] = Model.Detail is not null;
    var detailStatusDisplay = Model.Detail?.Status switch
    {
        "open" => "在席",
        "checked_out" => "会計済",
        "cancelled" => "取消",
        null => "-",
        _ => Model.Detail.Status
    };
    var detailStatusBadgeClass = Model.Detail?.Status switch
    {
        "open" => "text-bg-success",
        "checked_out" => "text-bg-secondary",
        "cancelled" => "text-bg-danger",
        _ => "text-bg-light"
    };
    var activeOrderCount = Model.Detail?.Orders.Count(x => string.Equals(x.Status, "active", StringComparison.Ordinal)) ?? 0;
    var activeChargeCount = Model.Detail?.ChargeLines.Count(x => string.Equals(x.Status, "active", StringComparison.Ordinal)) ?? 0;
}

<section class="slip-create terminal-page terminal-page--slip-detail">
    <div class="page-section-heading">
        <div>
            <h1>伝票詳細</h1>
            @if (Model.Detail is null)
            {
                <p>伝票未選択</p>
            }
        </div>
        <a class="btn btn-outline-secondary" asp-page="/Index">営業中へ戻る</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (Model.SlipId is null)
    {
        <div class="alert alert-warning">
            伝票が選択されていません。営業中画面から対象伝票を選択してください。
        </div>
    }
    else if (Model.Detail is null)
    {
        <div class="alert alert-warning">
            伝票を取得できません。対象伝票が営業中の店舗に存在するか確認してください。
        </div>
    }
    else
    {
        <section class="slip-detail-hero" aria-label="伝票サマリー">
            <div class="slip-detail-hero__items">
                <div>
                    <span>卓番</span>
                    <strong>@Model.Detail.TableDisplayName</strong>
                </div>
                <div>
                    <span>状態</span>
                    <strong class="badge @detailStatusBadgeClass">@detailStatusDisplay</strong>
                </div>
                <div>
                    <span>入店</span>
                    <strong>@Model.FormatStoreTime(Model.Detail.OpenedAt)</strong>
                </div>
                <div>
                    <span>客数</span>
                    <strong>@Model.Detail.CustomerCount 人</strong>
                </div>
                <div>
                    <span>注文</span>
                    <strong>@activeOrderCount 件</strong>
                </div>
                <div>
                    <span>調整</span>
                    <strong>@activeChargeCount 件</strong>
                </div>
            </div>
        </section>

        <div data-slip-panels-url="@Url.Page(null, "Panels", new { slipId = Model.SlipId })">
            <div id="slipCustomersSection">
                <div class="slip-create__panel slip-detail-panel-loading">客一覧を読み込み中です。</div>
            </div>

            <div id="slipNominationsSection">
                <div class="slip-create__panel slip-detail-panel-loading">指名一覧を読み込み中です。</div>
            </div>

            <div id="slipOrdersSection">
                <div class="slip-create__panel slip-detail-panel-loading">オーダー一覧を読み込み中です。</div>
            </div>

        </div>

    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="application/json" id="slipEditData">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            slipId = Model.SlipId,
            businessDayId = Model.CurrentBusinessDay?.BusinessDayId,
            castOptions = Model.AttendanceCasts.Select(c => new { id = c.CastId, name = c.DisplayName, display = c.DisplayName, nominationDisplay = c.SearchDisplayName, department = c.DepartmentName }),
            orderItems = Model.OrderItems.Where(x => x.IsStandard).Select(x => new { id = x.ItemId, name = x.ItemName, itemType = x.ItemType, isKaraoke = x.IsKaraoke, price = x.DefaultPrice, isCastBackTarget = x.IsCastBackTarget, castBackRegularUnitAmount = x.CastBackRegularUnitAmount, castBackNominationUnitAmount = x.CastBackNominationUnitAmount, castBackType = x.CastBackType }),
            initialOrderQueue = Model.QueueLines.Select(x => new { itemId = x.ItemId, quantity = x.Quantity, castBackCastId = x.CastBackCastId }),
            showOrderModal = Model.ShowOrderModal,
            showAdjustmentModal = Model.ShowAdjustmentModal,
            showAddCustomerModal = Model.ShowAddCustomerModal,
            showAddNominationModal = Model.ShowAddNominationModal
        }))
    </script>
    <script src="~/js/features/cast-select-modal.js" asp-append-version="true"></script>
    <script src="~/js/features/order-back-text.js" asp-append-version="true"></script>
    <script src="~/js/features/slip-adjustments.js" asp-append-version="true"></script>
    <script src="~/js/features/slip-customers.js" asp-append-version="true"></script>
    <script src="~/js/features/slip-nominations.js" asp-append-version="true"></script>
    <script src="~/js/features/slip-orders.js" asp-append-version="true"></script>
    <script src="~/js/features/slip-panels.js" asp-append-version="true"></script>
}
