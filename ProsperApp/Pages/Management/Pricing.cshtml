@page
@model ManagementPricingModel
@{
    ViewData["Title"] = "時間料金設定";
}

<section class="opening-page">
    <div class="page-section-heading">
        <h1>時間料金設定</h1>
        <p>セット料金と延長料金を店舗ごとに設定します。延長はセット終了時から同じ間隔で発生します。</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    @if (Model.LoadStatus is { Succeeded: false } loadStatus)
    {
        <div class="alert alert-danger" role="alert">
            <strong>@loadStatus.FailureTitle</strong>
            <div>@loadStatus.ErrorMessage</div>
            <a class="btn btn-outline-danger btn-sm mt-2" asp-page="/Management/Pricing">再試行</a>
        </div>
    }
    else if (Model.LoadStatus?.LastUpdatedAt is { } lastUpdatedAt)
    {
        <div class="text-muted small mb-2">最終更新: @lastUpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
    }

    <form method="post" asp-page-handler="Save" class="slip-create__panel">
        <fieldset class="border-0 p-0 m-0" @(Model.LoadStatus?.Succeeded == false ? "disabled" : null)>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="item-admin__table">
            <div class="item-admin__row item-admin__row--nomination-back">
                <div class="item-admin__field">
                    <label asp-for="Plan.SetMinutes"></label>
                    <div class="input-group">
                        <input asp-for="Plan.SetMinutes" class="form-control" type="number" min="5" max="480" step="5" inputmode="numeric" />
                        <span class="input-group-text">分</span>
                    </div>
                    <span asp-validation-for="Plan.SetMinutes" class="text-danger"></span>
                </div>
                <label class="item-admin__field item-admin__field--check">
                    <span>有効</span>
                    <input asp-for="Plan.IsActive" class="form-check-input" type="checkbox" />
                </label>
            </div>
            <div class="item-admin__row item-admin__row--nomination-back">
                <div class="item-admin__field">
                    <label asp-for="Plan.SetUnitPriceSingle"></label>
                    <div class="input-group"><input asp-for="Plan.SetUnitPriceSingle" class="form-control" type="number" min="0" step="1" inputmode="numeric" /><span class="input-group-text">円</span></div>
                    <span asp-validation-for="Plan.SetUnitPriceSingle" class="text-danger"></span>
                </div>
                <div class="item-admin__field">
                    <label asp-for="Plan.SetUnitPricePerCustomer"></label>
                    <div class="input-group"><input asp-for="Plan.SetUnitPricePerCustomer" class="form-control" type="number" min="0" step="1" inputmode="numeric" /><span class="input-group-text">円</span></div>
                    <span asp-validation-for="Plan.SetUnitPricePerCustomer" class="text-danger"></span>
                </div>
            </div>
            <div class="item-admin__row item-admin__row--nomination-back">
                <div class="item-admin__field">
                    <label asp-for="Plan.ExtensionUnitPriceSingle"></label>
                    <div class="input-group"><input asp-for="Plan.ExtensionUnitPriceSingle" class="form-control" type="number" min="0" step="1" inputmode="numeric" /><span class="input-group-text">円</span></div>
                    <span asp-validation-for="Plan.ExtensionUnitPriceSingle" class="text-danger"></span>
                </div>
                <div class="item-admin__field">
                    <label asp-for="Plan.ExtensionUnitPricePerCustomer"></label>
                    <div class="input-group"><input asp-for="Plan.ExtensionUnitPricePerCustomer" class="form-control" type="number" min="0" step="1" inputmode="numeric" /><span class="input-group-text">円</span></div>
                    <span asp-validation-for="Plan.ExtensionUnitPricePerCustomer" class="text-danger"></span>
                </div>
            </div>
        </div>
        <p class="text-muted mt-3 mb-0">入店時の人数でセット料金を1回計算します。各延長は、その時点で在席している人数で計算します。会計伝票を出力した後は、その時点の料金内容を固定します。</p>
        <div class="mt-3"><button class="btn btn-primary btn-lg" type="submit">保存</button></div>
        </fieldset>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
