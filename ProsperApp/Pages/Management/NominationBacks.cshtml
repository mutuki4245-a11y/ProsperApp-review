@page
@model ManagementNominationBacksModel
@{
    ViewData["Title"] = "指名バック設定";
}

<section class="opening-page">
    <div class="page-section-heading">
        <h1>指名バック設定</h1>
        <p>指名種別ごとにキャストへ付けるバック単価を管理します。</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (Model.LoadStatus is { Succeeded: false } loadStatus)
    {
        <div class="alert alert-danger" role="alert">
            <strong>@loadStatus.FailureTitle</strong>
            <div>@loadStatus.ErrorMessage</div>
            <a class="btn btn-outline-danger btn-sm mt-2" asp-page="/Management/NominationBacks">再試行</a>
        </div>
    }
    else if (Model.LoadStatus?.LastUpdatedAt is { } lastUpdatedAt)
    {
        <div class="text-muted small mb-2">最終更新: @lastUpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
    }

    <form method="post" asp-page-handler="Save" class="slip-create__panel">
        <fieldset class="border-0 p-0 m-0" @(Model.LoadStatus?.Succeeded == false ? "disabled" : null)>
        <div class="slip-create__panel-title">
            <h2>店舗別バック単価</h2>
        </div>

        @if (Model.Settings.Count == 0)
        {
            <p class="text-muted mb-0">指名バック設定が未登録です。</p>
        }
        else
        {
            <div class="item-admin__table">
                @for (var i = 0; i < Model.Settings.Count; i++)
                {
                    <div class="item-admin__row item-admin__row--nomination-back">
                        <input type="hidden" asp-for="Settings[i].NominationKind" />
                        <input type="hidden" asp-for="Settings[i].NominationType" />
                        <input type="hidden" asp-for="Settings[i].DisplayName" />
                        <input type="hidden" asp-for="Settings[i].CompanionTime" />
                        <input type="hidden" asp-for="Settings[i].SortOrder" />
                        <div class="item-admin__field item-admin__field--name">
                            <label>指名種別</label>
                            <strong>@Model.Settings[i].DisplayName</strong>
                        </div>
                        <div class="item-admin__field">
                            <label asp-for="Settings[i].BackUnitAmount"></label>
                            <input asp-for="Settings[i].BackUnitAmount" class="form-control" type="number" min="0" step="1" inputmode="numeric" />
                            <span asp-validation-for="Settings[i].BackUnitAmount" class="text-danger"></span>
                        </div>
                        <label class="item-admin__field item-admin__field--check">
                            <span>有効</span>
                            <input asp-for="Settings[i].IsActive" class="form-check-input" type="checkbox" />
                        </label>
                    </div>
                }
            </div>

            <div class="mt-3">
                <button class="btn btn-primary btn-lg" type="submit">保存</button>
            </div>
        }
        </fieldset>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
