@page
@model ManagementCastsModel
@{
    ViewData["Title"] = "キャスト情報";
    ViewData["HasCurrentBusinessDay"] = Model.CurrentBusinessDay is not null;
}

<section class="opening-page">
    <div class="page-section-heading">
        <h1>キャスト情報</h1>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    @if (Model.LoadStatus is { Succeeded: false } loadStatus)
    {
        <div class="alert alert-danger" role="alert">
            <strong>@loadStatus.FailureTitle</strong>
            <div>@loadStatus.ErrorMessage</div>
            <a class="btn btn-outline-danger btn-sm mt-2" asp-page="/Management/Casts">再試行</a>
        </div>
    }
    else if (Model.LoadStatus?.LastUpdatedAt is { } lastUpdatedAt)
    {
        <div class="text-muted small mb-2">最終更新: @lastUpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
    }

    <fieldset class="border-0 p-0 m-0" @(Model.LoadStatus?.Succeeded == false ? "disabled" : null)>
    <form method="post" asp-page-handler="Create" class="slip-create__panel cast-admin-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div>
                <label asp-for="Input.DisplayName" class="form-label"></label>
                <input asp-for="Input.DisplayName" class="form-control form-control-lg" placeholder="キャスト名" />
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Input.DrinkMemo" class="form-label"></label>
                <input asp-for="Input.DrinkMemo" class="form-control" maxlength="30" placeholder="ドリンクを出す際のメモ（任意）" />
                <span asp-validation-for="Input.DrinkMemo" class="text-danger"></span>
            </div>
            <button class="btn btn-primary btn-lg" type="submit">登録</button>
    </form>

    <div class="slip-create__panel">
        <div class="opening-attendance__header">
            <div>
                <h2>登録済みキャスト</h2>
                <p class="text-muted mb-0">加入日は登録日で自動設定されます。</p>
            </div>
            @if (Model.Casts.Count > 0)
            {
                <span class="opening-attendance__count">@Model.Casts.Count 名</span>
            }
        </div>

        @if (Model.Casts.Count == 0)
        {
            <p class="text-muted mb-0">キャストが未登録です。</p>
        }
        else
        {
            <div class="cast-admin-table">
                <div class="cast-admin-table__row cast-admin-table__row--header">
                    <span>ID</span>
                    <span>キャスト名</span>
                    <span>加入日</span>
                    <span>ドリンクメモ</span>
                    <span></span>
                </div>
                @foreach (var cast in Model.Casts)
                {
                    <div class="cast-admin-table__row">
                        <span>@cast.CastId</span>
                        <strong>@cast.DisplayName</strong>
                        <span>@cast.JoinedOn.ToString("yyyy-MM-dd")</span>
                        <span class="cast-admin-table__drink-memo">@(string.IsNullOrWhiteSpace(cast.DrinkMemo) ? "未設定" : cast.DrinkMemo)</span>
                        <div class="cast-admin-table__actions">
                            <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#castDrinkMemoModal-@cast.CastId">編集</button>
                            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('このキャストを削除しますか？');">
                                <input type="hidden" asp-for="DeleteCastId" value="@cast.CastId" />
                                <button class="btn btn-outline-danger btn-sm" type="submit">削除</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    </fieldset>
</section>

@foreach (var cast in Model.Casts)
{
    var drinkMemo = Model.EditingDrinkMemoCastId == cast.CastId
        ? Model.DrinkMemoInput.DrinkMemo
        : cast.DrinkMemo;
        <div class="modal fade" id="castDrinkMemoModal-@cast.CastId" tabindex="-1" aria-labelledby="castDrinkMemoModalLabel-@cast.CastId" aria-hidden="true">
            <div class="modal-dialog">
                <form method="post" asp-page-handler="UpdateDrinkMemo" class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="castDrinkMemoModalLabel-@cast.CastId">@cast.DisplayName のドリンクメモ</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                    </div>
                    <div class="modal-body">
                        @if (Model.EditingDrinkMemoCastId == cast.CastId)
                        {
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        }
                        <input type="hidden" name="DrinkMemoInput.CastId" value="@cast.CastId" />
                        <label class="form-label" for="castDrinkMemo-@cast.CastId">ドリンクメモ</label>
                        <input class="form-control" id="castDrinkMemo-@cast.CastId" name="DrinkMemoInput.DrinkMemo" value="@drinkMemo" maxlength="30" placeholder="ドリンクを出す際のメモ（任意）" />
                        <div class="form-text">30文字まで。空欄で保存すると未設定に戻ります。</div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">閉じる</button>
                        <button class="btn btn-primary" type="submit">保存</button>
                    </div>
                </form>
            </div>
        </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.EditingDrinkMemoCastId is not null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const modalElement = document.getElementById('castDrinkMemoModal-@Model.EditingDrinkMemoCastId');
                if (modalElement) {
                    bootstrap.Modal.getOrCreateInstance(modalElement).show();
                }
            });
        </script>
    }
}
