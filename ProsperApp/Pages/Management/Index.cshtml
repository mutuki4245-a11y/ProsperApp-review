@page
@model ManagementIndexModel
@{
    ViewData["Title"] = "店舗設定";
}

<section class="settings-page">
    <div class="store-home__hero">
        <p class="store-home__eyebrow">店舗設定</p>
        <h1>店舗設定</h1>
        <p>店舗運用に使うマスタ情報と、この端末で使用する画面・配色を設定します。</p>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <section class="settings-card">
        <h2>画面設定</h2>
        <p class="text-muted mb-3">この端末で使用する画面と配色を選択します。</p>
        <form method="post" asp-page-handler="SaveDisplaySettings" class="settings-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <h3 class="h5 mb-2">使用する画面</h3>
            <div class="settings-radio-grid">
                <label class="settings-radio">
                    <input asp-for="ScreenMode" type="radio" value="sales-management" />
                    <span>
                        <strong>営業管理用画面</strong>
                        <small>営業中、締め作業、店舗設定を使う店舗運用画面</small>
                    </span>
                </label>
                <label class="settings-radio">
                    <input asp-for="ScreenMode" type="radio" value="order-entry" />
                    <span>
                        <strong>オーダー登録用画面</strong>
                        <small>卓と商品を選んで注文を登録する専用画面</small>
                    </span>
                </label>
            </div>
            <span asp-validation-for="ScreenMode" class="text-danger"></span>

            <h3 class="h5 mt-4 mb-2">配色</h3>
            <div class="settings-radio-grid settings-radio-grid--compact">
                <label class="settings-radio">
                    <input asp-for="ThemeMode" type="radio" value="@LocalSettings.ThemeModeQuietNavy" />
                    <span>
                        <strong>E案（夜レジ）</strong>
                        <small>暗い青グレーに明るい水色を合わせた配色</small>
                    </span>
                </label>
                <label class="settings-radio">
                    <input asp-for="ThemeMode" type="radio" value="@LocalSettings.ThemeModeWhite" />
                    <span>
                        <strong>白ベース</strong>
                        <small>明るい背景を使用した配色</small>
                    </span>
                </label>
            </div>
            <span asp-validation-for="ThemeMode" class="text-danger"></span>
            <div class="settings-actions">
                <button class="btn btn-primary btn-lg" type="submit">画面設定を保存</button>
            </div>
        </form>
    </section>

    <section class="settings-card">
        <h2>マスタ情報</h2>
        <p class="text-muted mb-3">卓番、キャスト、商品、バック、時間料金を必要なタイミングで更新します。</p>
        @if (Model.IsAdminMode)
        {
            <div class="alert alert-success py-2">管理者モードが有効です。マスタを追加・編集・削除できます。</div>
        }
        else
        {
            <div class="alert alert-warning py-2">
                現在は参照モードです。変更する場合は
                <a asp-page="/Settings/Index">管理者設定</a>
                で管理者モードを有効にしてください。
            </div>
        }
        <div class="closing-list">
            <a class="closing-panel is-ready" asp-page="/Management/Tables">
                <span class="closing-panel__body">
                    <strong>卓番情報</strong>
                    <small>卓番の追加・編集・削除を行います。</small>
                </span>
                <span class="closing-panel__badge is-ready">任意</span>
                <span class="closing-panel__action">開く</span>
            </a>
            <a class="closing-panel is-ready" asp-page="/Management/Casts">
                <span class="closing-panel__body">
                    <strong>キャスト情報</strong>
                    <small>キャストの追加・確認を行います。</small>
                </span>
                <span class="closing-panel__badge is-ready">任意</span>
                <span class="closing-panel__action">開く</span>
            </a>
            <a class="closing-panel is-ready" asp-page="/Management/Items">
                <span class="closing-panel__body">
                    <strong>商品情報</strong>
                    <small>商品とカテゴリを管理します。</small>
                </span>
                <span class="closing-panel__badge is-ready">任意</span>
                <span class="closing-panel__action">開く</span>
            </a>
            <a class="closing-panel is-ready" asp-page="/Management/NominationBacks">
                <span class="closing-panel__body">
                    <strong>指名バック設定</strong>
                    <small>指名種別ごとのキャストバック単価を管理します。</small>
                </span>
                <span class="closing-panel__badge is-ready">任意</span>
                <span class="closing-panel__action">開く</span>
            </a>
            <a class="closing-panel is-ready" asp-page="/Management/Pricing">
                <span class="closing-panel__body">
                    <strong>時間料金設定</strong>
                    <small>セット料金と延長料金を管理します。</small>
                </span>
                <span class="closing-panel__badge is-ready">任意</span>
                <span class="closing-panel__action">開く</span>
            </a>
        </div>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
