@page
@model CheckoutModel
@{
    ViewData["Title"] = "会計";
}

<section class="placeholder-page">
    <p class="store-home__eyebrow">会計</p>
    <h1>会計</h1>
    @if (Model.SlipId is not null)
    {
        <p>伝票ID: @Model.SlipId</p>
    }
    <p>退店時刻選択、会計伝票編集、決済方法選択、お釣り計算は準備中です。</p>
    <a class="btn btn-outline-secondary btn-lg" asp-page="/Business">営業中画面へ戻る</a>
</section>
