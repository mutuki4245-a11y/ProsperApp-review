@page
@model IndexModel
@inject IFeatureGate FeatureGate
@{
    ViewData["Title"] = "オーダー入力";
    ViewData["HasCurrentBusinessDay"] = Model.CurrentBusinessDay is not null;
    var orderableItems = Model.Items
        .Where(x => x.IsStandard)
        .ToList();
    var itemGroups = orderableItems
        .GroupBy(x => x.CategoryName)
        .ToList();
}

<section class="order-entry terminal-page terminal-page--orders">
    <div class="order-entry__header">
        <h1>オーダー入力</h1>
        @if (FeatureGate.IsEnabled(FeatureNames.Settings))
        {
            <a class="btn btn-outline-secondary btn-sm" asp-page="/Settings/Index">管理者設定</a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
    }

    <form method="post" class="order-entry__form" id="orderForm">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="SelectedSlipId" id="selectedSlipId" />
        <input type="hidden" asp-for="OrderQueueJson" id="orderQueueJson" value="[]" />
        <input type="hidden" asp-for="OrderQueueSummaryJson" id="orderQueueSummaryJson" value="[]" />
        <div id="queueFields"></div>

        @if (Model.CurrentBusinessDay is null)
        {
            <div class="alert alert-warning">
                オーダー入力の前に営業中画面で伝票を作成してください。最初の伝票作成時に営業日を自動作成します。
            </div>
        }
        else
        {
            <div class="order-entry__grid">
                <section class="slip-create__panel order-entry__panel order-entry__slips">
                    <div class="slip-create__panel-title">
                        <div class="slip-create__panel-heading">
                            <h2>1. 卓番選択</h2>
                            <small>注文対象のopen伝票</small>
                        </div>
                        <span class="terminal-count-badge">@Model.Slips.Count 件</span>
                    </div>
                    <div class="order-entry__panel-body">
                        <span asp-validation-for="SelectedSlipId" class="text-danger"></span>
                        <div class="alert alert-warning" role="alert" id="slipOptionsWarning" hidden></div>

                        <div class="order-slip-picker" role="group" aria-label="卓番選択" data-order-slip-picker>
                            <div class="alert alert-secondary mb-0" data-order-slip-loading>注文対象の卓番を読み込み中です。</div>
                        </div>
                    </div>
                </section>

                <section class="slip-create__panel order-entry__panel order-entry__items" id="itemPanel">
                    <div class="slip-create__panel-title">
                        <div class="slip-create__panel-heading">
                            <h2>2. 商品一覧</h2>
                            <small>@orderableItems.Count 件</small>
                        </div>
                        <span class="terminal-count-badge" id="selectedSlipBadge">@(Model.SelectedSlip?.TableDisplayName ?? "卓番未選択")</span>
                    </div>

                    <div class="order-entry__panel-body">
                        @if (orderableItems.Count == 0)
                        {
                            <div class="alert alert-secondary mb-0">注文可能な商品が未登録です。</div>
                        }
                        else
                        {
                            <div class="order-category-tabs" role="tablist" aria-label="商品カテゴリ">
                                @for (var i = 0; i < itemGroups.Count; i++)
                                {
                                    <button class="order-category-tab @(i == 0 ? "is-active" : "")" type="button" data-category-tab="@i">
                                        @itemGroups[i].Key
                                    </button>
                                }
                            </div>
                            <div class="order-item-groups">
                                @for (var groupIndex = 0; groupIndex < itemGroups.Count; groupIndex++)
                                {
                                    var group = itemGroups[groupIndex];
                                    <section class="order-item-group @(groupIndex == 0 ? "is-active" : "")" data-category-panel="@groupIndex">
                                        <h3 class="visually-hidden">@group.Key</h3>
                                        <div class="order-item-grid">
                                            @foreach (var item in group)
                                            {
                                                <button
                                                    class="order-item-button"
                                                    type="button"
                                                    data-item-id="@item.ItemId">
                                                    <strong>@item.ItemName</strong>
                                                    <span>@item.DefaultPriceText</span>
                                                    @if (item.IsCastBackTarget)
                                                    {
                                                        <small>@item.CastBackSummaryText</small>
                                                    }
                                                </button>
                                            }
                                        </div>
                                    </section>
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="slip-create__panel order-entry__panel order-entry__queue">
                    <div class="slip-create__panel-title">
                        <div>
                            <h2>3. 注文キュー</h2>
                            <small id="selectedSlipQueueLabel">@(Model.SelectedSlip?.TableDisplayName ?? "卓番未選択")</small>
                        </div>
                        <div class="slip-create__panel-title-actions">
                            <span class="terminal-save-status" data-save-state="dirty" id="queueStatus" aria-live="polite">未送信</span>
                            <button class="btn btn-outline-secondary" type="button" id="clearQueueButton">クリア</button>
                        </div>
                    </div>
                    <div class="order-entry__panel-body order-entry__panel-body--queue">
                        <span asp-validation-for="QueueLines" class="text-danger"></span>

                        <div class="order-queue" id="queueList"></div>
                        <div class="order-queue__empty" id="queueEmpty">商品を選択してください。</div>
                    </div>

                    <div class="order-queue__total">
                        <span>合計</span>
                        <strong id="queueTotal">0 円</strong>
                    </div>

                    <div class="slip-create__actions">
                        <button
                            class="btn btn-primary btn-lg"
                            type="submit"
                            id="submitOrderButton"
                            @(Model.Items.Count == 0 ? "disabled" : null)>
                            一括登録
                        </button>
                    </div>
                </section>
            </div>
        }
    </form>

    <div class="modal fade" id="attendingCastSelectModal" tabindex="-1" aria-labelledby="attendingCastSelectModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="attendingCastSelectModalLabel">出勤キャスト選択</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                </div>
                <div class="modal-body cast-select-modal">
                    <div class="cast-select-modal__list" id="attendingCastModalList"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="application/json" id="orderEntryData">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            slips = Model.Slips.Select(x => new { id = x.SlipId, display = x.TableDisplayName, customerNames = x.CustomerDisplayName }),
            items = orderableItems.Select(x => new { id = x.ItemId, name = x.ItemName, itemType = x.ItemType, isKaraoke = x.IsKaraoke, price = x.DefaultPrice, isCastBackTarget = x.IsCastBackTarget, castBackRegularUnitAmount = x.CastBackRegularUnitAmount, castBackNominationUnitAmount = x.CastBackNominationUnitAmount, castBackType = x.CastBackType }),
            castOptions = Model.AttendanceCasts.Select(x => new { id = x.CastId, name = x.DisplayName, display = x.DisplayName, department = x.DepartmentName, isHome = x.DepartmentName == Model.StoreContext?.DepartmentName, isAttending = true }),
            initialQueue = Model.QueueLines.Select(x => new { slipId = x.SlipId, itemId = x.ItemId, quantity = x.Quantity, castBackCastId = x.CastBackCastId }),
            initialSlipId = Model.SelectedSlipId,
            slipOptionsUrl = Url.Page("/Orders/Index", "SlipOptions"),
            refreshIntervalMs = 10000
        }))
    </script>
    <script src="~/js/features/cast-select-modal.js" asp-append-version="true"></script>
    <script src="~/js/features/order-back-text.js" asp-append-version="true"></script>
    <script src="~/js/features/order-entry.js" asp-append-version="true"></script>
}
