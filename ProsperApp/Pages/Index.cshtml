@page
@using ProsperApp.Models
@model IndexModel
@{
    ViewData["Title"] = "営業中";
    ViewData["HasCurrentBusinessDay"] = Model.HasCurrentBusinessDay;
    var nominationOptions = Model.NominationOptions
        .Select(x => (Value: x.NominationKind, Label: x.DisplayName))
        .ToArray();
    var hasNominationOptions = nominationOptions.Length > 0;
    bool IsCompanionNomination(string? nominationKind) =>
        Model.NominationOptions.Any(option =>
            string.Equals(option.NominationKind, nominationKind, StringComparison.Ordinal) &&
            string.Equals(option.NominationType, "companion", StringComparison.Ordinal));
    var nominationPriceOptions = Enumerable.Range(1, 20).Select(x => x * 1000).ToArray();
}

<section class="store-home terminal-page terminal-page--sales">
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
    }

    @if (Model.IsReceiptPrinterEnabled)
    {
        <div class="alert alert-info" role="status" data-receipt-print-status hidden>
            領収書を印刷しています。
        </div>
        <div class="alert alert-warning receipt-reprint-panel" role="alert" data-receipt-reprint-panel hidden>
            <div class="receipt-reprint-panel__header">
                <div>
                    <strong>再印刷待ちの領収書があります</strong>
                    <span>印刷失敗した会計済み伝票です。会計は取り消されていません。</span>
                </div>
            </div>
            <div class="receipt-reprint-panel__list" data-receipt-reprint-list></div>
        </div>
    }

    @if (Model.IsPreviousBusinessDayOpen)
    {
        <div class="alert alert-danger sales-block-alert" role="alert">
            前回営業日 @Model.DisplayBusinessDate.ToString("yyyy-MM-dd") の締め作業が未完了です。
        </div>
    }

    @if (Model.HasCurrentBusinessDay || Model.CanCreateSalesInput)
    {
        <section class="home-workspace" aria-label="営業中の操作">
            <div class="sales-summary" aria-label="営業中サマリー">
                <div class="sales-summary__items">
                    <span class="sales-summary__item">
                        <strong>営業日</strong>
                        <span data-business-date-display>@Model.DisplayBusinessDateText</span>
                    </span>
                    <span class="sales-summary__item">
                        <strong>未会計</strong>
                        <span data-business-open-slip-count>取得中</span>
                    </span>
                    <span class="sales-summary__item">
                        <strong>会計済</strong>
                        <span data-business-checked-out-slip-count>取得中</span>
                    </span>
                </div>
                <div class="sales-summary__actions">
                    @if (Model.ShouldShowCreateSlipButton)
                    {
                        <button
                            class="btn btn-primary sales-summary__create"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#createSlipModal"
                            data-business-create-slip-button
                            @(Model.CanCreateSlip ? null : "disabled")>
                            伝票を追加
                        </button>
                    }
                    <a class="btn btn-outline-primary sales-summary__attendance" asp-page="/Attendance">勤怠管理</a>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.CreateSlipDisabledMessage))
                {
                    <div class="alert alert-warning sales-summary__warning" role="alert" data-business-create-slip-warning>
                        @Model.CreateSlipDisabledMessage
                    </div>
                }
            </div>
            <section class="slip-list-section" id="slipListPanel">
                <form method="post" asp-page-handler="SaveKaraoke" data-business-karaoke-form data-business-day-id="@Model.CurrentBusinessDayId">
                    <div class="slip-list-section__statusbar">
                        <output class="terminal-save-status" data-business-karaoke-status data-save-state="saved" aria-live="polite" hidden>同期済み</output>
                    </div>
                    <div class="slip-list__header" aria-hidden="true">
                        <span>卓</span>
                        <span>状態</span>
                        <span>入店</span>
                        <span>客</span>
                        <span>指名</span>
                        <span>メモ</span>
                        <span>会計</span>
                        <span>カラオケ</span>
                    </div>
                    <div class="slip-list" data-business-slip-list>
                        <article class="slip-list__row slip-list__row--add" data-business-slip-loading>
                            <div class="slip-list__main">
                                <strong>伝票を読み込み中</strong>
                                <span>営業中の一覧を取得しています。</span>
                            </div>
                        </article>
                    </div>
                </form>
                <button class="slip-amount-reveal" type="button" data-slip-amount-reveal aria-label="会計額を表示" aria-pressed="false" hidden>
                    <span class="slip-amount-reveal__mark">¥</span>
                    <span class="visually-hidden">会計額</span>
                </button>
            </section>
        </section>
    }

    @if (Model.CanCreateSalesInput)
    {
        <div class="modal fade" id="createSlipModal" tabindex="-1" aria-labelledby="createSlipModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <form method="post" asp-page-handler="CreateSlip">
                        <div class="modal-header">
                            <div>
                                <h2 class="modal-title fs-4" id="createSlipModalLabel">伝票追加</h2>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                        </div>
                        <div class="modal-body slip-modal-form slip-modal-form--create">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <input asp-for="CreateSlipInput.OpenedAt" type="hidden" />
                            <input asp-for="CreateSlipInput.BusinessDate" type="hidden" data-business-create-date-input />
                            <input asp-for="CreateSlipInput.BusinessDayId" type="hidden" data-business-create-day-id-input />

                            <span class="visually-hidden" data-business-create-date-display>@Model.CreateSlipInput.BusinessDate?.ToString("yyyy-MM-dd")</span>

                            <div class="slip-create-three-column">
                                <div class="slip-create-three-column__column">
                                    <section class="slip-create__panel slip-create__panel--entry">
                                        <label asp-for="CreateSlipInput.OpenedTime" class="form-label visually-hidden"></label>
                                        <select class="form-select form-select-lg slip-time-select" name="CreateSlipInput.OpenedTime" aria-label="入店時刻">
                                            @foreach (var time in Model.TimeOptions)
                                            {
                                                if (Model.CreateSlipInput.OpenedTime == time)
                                                {
                                                    <option value="@time" selected>@time</option>
                                                }
                                                else
                                                {
                                                    <option value="@time">@time</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="CreateSlipInput.OpenedTime" class="text-danger"></span>
                                        <span asp-validation-for="CreateSlipInput.OpenedAt" class="text-danger"></span>
                                    </section>

                                    <section class="slip-create__panel slip-create__panel--tables">
                                        <input asp-for="CreateSlipInput.TableId" type="hidden" id="businessCreateSlipTableId" />
                                        <span asp-validation-for="CreateSlipInput.TableId" class="text-danger"></span>
                                        @if (Model.Tables.Count == 0)
                                        {
                                            <div class="alert alert-warning mb-0">卓番マスタがありません。</div>
                                        }
                                        else
                                        {
                                            <div class="table-picker" role="group" aria-label="卓番選択">
                                                @foreach (var table in Model.Tables)
                                                {
                                                    var selected = Model.CreateSlipInput.TableId == table.TableId;
                                                    <button class="table-picker__button @(selected ? "is-selected" : "")" type="button" data-business-slip-table-id="@table.TableId">
                                                        @table.DisplayName
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </section>
                                    <section class="slip-create__panel slip-create__panel--memo">
                                        <textarea asp-for="CreateSlipInput.Memo" class="form-control form-control-lg" rows="2" placeholder="共有事項"></textarea>
                                        <span asp-validation-for="CreateSlipInput.Memo" class="text-danger"></span>
                                    </section>
                                </div>

                                <section class="slip-create__panel slip-create__panel--customers">
                                    <div class="slip-create__panel-title slip-create__panel-title--create-actions">
                                        <button class="btn btn-outline-primary" type="button" id="businessAddCustomerButton">追加</button>
                                    </div>
                                    <span asp-validation-for="CreateSlipInput.CustomerLabels" class="text-danger"></span>
                                    <div class="customer-list" id="businessCustomerList">
                                        @for (var i = 0; i < Model.CreateSlipInput.CustomerLabels.Count; i++)
                                        {
                                            <div class="customer-row" data-business-customer-row>
                                                <label class="customer-row__index">@(i + 1)</label>
                                                <input class="form-control form-control-lg" name="CreateSlipInput.CustomerLabels[@i]" value="@Model.CreateSlipInput.CustomerLabels[i]" maxlength="100" placeholder="客名・特徴など" />
                                                <button class="btn btn-outline-danger customer-row__remove" type="button" data-business-remove-customer @(i == 0 ? "hidden" : null)>削除</button>
                                            </div>
                                        }
                                    </div>
                                </section>

                                <section class="slip-create__panel slip-create__panel--nominations">
                                    <div class="slip-create__panel-title slip-create__panel-title--create-actions">
                                        <button class="btn btn-outline-primary" type="button" id="businessAddNominationButton" disabled="@(!hasNominationOptions)">追加</button>
                                    </div>
                                    @if (!hasNominationOptions)
                                    {
                                        <div class="alert alert-secondary mb-3">指名種別マスタが未登録です。</div>
                                    }
                                    <div class="nomination-list" id="businessNominationList">
                                        @for (var i = 0; i < Model.CreateSlipInput.CastNominations.Count; i++)
                                        {
                                            var nomination = Model.CreateSlipInput.CastNominations[i];
                                            <div class="nomination-row" data-business-nomination-row>
                                                <label class="customer-row__index nomination-row__index">@(i + 1)</label>
                                                <select class="form-select nomination-row__kind" name="CreateSlipInput.CastNominations[@i].NominationKind">
                                                    <option value="">指名区分</option>
                                                    @foreach (var option in nominationOptions)
                                                    {
                                                        var isSelected = nomination.NominationKind == option.Value;
                                                        var isCompanion = IsCompanionNomination(option.Value);
                                                        <option value="@option.Value" selected="@isSelected" data-companion="@isCompanion.ToString().ToLowerInvariant()">@option.Label</option>
                                                    }
                                                </select>
                                                <select class="form-select nomination-row__price" name="CreateSlipInput.CastNominations[@i].NominationPrice">
                                                    @foreach (var price in nominationPriceOptions)
                                                    {
                                                        if (nomination.NominationPrice == price)
                                                        {
                                                            <option value="@price" selected>@StoreUiText.Yen(price)</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@price">@StoreUiText.Yen(price)</option>
                                                        }
                                                    }
                                                </select>
                                                <div class="nomination-row__cast">
                                                    <input type="hidden" name="CreateSlipInput.CastNominations[@i].CastId" value="@nomination.CastId" data-business-cast-id />
                                                    <input type="hidden" name="CreateSlipInput.CastNominations[@i].CastName" value="@nomination.CastName" data-business-cast-name-hidden />
                                                    <button class="selected-cast selected-cast--button" type="button" data-business-open-cast-modal>
                                                        <span data-business-selected-cast>@(nomination.CastName ?? "キャストを選択")</span>
                                                    </button>
                                                </div>
                                                <button class="btn btn-outline-danger nomination-row__remove" type="button" data-business-remove-nomination @(i == 0 ? "hidden" : null)>削除</button>
                                            </div>
                                        }
                                    </div>
                                    @if (Model.CreateSlipInput.CastNominations.Count == 0)
                                    {
                                        <p class="text-muted mb-0" data-business-nomination-empty>指名なし</p>
                                    }
                                </section>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">閉じる</button>
                            <button class="btn btn-primary btn-lg" type="submit" @((!Model.CanCreateSlip || Model.Tables.Count == 0) ? "disabled" : null)>伝票を作成</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="modal fade" id="businessAttendingCastSelectModal" tabindex="-1" aria-labelledby="businessAttendingCastSelectModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="businessAttendingCastSelectModalLabel">出勤キャスト選択</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                    </div>
                    <div class="modal-body cast-select-modal">
                        <div class="cast-select-modal__list" id="businessAttendingCastModalList"></div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">閉じる</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.CheckoutEnabled)
    {
        <div class="modal fade" id="businessCheckoutModal" tabindex="-1" aria-labelledby="businessCheckoutModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content" data-business-checkout-modal>
                    <div class="modal-header">
                        <div>
                            <p class="store-home__eyebrow mb-1" data-business-checkout-table>会計</p>
                            <h2 class="modal-title fs-4" id="businessCheckoutModalLabel">会計伝票</h2>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                    </div>
                    <div class="modal-body slip-modal-form">
                        <div class="alert alert-warning" role="alert" data-business-checkout-message hidden></div>
                        <section class="slip-create__panel" data-business-checkout-issue-panel>
                            <h3>退店時刻</h3>
                            <select class="form-select form-select-lg" data-business-checkout-closed-time aria-label="退店時刻">
                                @foreach (var time in Model.TimeOptions)
                                {
                                    <option value="@time">@time</option>
                                }
                            </select>
                            <p class="text-muted mb-0">出力すると会計準備中になり、伝票内容を変更できません。</p>
                            <div class="slip-detail-add-actions">
                                <button class="btn btn-primary btn-lg" type="button" data-business-issue-statement>会計伝票を出力</button>
                            </div>
                        </section>

                        <section class="checkout-review" data-business-checkout-statement hidden>
                            <div class="checkout-review__hero" data-business-statement-summary></div>
                            <section class="checkout-review__panel">
                                <div class="checkout-review__panel-title"><h3>注文</h3></div>
                                <div class="checkout-review__orders" data-business-statement-orders></div>
                            </section>
                            <section class="checkout-review__panel">
                                <div class="checkout-review__panel-title"><h3>調整</h3></div>
                                <div class="checkout-review__orders" data-business-statement-adjustments></div>
                            </section>
                            <div class="checkout-review__totals" data-business-statement-totals></div>
                        </section>

                        <section class="slip-create__panel" data-business-statement-print-panel hidden>
                            <h3>会計伝票の印刷</h3>
                            <p data-business-statement-print-state>印刷待ちです。印刷成功または店員完了の明示後に会計を確定できます。</p>
                            <div class="slip-detail-add-actions">
                                <button class="btn btn-outline-primary" type="button" data-business-print-statement>印刷する</button>
                                <button class="btn btn-outline-secondary" type="button" data-business-statement-staff-complete>印刷完了として進む</button>
                                <button class="btn btn-outline-danger" type="button" data-business-release-checkout>会計準備を解除</button>
                            </div>
                        </section>

                        <section class="slip-create__panel" data-business-payment-panel hidden>
                            <h3>会計確定</h3>
                            <div class="checkout-payments" data-business-payment-rows></div>
                            <div class="row g-3 mt-1">
                                <div class="col-md-6">
                                    <label class="form-label" for="businessReceiptAddressee">領収書宛名</label>
                                    <input class="form-control form-control-lg" id="businessReceiptAddressee" maxlength="120" autocomplete="off" data-business-receipt-addressee />
                                </div>
                                <div class="col-md-6" data-business-received-row hidden>
                                    <label class="form-label" for="businessReceivedAmount">受取額</label>
                                    <input class="form-control form-control-lg" id="businessReceivedAmount" type="number" min="0" step="1" data-business-received-amount />
                                </div>
                            </div>
                            <div class="checkout-final-summary" data-business-payment-summary></div>
                            <div class="slip-detail-add-actions">
                                <button class="btn btn-primary btn-lg" type="button" data-business-confirm-checkout disabled>会計を確定</button>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.IsReceiptPrinterEnabled)
    {
        @if (!string.IsNullOrWhiteSpace(Model.ReceiptPrinterBrowserSdkScriptUrl))
        {
            <script>
                window.prosperSiiReceiptSdkScript = {
                    url: @Json.Serialize(Url.Content(Model.ReceiptPrinterBrowserSdkScriptUrl)),
                    loaded: false,
                    failed: false
                };
            </script>
            <script src="@Url.Content(Model.ReceiptPrinterBrowserSdkScriptUrl)"
                    onload="window.prosperSiiReceiptSdkScript.loaded = true"
                    onerror="window.prosperSiiReceiptSdkScript.failed = true"></script>
        }
        <script>
            window.prosperSiiReceiptPrinter = @Json.Serialize(Model.ReceiptPrinterBrowserOptions);
        </script>
        <script src="~/js/features/sii-receipt-layout.js" asp-append-version="true"></script>
        <script src="~/js/features/sii-receipt-printer.js" asp-append-version="true"></script>
        <script src="~/js/features/sii-checkout-statement-printer.js" asp-append-version="true"></script>
    }
    <script>
        window.prosperBusinessHome = @Json.Serialize(new
        {
            businessSlipsUrl = Url.Page("/Index", "BusinessSlips"),
            issueCheckoutStatementUrl = Url.Page("/Index", "IssueCheckoutStatement"),
            getCheckoutStatementPrintDataUrl = Url.Page("/Index", "GetCheckoutStatementPrintData"),
            releaseCheckoutReadyUrl = Url.Page("/Index", "ReleaseCheckoutReady"),
            confirmCheckoutUrl = Url.Page("/Index", "ConfirmCheckout"),
            getCheckoutReceiptPrintDataUrl = Url.Page("/Index", "GetCheckoutReceiptPrintData"),
            cancelCheckoutUrl = Url.Page("/Index", "CancelCheckout"),
            businessDate = Model.DisplayBusinessDate.ToString("yyyy-MM-dd"),
            receiptPrinterEnabled = Model.IsReceiptPrinterEnabled
        });
    </script>
    <script src="~/js/features/business-home.js" asp-append-version="true"></script>
    <script src="~/js/features/business-checkout.js" asp-append-version="true"></script>
    <script>
        window.prosperCreateSlip = @Json.Serialize(new
        {
            attendanceCastsUrl = Url.Page("/Index", "AttendanceCasts"),
            showCreateSlipModal = Model.ShowCreateSlipModal,
            castOptions = Model.AttendanceCasts.Select(c => new
            {
                id = c.CastId,
                name = c.DisplayName,
                display = c.SearchDisplayName,
                department = c.DepartmentName
            }),
            nominationKindOptions = nominationOptions.Select(option => new
            {
                value = option.Value,
                label = option.Label,
                isCompanion = IsCompanionNomination(option.Value)
            }),
            nominationPriceOptions = nominationPriceOptions.Select(price => new
            {
                value = price,
                label = StoreUiText.Yen(price)
            })
        });
    </script>
    <script src="~/js/features/cast-select-modal.js" asp-append-version="true"></script>
    <script src="~/js/features/create-slip-modal.js" asp-append-version="true"></script>
}
