@page
@using ProsperApp.Models
@model ClosingCastSalesAdjustmentModel
@{
    ViewData["Title"] = "キャスト売上額調整";
    ViewData["HasCurrentBusinessDay"] = Model.CurrentBusinessDay is not null;
}

<section class="store-home">
    <div class="business-status-bar">
        <div>
            <strong>締め作業 / キャスト売上額調整</strong>
            @if (Model.CurrentBusinessDay is null)
            {
                <span>営業中の営業日はありません</span>
            }
            else
            {
                <span>@Model.CurrentBusinessDay.BusinessDate.ToString("yyyy-MM-dd") / @Model.CastSalesAmountBasisLabel / @Model.CastSalesSplitModeLabel</span>
            }
        </div>
        <div class="business-status-bar__actions">
            <a class="btn btn-outline-secondary" asp-page="/Index">営業中へ戻る</a>
            <a class="btn btn-outline-secondary" asp-page="/Closing/Index">締め作業へ戻る</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (Model.CurrentBusinessDay is null)
    {
        <div class="alert alert-info mb-0">
            会計済み伝票ができたら、指名キャストへの売上額を調整できます。
        </div>
    }
    else if (Model.CastSalesAdjustmentStatus.RequiredSlipCount == 0)
    {
        <div class="alert alert-info mb-0">
            会計済みかつ指名キャストがいる伝票が対象です。現在、調整が必要な伝票はありません。
        </div>
    }
    else
    {
        <section class="closing-entry-panel closing-entry-panel--stack" aria-label="キャスト売上額調整対象伝票">
            <div class="closing-entry-panel__body">
                <h2 class="h5 mb-1">伝票一覧</h2>
                <p class="text-muted mb-0">
                    @if (Model.CastSalesAdjustmentStatus.MissingSlipCount > 0)
                    {
                        @($"{Model.CastSalesAdjustmentStatus.MissingSlipCount}件の伝票で売上額調整が未完了です。")
                    }
                    else
                    {
                        @($"{Model.CastSalesAdjustmentStatus.CompletedSlipCount}件の伝票を調整済みです。")
                    }
                </p>
            </div>
            <div class="cast-sales-adjustment-list">
                <div class="cast-sales-adjustment-list__row cast-sales-adjustment-list__row--header">
                    <span>卓番</span>
                    <span>客名</span>
                    <span>キャスト売上</span>
                    <span>操作</span>
                </div>
                @foreach (var slip in Model.CastSalesAdjustmentSlips)
                {
                    var detail = Model.FindCastSalesAdjustmentDetail(slip.SlipId);
                    <div class="cast-sales-adjustment-list__row">
                        <span class="cast-sales-adjustment-list__slip">
                            <strong>@slip.TableDisplayName</strong>
                            小計 @slip.SubtotalAmount.ToString("N0") 円
                            <small>会計 @slip.TotalAmount.ToString("N0") 円</small>
                        </span>
                        <span class="cast-sales-adjustment-list__customers">@slip.CustomerDisplayNames</span>
                        <span class="cast-sales-adjustment-list__casts">
                            @if (detail is not null)
                            {
                                @foreach (var castRow in detail.Casts)
                                {
                                    <span class="cast-sales-adjustment-list__cast">
                                        <strong>@castRow.CastDisplayName</strong>
                                        <small>@($"{castRow.NominationDisplayName} / {castRow.EffectiveSalesAmount:N0} 円")</small>
                                    </span>
                                }
                            }
                            else
                            {
                                <small>確認不可</small>
                            }
                        </span>
                        <span class="cast-sales-adjustment-list__action">
                            @if (detail is not null)
                            {
                                <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#castSalesAdjustmentModal-@slip.SlipId">売上額調整</button>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary btn-sm" type="button" disabled>確認不可</button>
                            }
                        </span>
                    </div>
                }
            </div>
        </section>
    }

    @foreach (var detail in Model.CastSalesAdjustmentDetails)
    {
        var baseAmount = Model.CastSalesAmountBasis == LocalSettings.CastSalesAmountBasisSubtotal
            ? detail.SubtotalAmount
            : detail.TotalAmount;
        <div class="modal fade" id="castSalesAdjustmentModal-@detail.SlipId" tabindex="-1" aria-labelledby="castSalesAdjustmentModalLabel-@detail.SlipId" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <form method="post" asp-page-handler="Save">
                        <div class="modal-header">
                            <div>
                                <p class="store-home__eyebrow mb-1">@detail.TableDisplayName</p>
                                <h2 class="modal-title fs-4" id="castSalesAdjustmentModalLabel-@detail.SlipId">売上額調整</h2>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                        </div>
                        <div class="modal-body cast-sales-adjustment-modal">
                            <input type="hidden" name="CastSalesAdjustmentInput.BusinessDayId" value="@Model.CurrentBusinessDay?.BusinessDayId" />
                            <input type="hidden" name="CastSalesAdjustmentInput.SlipId" value="@detail.SlipId" />
                            <input type="hidden" name="CastSalesAdjustmentInput.SourceAmountType" value="@Model.CastSalesAmountBasis" />
                            <input type="hidden" name="CastSalesAdjustmentInput.SplitMode" value="@Model.CastSalesSplitMode" />

                            <div class="cast-sales-adjustment-modal__summary">
                                <div>
                                    <span>小計</span>
                                    <strong>@detail.SubtotalAmount.ToString("N0") 円</strong>
                                </div>
                                <div>
                                    <span>ServiceTax20%</span>
                                    <strong>@detail.ServiceTaxAmount.ToString("N0") 円</strong>
                                </div>
                                <div>
                                    <span>会計</span>
                                    <strong>@detail.TotalAmount.ToString("N0") 円</strong>
                                </div>
                                <div>
                                    <span>配分基準</span>
                                    <strong>@Model.CastSalesAmountBasisLabel @baseAmount.ToString("N0") 円</strong>
                                </div>
                            </div>

                            <div class="cast-sales-adjustment-casts">
                                <div class="cast-sales-adjustment-casts__row cast-sales-adjustment-casts__row--header">
                                    <span>指名キャスト</span>
                                    <span>区分</span>
                                    <span>売上額</span>
                                </div>
                                @for (var i = 0; i < detail.Casts.Count; i++)
                                {
                                    var castRow = detail.Casts[i];
                                    <div class="cast-sales-adjustment-casts__row">
                                        <input type="hidden" name="CastSalesAdjustmentInput.Casts[@i].SlipCastId" value="@castRow.SlipCastId" />
                                        <strong>@castRow.CastDisplayName</strong>
                                        <span>@castRow.NominationDisplayName</span>
                                        <label class="cast-sales-adjustment-casts__amount">
                                            <input class="form-control" name="CastSalesAdjustmentInput.Casts[@i].SalesAmount" value="@ClosingCastSalesAdjustmentModel.FormatAmountValue(castRow.EffectiveSalesAmount)" type="number" min="0" step="1" inputmode="numeric" />
                                            <span>円</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">キャンセル</button>
                            <button type="submit" class="btn btn-primary">売上額調整を保存</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</section>

@section Scripts {
    @if (Model.ShowCastSalesAdjustmentModalSlipId is > 0)
    {
        <script>
            (() => {
                const modalElement = document.getElementById('castSalesAdjustmentModal-@Model.ShowCastSalesAdjustmentModalSlipId');
                if (modalElement && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(modalElement).show();
                }
            })();
        </script>
    }
}
