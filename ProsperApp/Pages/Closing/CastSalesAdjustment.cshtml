@page
@model CastSalesAdjustmentModel
@{
    ViewData["Title"] = "キャスト売上額調整";
    ViewData["HasCurrentBusinessDay"] = false;
}

<section class="store-home terminal-page cast-sales-editor"
         data-cast-sales-editor
         data-department-id="@Model.StoreDepartmentId"
         data-overview-url="@Url.Page("/Closing/CastSalesAdjustment", "Overview")"
         data-save-url="@Url.Page("/Closing/CastSalesAdjustment", "SaveV2")"
         data-confirm-url="@Url.Page("/Closing/CastSalesAdjustment", "ConfirmAllV2")">
    <div class="page-section-heading cast-sales-editor__heading">
        <div>
            <h1>キャスト売上額調整</h1>
            <p data-cast-sales-summary>現在の営業日を確認しています</p>
        </div>
        <a class="btn btn-outline-secondary" asp-page="/Closing/Index">締め作業へ戻る</a>
    </div>

    <form class="d-none" aria-hidden="true" data-cast-sales-token-form>
        @Html.AntiForgeryToken()
    </form>

    <div class="alert alert-danger" role="alert" data-cast-sales-error hidden>
        <span data-cast-sales-error-message></span>
        <button class="btn btn-outline-danger btn-sm ms-2" type="button" data-cast-sales-retry>再試行</button>
    </div>
    <div class="alert alert-success" role="status" data-cast-sales-success hidden></div>
    <div class="text-muted small mb-2" data-cast-sales-updated>状態を取得しています。</div>

    <div class="cast-sales-editor__loading" data-cast-sales-loading aria-live="polite">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>調整対象を取得しています</span>
    </div>

    <div class="cast-sales-editor__empty" data-cast-sales-empty hidden>
        <strong data-cast-sales-empty-title>調整対象はありません</strong>
        <span data-cast-sales-empty-message>会計済みかつ指名キャストがいる伝票が対象です。</span>
    </div>

    <div class="cast-sales-editor__list" data-cast-sales-list aria-label="キャスト売上額調整対象伝票" hidden></div>

    <div class="cast-sales-editor__actions" data-cast-sales-actions hidden>
        <span data-cast-sales-missing></span>
        <button class="btn btn-primary btn-lg" type="button" data-cast-sales-confirm>全件確認</button>
    </div>

    <output class="terminal-save-status cast-sales-editor__status"
            data-cast-sales-status
            data-save-state="idle"
            aria-live="polite">状態を取得しています。</output>

    <div class="modal fade" id="castSalesAdjustmentModal" tabindex="-1" aria-labelledby="castSalesAdjustmentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <form data-cast-sales-form>
                    <div class="modal-header">
                        <div>
                            <p class="store-home__eyebrow mb-1" data-cast-sales-base></p>
                            <h2 class="modal-title fs-4" id="castSalesAdjustmentModalLabel">売上額調整</h2>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                    </div>
                    <div class="modal-body cast-sales-editor__modal-body">
                        <p class="text-muted small mb-3" data-cast-sales-guidance></p>
                        <div class="cast-sales-editor__cast-table">
                            <div class="cast-sales-editor__cast-row cast-sales-editor__cast-row--header" aria-hidden="true">
                                <span>指名キャスト</span>
                                <span>区分</span>
                                <span>売上額</span>
                            </div>
                            <div data-cast-sales-casts></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">閉じる</button>
                        <button type="submit" class="btn btn-primary" data-cast-sales-save>保存</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/features/cast-sales-adjustment.js" asp-append-version="true"></script>
}
