@page
@model ClosingDrinkCostModel
@{
    ViewData["Title"] = "酒代入力";
    ViewData["HasCurrentBusinessDay"] = Model.CurrentBusinessDay is not null;
}

<section class="store-home">
    <div class="page-section-heading">
        <h1>酒代入力</h1>
        @if (Model.CurrentBusinessDay is null)
        {
            <p>営業日 @Model.CurrentBusinessDate.ToString("yyyy-MM-dd") / 保存時に自動作成</p>
        }
        else
        {
            <p>@Model.CurrentBusinessDay.BusinessDate.ToString("yyyy-MM-dd")</p>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (Model.CurrentBusinessDay is null)
    {
        <div class="alert alert-info">
            保存すると営業日 @Model.CurrentBusinessDate.ToString("yyyy-MM-dd") を自動作成します。酒代がない場合も 0 円で保存してください。
        </div>
    }

    @if (Model.CurrentBusinessDay is not null && !Model.IsDrinkDeliveryAmountEntered)
    {
        <div class="alert alert-warning">
            納品額が未入力です。酒代がない場合も 0 円で保存してください。
        </div>
    }

    <form method="post" class="closing-entry-panel">
        <input asp-for="Input.BusinessDayId" type="hidden" />
        <div class="closing-entry-panel__body">
            <label asp-for="Input.DrinkDeliveryAmount" class="form-label">納品額</label>
            <div class="closing-amount-input">
                <input asp-for="Input.DrinkDeliveryAmount" class="form-control form-control-lg" type="number" min="0" step="1" inputmode="numeric" />
                <span>円</span>
            </div>
            <span asp-validation-for="Input.DrinkDeliveryAmount" class="text-danger"></span>
        </div>
        <div class="closing-entry-panel__actions">
            <button class="btn btn-primary btn-lg" type="submit">保存</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
