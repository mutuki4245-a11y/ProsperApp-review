@page
@model ClosingDrinkCostModel
@{
    ViewData["Title"] = "酒代入力";
    ViewData["HasCurrentBusinessDay"] = false;
}

<section class="store-home terminal-page terminal-page--closing-entry"
         data-drink-delivery-editor
         data-department-id="@Model.StoreDepartmentId"
         data-current-business-date="@Model.CurrentBusinessDate.ToString("yyyy-MM-dd")"
         data-editor-url="@Url.Page("/Closing/DrinkCost", "Editor")"
         data-save-url="@Url.Page("/Closing/DrinkCost", "SaveV2")">
    <div class="page-section-heading">
        <h1>酒代入力</h1>
        <p data-drink-business-date>営業日を確認しています</p>
    </div>

    <div class="alert alert-danger" role="alert" data-drink-error hidden></div>
    <div class="alert alert-success" role="status" data-drink-success hidden></div>
    <div class="text-muted small mb-2" data-drink-updated>状態を復元しています。</div>
    <div class="alert alert-info" data-drink-guidance>
        酒代がない場合も 0 円で保存してください。
    </div>

    <form method="post" class="closing-entry-panel" data-drink-form>
        @Html.AntiForgeryToken()
        <div class="closing-entry-panel__body">
            <label for="drinkDeliveryAmount" class="form-label">納品額</label>
            <div class="closing-amount-input">
                <input id="drinkDeliveryAmount"
                       class="form-control form-control-lg"
                       type="text"
                       inputmode="numeric"
                       autocomplete="off"
                       disabled
                       data-drink-amount />
                <span>円</span>
            </div>
        </div>
        <div class="closing-entry-panel__actions">
            <a class="btn btn-outline-secondary btn-lg" asp-page="/Closing/Index">締め作業へ戻る</a>
            <button class="btn btn-primary btn-lg" type="submit" disabled data-drink-submit>保存</button>
        </div>
        <output class="terminal-save-status" data-drink-status data-save-state="idle" aria-live="polite">状態を復元しています。</output>
    </form>
</section>

@section Scripts {
    <script src="~/js/features/drink-delivery-editor.js" asp-append-version="true"></script>
}
