@page
@model ClosingDrinkCostModel
@{
    ViewData["Title"] = "酒代入力";
}

<section class="store-home">
    <div class="business-status-bar">
        <div>
            <strong>ホーム / 締め作業 / 酒代入力</strong>
            @if (Model.CurrentBusinessDay is null)
            {
                <span>営業開始前</span>
            }
            else
            {
                <span>@Model.CurrentBusinessDay.BusinessDate.ToString("yyyy-MM-dd")</span>
            }
        </div>
        <div class="business-status-bar__actions">
            <a class="btn btn-outline-secondary" asp-page="/Closing/Index">締め作業</a>
            <a class="btn btn-outline-secondary" asp-page="/Index">ホーム</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (Model.CurrentBusinessDay is null)
    {
        <div class="alert alert-warning">
            営業中の営業日がありません。
            <a class="alert-link" asp-page="/Opening/Index">営業準備へ</a>
        </div>
    }
    else
    {
        <form method="post" class="closing-entry-panel">
            <input asp-for="Input.BusinessDayId" type="hidden" />
            <div class="closing-entry-panel__body">
                <label asp-for="Input.DrinkDeliveryAmount" class="form-label">納品額</label>
                <div class="closing-amount-input">
                    <input asp-for="Input.DrinkDeliveryAmount" class="form-control form-control-lg" type="number" min="0" step="1" inputmode="numeric" />
                    <span>円</span>
                </div>
                <span asp-validation-for="Input.DrinkDeliveryAmount" class="text-danger"></span>
            </div>
            <div class="closing-entry-panel__actions">
                <button class="btn btn-primary btn-lg" type="submit">保存</button>
            </div>
        </form>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
