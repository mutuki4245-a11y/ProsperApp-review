@page
@model ClosingChampagneBacksModel
@{
    ViewData["Title"] = "シャンパンバック入力";
    ViewData["HasCurrentBusinessDay"] = Model.CurrentBusinessDay is not null;
}

<section class="store-home terminal-page terminal-page--closing-entry">
    <div class="page-section-heading">
        <h1>シャンパンバック入力</h1>
        @if (Model.CurrentBusinessDay is not null)
        {
            <p>@Model.CurrentBusinessDay.BusinessDate.ToString("yyyy-MM-dd") / 出勤キャスト @Model.Status.RequiredCastCount 名</p>
        }
        else
        {
            <p>勤怠を保存した営業日に入力します。</p>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (Model.LoadStatus is { Succeeded: false } loadStatus)
    {
        <div class="alert alert-danger" role="alert">
            <strong>@loadStatus.FailureTitle</strong>
            <div>@loadStatus.ErrorMessage</div>
            <a class="btn btn-outline-danger btn-sm mt-2" asp-page="/Closing/ChampagneBacks">再試行</a>
        </div>
    }
    else if (Model.LoadStatus?.LastUpdatedAt is { } lastUpdatedAt)
    {
        <div class="text-muted small mb-2">最終更新: @lastUpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
    }

    @if (Model.LoadStatus?.Succeeded != false && Model.CurrentBusinessDay is null)
    {
        <div class="alert alert-info">営業日と出勤キャストを登録すると、シャンパン追加バックを入力できます。</div>
    }
    else if (Model.LoadStatus?.Succeeded != false && Model.Status.RequiredCastCount == 0)
    {
        <div class="alert alert-warning">出勤キャストが未登録です。勤怠確認で出勤キャストを登録してください。</div>
    }
    else if (Model.LoadStatus?.Succeeded != false && Model.Status.MissingCastCount > 0)
    {
        <div class="alert alert-warning">未入力のキャストが @Model.Status.MissingCastCount 名います。バックがない場合も 0 円で保存してください。</div>
    }

    @if (Model.LoadStatus?.Succeeded != false && Model.CurrentBusinessDay is not null && Model.Input.Casts.Count > 0)
    {
        <form method="post" class="closing-entry-panel">
            <input asp-for="Input.BusinessDayId" type="hidden" />
            <div class="closing-entry-panel__body">
                <div class="d-flex justify-content-between align-items-baseline gap-3 mb-3">
                    <h2 class="h5 mb-0">キャスト別追加バック</h2>
                    <span class="text-muted">保存済み合計 @StoreUiText.Yen(Model.Status.TotalBackAmount)</span>
                </div>
                <p class="text-muted small">当日の出勤キャスト全員を保存します。金額がない場合も 0 円を入力してください。</p>
                <div class="vstack gap-3">
                    @for (var index = 0; index < Model.Input.Casts.Count; index++)
                    {
                        var input = Model.Input.Casts[index];
                        var cast = Model.FindCast(input.CastId);
                        <div class="border rounded p-3">
                            <input type="hidden" name="Input.Casts[@index].CastId" value="@input.CastId" />
                            <div class="d-flex justify-content-between align-items-baseline gap-3 mb-2">
                                <strong>@(cast?.SearchDisplayName ?? "出勤キャスト")</strong>
                                @if (cast?.IsSaved == true)
                                {
                                    <span class="badge text-bg-success">保存済み</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning">未保存</span>
                                }
                            </div>
                            <label class="form-label" for="champagneBack-@index">シャンパン追加バック</label>
                            <div class="closing-amount-input">
                                <input id="champagneBack-@index" class="form-control form-control-lg" name="Input.Casts[@index].BackAmount" value="@StoreUiText.NumberInputValue(input.BackAmount)" type="number" min="0" step="1" inputmode="numeric" />
                                <span>円</span>
                            </div>
                            <span asp-validation-for="Input.Casts[index].BackAmount" class="text-danger"></span>
                        </div>
                    }
                </div>
            </div>
            <div class="closing-entry-panel__actions">
                <button class="btn btn-primary btn-lg" type="submit">全員分を保存</button>
                <a class="btn btn-outline-secondary btn-lg" asp-page="/Closing/Index">締め作業へ戻る</a>
            </div>
        </form>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
