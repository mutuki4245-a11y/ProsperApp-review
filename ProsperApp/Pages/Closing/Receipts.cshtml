@page
@model ReceiptsModel
@{
    ViewData["Title"] = "領収書簡易入力";
}

<div class="tablet-entry terminal-page terminal-page--receipts">
    <header class="tablet-entry__header">
        <div>
            <h1>領収書簡易入力</h1>
            <div class="tablet-entry__meta" data-receipt-queue-meta>
                <span data-receipt-queue-position>同期中</span>
                <span data-receipt-queue-file-name></span>
            </div>
        </div>
        <a class="btn btn-outline-secondary" asp-page="/Closing/Index">締めトップ</a>
    </header>

    <div class="alert alert-info d-none" role="status" data-receipt-queue-status></div>
    <div class="alert alert-danger d-none" role="alert" data-receipt-queue-error></div>

    <div class="tablet-entry__layout">
        <section class="tablet-entry__preview" aria-label="証憑プレビュー">
            <div class="tablet-entry__preview-header">
                <span data-receipt-queue-preview-file-name>証憑を取得しています</span>
                <a class="btn btn-outline-secondary btn-sm d-none"
                   target="_blank"
                   rel="noopener noreferrer"
                   data-receipt-queue-preview-link>
                    別タブで開く
                </a>
            </div>
            <div class="receipt-preview" data-receipt-queue-preview>
                <div class="preview-empty">証憑を取得しています。</div>
            </div>
        </section>

        <section class="tablet-entry__input">
            <form method="post" data-receipt-work-queue-form>
                <input type="hidden" asp-for="Input.DocumentId" />
                <input type="hidden" asp-for="Input.DriveFileId" />
                <input type="hidden" asp-for="Input.BusinessDayId" />
                <input type="hidden" asp-for="Input.GroupCode" />

                <div class="mb-3">
                    <label asp-for="Input.PaymentDate" class="form-label"></label>
                    <input asp-for="Input.PaymentDate"
                           class="form-control form-control-lg"
                           min="@Model.PaymentDateMin.ToString("yyyy-MM-dd")"
                           max="@Model.PaymentDateMax.ToString("yyyy-MM-dd")" />
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Amount" class="form-label"></label>
                    <input asp-for="Input.Amount"
                           class="form-control form-control-lg"
                           inputmode="numeric"
                           autocomplete="off" />
                </div>

                <div class="mb-3">
                    <label asp-for="Input.AccountSubject" class="form-label"></label>
                    <input type="hidden" asp-for="Input.AccountSubject" id="accountSubjectInput" />
                    <div class="account-subject-picker">
                        <div class="account-subject-selected" id="accountSubjectSelected">科目を選択してください</div>
                        <button type="button"
                                class="btn btn-outline-primary btn-lg"
                                data-bs-toggle="modal"
                                data-bs-target="#accountSubjectModal">
                            科目を選ぶ
                        </button>
                    </div>
                </div>

                <div class="modal fade" id="accountSubjectModal" tabindex="-1" aria-labelledby="accountSubjectModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-fullscreen-md-down modal-xl modal-dialog-scrollable">
                        <div class="modal-content account-modal">
                            <div class="modal-header">
                                <h2 class="modal-title" id="accountSubjectModalLabel">科目を選択</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                            </div>
                            <div class="modal-body">
                                <div class="account-sheet account-sheet--modal" role="group" aria-label="科目選択">
                                    @foreach (var group in Model.AccountSubjectGroups)
                                    {
                                        <section class="account-sheet__group">
                                            <h2>@group.Name</h2>
                                            <div class="account-sheet__items">
                                                @foreach (var item in group.Items)
                                                {
                                                    var value = $"{group.Name}: {item}";
                                                    <button type="button" class="account-sheet__item" data-account-value="@value">@item</button>
                                                }
                                            </div>
                                        </section>
                                    }
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">閉じる</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-3 d-none" data-cast-advance-field>
                    <label asp-for="Input.AdvanceCastId" class="form-label"></label>
                    <select asp-for="Input.AdvanceCastId"
                            class="form-select form-select-lg"
                            data-cast-advance-select>
                        <option value="">当日出勤のキャストを選択</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control form-control-lg" rows="3"></textarea>
                </div>

                <div class="tablet-entry__actions">
                    <button type="submit" class="btn btn-primary btn-lg" data-receipt-queue-action="save">保存して次へ</button>
                    <button type="submit" class="btn btn-outline-secondary btn-lg" formnovalidate data-receipt-queue-action="skip">スキップ</button>
                    <button type="submit" class="btn btn-outline-danger btn-lg tablet-entry__delete" formnovalidate data-receipt-queue-action="exclude_scan_mistake">
                        スキャンミスとして対象外
                    </button>
                </div>
            </form>
        </section>
    </div>

    <section class="mt-4 d-none" data-receipt-failed-section>
        <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
            <h2 class="h5 mb-0">要確認</h2>
            <span class="badge text-bg-warning" data-receipt-failed-count>0</span>
        </div>
        <div class="list-group" data-receipt-failed-list></div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.prosperReceiptWorkQueue = {
            enabled: true,
            readUrl: '@Url.Page("/Closing/Receipts", "WorkQueue")',
            advanceUrl: '@Url.Page("/Closing/Receipts", "QueueAdvance")'
        };
    </script>
    <script src="~/js/features/receipt-work-queue.js" asp-append-version="true"></script>
}
