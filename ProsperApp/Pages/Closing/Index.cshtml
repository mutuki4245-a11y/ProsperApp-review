@page
@using ProsperApp.Models
@model ClosingModel
@{
    ViewData["Title"] = "締め作業";
    var hasBusinessDay = Model.CurrentBusinessDay is not null;
    ViewData["HasCurrentBusinessDay"] = hasBusinessDay;
    var canCloseBusinessDay = Model.Readiness.CanClose;
    var drinkDeliveryPanelClass = hasBusinessDay && Model.IsDrinkDeliveryAmountEntered ? "is-ready" : "has-warning";
    var attendancePanelClass = hasBusinessDay && Model.ClosingAttendanceMissingClockOutCount == 0 && Model.ClosingAttendanceCount > 0
        ? "is-ready"
        : "has-warning";
    var castSalesAdjustmentPanelClass = Model.Readiness.IsCastSalesAdjustmentCompleted ? "is-ready" : "has-warning";
    var receiptsPanelClass = Model.PendingReceiptCount > 0 ? "needs-action" : "is-ready";
    var closingFinalPanelClass = canCloseBusinessDay ? "is-ready" : "has-warning";
}

<section class="store-home">
    <div class="page-section-heading">
        <h1>締め作業</h1>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="closing-list">
        @if (hasBusinessDay)
        {
            <a class="closing-panel @drinkDeliveryPanelClass" asp-page="/Closing/DrinkCost">
                <span class="closing-panel__body">
                    <strong>酒代入力</strong>
                    <small>@(Model.IsDrinkDeliveryAmountEntered ? $"営業日ごとの納品額 {Model.DrinkDeliveryAmount:N0} 円" : "納品額が未入力です。")</small>
                </span>
                <span class="closing-panel__badge @drinkDeliveryPanelClass">@(Model.IsDrinkDeliveryAmountEntered ? "入力済" : "要入力")</span>
                <span class="closing-panel__action">開く</span>
            </a>
        }
        else
        {
            <a class="closing-panel has-warning" asp-page="/Closing/DrinkCost">
                <span class="closing-panel__body">
                    <strong>酒代入力</strong>
                    <small>酒代保存時に営業日を自動作成できます。</small>
                </span>
                <span class="closing-panel__badge has-warning">要入力</span>
                <span class="closing-panel__action">入力</span>
            </a>
        }

        @if (hasBusinessDay)
        {
            <a class="closing-panel @attendancePanelClass" href="@Url.Content("~/Closing/Attendance")">
                <span class="closing-panel__body">
                    <strong>勤怠確認</strong>
                    <small>
                        @if (Model.ClosingAttendanceMissingClockOutCount > 0)
                        {
                            @($"{Model.ClosingAttendanceMissingClockOutCount}名の退勤時刻が未入力です。")
                        }
                        else if (Model.ClosingAttendanceCount > 0)
                        {
                            @($"{Model.ClosingAttendanceCount}名の勤怠を入力済みです。")
                        }
                        else
                        {
                            @("出勤キャストが登録されていません。")
                        }
                    </small>
                </span>
                <span class="closing-panel__badge @attendancePanelClass">@(Model.ClosingAttendanceMissingClockOutCount == 0 && Model.ClosingAttendanceCount > 0 ? "確認済" : "要入力")</span>
                <span class="closing-panel__action">確認/修正</span>
            </a>
        }
        else
        {
            <a class="closing-panel has-warning" href="@Url.Content("~/Closing/Attendance")">
                <span class="closing-panel__body">
                    <strong>勤怠確認</strong>
                    <small>勤怠保存時に営業日を自動作成できます。</small>
                </span>
                <span class="closing-panel__badge has-warning">要入力</span>
                <span class="closing-panel__action">入力</span>
            </a>
        }

        <a class="closing-panel @castSalesAdjustmentPanelClass" asp-page="/Closing/CastSalesAdjustment">
            <span class="closing-panel__body">
                <strong>キャスト売上額調整</strong>
                @if (!hasBusinessDay)
                {
                    <small>会計済み伝票ができたら、指名キャストへの売上額を調整します。</small>
                }
                else if (Model.CastSalesAdjustmentStatus.RequiredSlipCount == 0)
                {
                    <small>調整が必要な会計済み伝票はありません。</small>
                }
                else if (Model.Readiness.IsCastSalesAdjustmentCompleted)
                {
                    <small>@($"{Model.CastSalesAdjustmentStatus.CompletedSlipCount}件の伝票を調整済みです。")</small>
                }
                else
                {
                    <small>@($"{Model.CastSalesAdjustmentStatus.MissingSlipCount}件の伝票で売上額調整が未完了です。")</small>
                }
            </span>
            <span class="closing-panel__badge @castSalesAdjustmentPanelClass">@(Model.Readiness.IsCastSalesAdjustmentCompleted ? "調整済" : "要入力")</span>
            <span class="closing-panel__action">開く</span>
        </a>

        @if (Model.ReceiptsEnabled)
        {
            <a class="closing-panel @receiptsPanelClass" asp-page="/Closing/Receipts">
                <span class="closing-panel__body">
                    <strong>領収書入力</strong>
                    <small>@(Model.PendingReceiptCount > 0 ? $"未入力領収書が {Model.PendingReceiptCount} 件あります。" : "未入力領収書はありません。")</small>
                </span>
                <span class="closing-panel__badge @receiptsPanelClass">@(Model.PendingReceiptCount > 0 ? "要入力" : "入力済")</span>
                <span class="closing-panel__action">入力</span>
            </a>
        }
    </div>

    <section class="closing-final" aria-label="営業日締め">
        @if (!hasBusinessDay)
        {
            <article class="closing-panel closing-final-panel closing-final-panel--compact is-preparing">
                <div class="closing-panel__form">
                    <label class="form-label" for="closingMemoUnavailable">締めメモ</label>
                    <input id="closingMemoUnavailable" class="form-control form-control-lg" placeholder="営業中の営業日がありません" disabled />
                </div>
                <button class="btn btn-danger closing-panel__submit" type="button" disabled>営業日を締める</button>
            </article>
        }
        else
        {
            <form method="post" asp-page-handler="CloseBusinessDay" class="closing-panel closing-panel--form closing-final-panel closing-final-panel--compact @closingFinalPanelClass">
                <input asp-for="BusinessDayId" type="hidden" />
                <div class="closing-panel__form">
                    <div>
                        <label asp-for="ClosingMemo" class="form-label">締めメモ</label>
                        <input asp-for="ClosingMemo" class="form-control form-control-lg" maxlength="500" placeholder="必要なら共有事項を入力" />
                        <span asp-validation-for="ClosingMemo" class="text-danger"></span>
                    </div>
                </div>
                <button class="btn btn-danger closing-panel__submit" type="submit" @(canCloseBusinessDay ? null : "disabled")>営業日を締める</button>
            </form>
        }
    </section>
</section>
