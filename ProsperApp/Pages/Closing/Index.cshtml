@page
@using ProsperApp.Models
@model ClosingModel
@{
    ViewData["Title"] = "締め作業";
    var hasBusinessDay = Model.CurrentBusinessDay is not null;
    ViewData["HasCurrentBusinessDay"] = hasBusinessDay;
    var canCloseBusinessDay = Model.Readiness.CanClose;
    var drinkDeliveryPanelClass = hasBusinessDay && Model.IsDrinkDeliveryAmountEntered ? "is-ready" : "has-warning";
    var attendancePanelClass = hasBusinessDay && Model.ClosingAttendanceMissingClockOutCount == 0 && Model.ClosingAttendanceCount > 0
        ? "is-ready"
        : "has-warning";
    var castSalesAdjustmentPanelClass = Model.Readiness.IsCastSalesAdjustmentCompleted ? "is-ready" : "has-warning";
    var receiptsPanelClass = Model.PendingReceiptCount > 0 ? "needs-action" : "is-ready";
    var closingFinalPanelClass = canCloseBusinessDay ? "is-ready" : "has-warning";
}

<section class="store-home">
    <div class="page-section-heading">
        <h1>締め作業</h1>
        @if (Model.CurrentBusinessDay is null)
        {
            <p>営業中の営業日はありません</p>
        }
        else
        {
            <p>@Model.CurrentBusinessDay.BusinessDate.ToString("yyyy-MM-dd") / 未会計 @Model.OpenSlipCount 件</p>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="closing-list">
        @if (hasBusinessDay)
        {
            <a class="closing-panel @drinkDeliveryPanelClass" asp-page="/Closing/DrinkCost">
                <span class="closing-panel__body">
                    <strong>酒代入力</strong>
                    <small>@(Model.IsDrinkDeliveryAmountEntered ? $"営業日ごとの納品額 {Model.DrinkDeliveryAmount:N0} 円" : "納品額が未入力です。")</small>
                </span>
                <span class="closing-panel__badge @drinkDeliveryPanelClass">@(Model.IsDrinkDeliveryAmountEntered ? "入力済" : "要入力")</span>
                <span class="closing-panel__action">開く</span>
            </a>
        }
        else
        {
            <a class="closing-panel has-warning" asp-page="/Closing/DrinkCost">
                <span class="closing-panel__body">
                    <strong>酒代入力</strong>
                    <small>酒代保存時に営業日を自動作成できます。</small>
                </span>
                <span class="closing-panel__badge has-warning">要入力</span>
                <span class="closing-panel__action">入力</span>
            </a>
        }

        @if (hasBusinessDay)
        {
            <a class="closing-panel @attendancePanelClass" asp-page="/Closing/Attendance">
                <span class="closing-panel__body">
                    <strong>勤怠確認</strong>
                    <small>
                        @if (Model.ClosingAttendanceMissingClockOutCount > 0)
                        {
                            @($"{Model.ClosingAttendanceMissingClockOutCount}名の退勤時刻が未入力です。")
                        }
                        else if (Model.ClosingAttendanceCount > 0)
                        {
                            @($"{Model.ClosingAttendanceCount}名の勤怠を入力済みです。")
                        }
                        else
                        {
                            @("出勤キャストが登録されていません。")
                        }
                    </small>
                </span>
                <span class="closing-panel__badge @attendancePanelClass">@(Model.ClosingAttendanceMissingClockOutCount == 0 && Model.ClosingAttendanceCount > 0 ? "確認済" : "要入力")</span>
                <span class="closing-panel__action">確認/修正</span>
            </a>
        }
        else
        {
            <a class="closing-panel has-warning" asp-page="/Closing/Attendance">
                <span class="closing-panel__body">
                    <strong>勤怠確認</strong>
                    <small>勤怠保存時に営業日を自動作成できます。</small>
                </span>
                <span class="closing-panel__badge has-warning">要入力</span>
                <span class="closing-panel__action">入力</span>
            </a>
        }

        <div class="closing-panel closing-panel--section @castSalesAdjustmentPanelClass">
            <span class="closing-panel__body">
                <strong>キャスト売上額調整</strong>
                @if (!hasBusinessDay)
                {
                    <small>会計済み伝票ができたら、指名キャストへの売上額を調整します。</small>
                }
                else if (Model.CastSalesAdjustmentStatus.RequiredSlipCount == 0)
                {
                    <small>調整が必要な会計済み伝票はありません。</small>
                }
                else if (Model.Readiness.IsCastSalesAdjustmentCompleted)
                {
                    <small>@($"{Model.CastSalesAdjustmentStatus.CompletedSlipCount}件の伝票を調整済みです。")</small>
                }
                else
                {
                    <small>@($"{Model.CastSalesAdjustmentStatus.MissingSlipCount}件の伝票で売上額調整が未完了です。")</small>
                }
            </span>
            <span class="closing-panel__badge @castSalesAdjustmentPanelClass">@(Model.Readiness.IsCastSalesAdjustmentCompleted ? "調整済" : "要入力")</span>
            <div class="closing-panel__form">
                @if (hasBusinessDay && Model.CastSalesAdjustmentSlips.Count > 0)
                {
                    <div class="slip-list cast-sales-adjustment-list" aria-label="キャスト売上額調整対象伝票">
                        @foreach (var slip in Model.CastSalesAdjustmentSlips)
                        {
                            var detail = Model.FindCastSalesAdjustmentDetail(slip.SlipId);
                            var castNames = Model.GetCastSalesAdjustmentCastNames(slip);
                            <div class="slip-list__row slip-list__row--action cast-sales-adjustment-list__row">
                                <strong class="slip-list__table">@slip.TableDisplayName</strong>
                                <span class="badge @(slip.IsAdjusted ? "text-bg-secondary" : "text-bg-danger")">
                                    @(slip.IsAdjusted ? "調整済" : "未調整")
                                </span>
                                <span>@StoreBusinessTime.FormatStoreTime(slip.CheckoutAt)</span>
                                <span class="slip-list__casts">@(string.IsNullOrWhiteSpace(castNames) ? "指名なし" : castNames)</span>
                                <span class="slip-list__memo">@($"{slip.RequiredCastCount}名")</span>
                                <strong class="slip-list__amount">@slip.TotalAmount.ToString("N0") 円</strong>
                                <span class="cast-sales-adjustment-list__action">
                                    @if (detail is not null)
                                    {
                                        <button class="btn @(slip.IsAdjusted ? "btn-outline-secondary" : "btn-primary") btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#castSalesAdjustmentModal-@slip.SlipId">
                                            @(slip.IsAdjusted ? "再調整" : "売上額調整")
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary btn-sm" type="button" disabled>確認不可</button>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                }
                else if (hasBusinessDay)
                {
                    <p class="text-muted mb-0">会計済みかつ指名キャストがいる伝票が対象です。</p>
                }
            </div>
        </div>

        @if (Model.ReceiptsEnabled)
        {
            <a class="closing-panel @receiptsPanelClass" asp-page="/Closing/Receipts">
                <span class="closing-panel__body">
                    <strong>領収書入力</strong>
                    <small>@(Model.PendingReceiptCount > 0 ? $"未入力領収書が {Model.PendingReceiptCount} 件あります。" : "未入力領収書はありません。")</small>
                </span>
                <span class="closing-panel__badge @receiptsPanelClass">@(Model.PendingReceiptCount > 0 ? "要確認" : "確認済")</span>
                <span class="closing-panel__action">確認</span>
            </a>
        }
    </div>

    <section class="closing-final" aria-label="営業日締め">
        @if (!hasBusinessDay)
        {
            <a class="closing-panel closing-final-panel is-preparing" asp-page="/Index">
                <span class="closing-panel__body">
                    <strong>営業日締め</strong>
                    <small>営業中の営業日はありません。最初の業務入力で営業日が自動作成されます。</small>
                </span>
                <span class="closing-panel__badge is-preparing">待機</span>
                <span class="closing-panel__action">営業中へ戻る</span>
            </a>
        }
        else
        {
            <form method="post" asp-page-handler="CloseBusinessDay" class="closing-panel closing-panel--form closing-final-panel @closingFinalPanelClass">
                <input asp-for="BusinessDayId" type="hidden" />
                <span class="closing-panel__body">
                    <strong>営業日締め</strong>
                    <small>@(canCloseBusinessDay ? "すべての締め条件が完了しています。" : "未完了の締め条件があります。")</small>
                </span>
                <span class="closing-panel__badge @closingFinalPanelClass">@(canCloseBusinessDay ? "実行可" : "不可")</span>
                <button class="btn btn-danger closing-panel__submit" type="submit" @(canCloseBusinessDay ? null : "disabled")>営業日を締める</button>
                <div class="closing-panel__form">
                    @if (!canCloseBusinessDay)
                    {
                        <div class="alert alert-warning mb-0">
                            <ul class="mb-0">
                                @foreach (var reason in Model.Readiness.BlockReasons)
                                {
                                    <li>@reason</li>
                                }
                            </ul>
                        </div>
                    }
                    <div>
                        <label asp-for="ClosingMemo" class="form-label">締めメモ</label>
                        <input asp-for="ClosingMemo" class="form-control form-control-lg" maxlength="500" placeholder="必要なら共有事項を入力" />
                        <span asp-validation-for="ClosingMemo" class="text-danger"></span>
                    </div>
                </div>
            </form>
        }
    </section>

    @if (hasBusinessDay)
    {
        @foreach (var detail in Model.CastSalesAdjustmentDetails)
        {
            var baseAmount = Model.CastSalesAmountBasis == LocalSettings.CastSalesAmountBasisSubtotal
                ? detail.SubtotalAmount
                : detail.TotalAmount;
            <div class="modal fade" id="castSalesAdjustmentModal-@detail.SlipId" tabindex="-1" aria-labelledby="castSalesAdjustmentModalLabel-@detail.SlipId" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content">
                        <form method="post" asp-page-handler="SaveCastSalesAdjustment">
                            <div class="modal-header">
                                <div>
                                    <p class="store-home__eyebrow mb-1">配分基準 @baseAmount.ToString("N0") 円</p>
                                    <h2 class="modal-title fs-4" id="castSalesAdjustmentModalLabel-@detail.SlipId">売上額調整</h2>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                            </div>
                            <div class="modal-body cast-sales-adjustment-modal">
                                <input type="hidden" name="CastSalesAdjustmentInput.BusinessDayId" value="@Model.CurrentBusinessDay?.BusinessDayId" />
                                <input type="hidden" name="CastSalesAdjustmentInput.SlipId" value="@detail.SlipId" />
                                <input type="hidden" name="CastSalesAdjustmentInput.SourceAmountType" value="@Model.CastSalesAmountBasis" />
                                <input type="hidden" name="CastSalesAdjustmentInput.SplitMode" value="@Model.CastSalesSplitMode" />

                                <div class="cast-sales-adjustment-casts">
                                    <div class="cast-sales-adjustment-casts__row cast-sales-adjustment-casts__row--header">
                                        <span>指名キャスト</span>
                                        <span>区分</span>
                                        <span>売上額</span>
                                    </div>
                                    @for (var i = 0; i < detail.Casts.Count; i++)
                                    {
                                        var castRow = detail.Casts[i];
                                        <div class="cast-sales-adjustment-casts__row">
                                            <input type="hidden" name="CastSalesAdjustmentInput.Casts[@i].SlipCastId" value="@castRow.SlipCastId" />
                                            <strong>@castRow.CastDisplayName</strong>
                                            <span>@castRow.NominationDisplayName</span>
                                            <label class="cast-sales-adjustment-casts__amount">
                                                <input class="form-control" name="CastSalesAdjustmentInput.Casts[@i].SalesAmount" value="@ClosingModel.FormatAmountValue(castRow.EffectiveSalesAmount)" type="number" min="0" step="1" inputmode="numeric" />
                                                <span>円</span>
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">キャンセル</button>
                                <button type="submit" class="btn btn-primary">売上額調整を保存</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</section>

@section Scripts {
    @if (Model.ShowCastSalesAdjustmentModalSlipId is > 0)
    {
        <script>
            (() => {
                const modalElement = document.getElementById('castSalesAdjustmentModal-@Model.ShowCastSalesAdjustmentModalSlipId');
                if (modalElement && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(modalElement).show();
                }
            })();
        </script>
    }
}
