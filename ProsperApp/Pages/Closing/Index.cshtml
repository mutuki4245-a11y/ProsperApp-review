@page
@model ClosingModel
@{
    ViewData["Title"] = "締め作業";
    var hasBusinessDay = Model.CurrentBusinessDay is not null;
    ViewData["HasCurrentBusinessDay"] = hasBusinessDay;
}

<section class="store-home terminal-page terminal-page--closing">
    <div class="page-section-heading">
        <h1>締め作業</h1>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (Model.LoadStatus is { Succeeded: false } loadStatus)
    {
        <div class="alert alert-danger" role="alert">
            <strong>@loadStatus.FailureTitle</strong>
            <div>@loadStatus.ErrorMessage</div>
            <a class="btn btn-outline-danger btn-sm mt-2" asp-page="/Closing/Index">再試行</a>
        </div>
    }
    else if (Model.LoadStatus?.LastUpdatedAt is { } lastUpdatedAt)
    {
        <div class="text-muted small mb-2">最終更新: @lastUpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
    }

    <div class="closing-list"
         data-closing-panels
         data-current-business-day-id="@Model.CurrentBusinessDay?.BusinessDayId"
         data-has-business-day="@hasBusinessDay.ToString().ToLowerInvariant()"
         data-receipts-enabled="@Model.ReceiptsEnabled.ToString().ToLowerInvariant()"
         data-readiness-url="@Url.Page("/Closing/Index", "Readiness")"
         data-receipts-url="@(Model.ReceiptsEnabled ? Url.Page("/Closing/Index", "Receipts") : null)">
        <a class="closing-panel is-preparing" asp-page="/Index" data-closing-panel="openSlip">
            <span class="closing-panel__body">
                <strong class="closing-panel__title"><span class="closing-panel__step" aria-hidden="true">1</span><span>会計確認</span></strong>
                <small data-closing-message>状態を確認しています。</small>
            </span>
            <span class="closing-panel__badge is-preparing" data-closing-badge>確認中</span>
            <span class="closing-panel__action" data-closing-action>営業中を開く</span>
        </a>

        <a class="closing-panel is-preparing" asp-page="/Closing/DrinkCost" data-closing-panel="drinkDelivery">
            <span class="closing-panel__body">
                <strong class="closing-panel__title"><span class="closing-panel__step" aria-hidden="true">2</span><span>酒代入力</span></strong>
                <small data-closing-message>状態を確認しています。</small>
            </span>
            <span class="closing-panel__badge is-preparing" data-closing-badge>確認中</span>
            <span class="closing-panel__action" data-closing-action>開く</span>
        </a>

        <a class="closing-panel is-preparing" href="@Url.Content("~/Closing/Attendance")" data-closing-panel="attendance">
            <span class="closing-panel__body">
                <strong class="closing-panel__title"><span class="closing-panel__step" aria-hidden="true">3</span><span>勤怠確認</span></strong>
                <small data-closing-message>状態を確認しています。</small>
            </span>
            <span class="closing-panel__badge is-preparing" data-closing-badge>確認中</span>
            <span class="closing-panel__action" data-closing-action>確認/修正</span>
        </a>

        <a class="closing-panel is-preparing" asp-page="/Closing/CastSalesAdjustment" data-closing-panel="castSalesAdjustment">
            <span class="closing-panel__body">
                <strong class="closing-panel__title"><span class="closing-panel__step" aria-hidden="true">4</span><span>キャスト売上額調整</span></strong>
                <small data-closing-message>状態を確認しています。</small>
            </span>
            <span class="closing-panel__badge is-preparing" data-closing-badge>確認中</span>
            <span class="closing-panel__action" data-closing-action>開く</span>
        </a>

        <a class="closing-panel is-preparing" asp-page="/Closing/ChampagneBacks" data-closing-panel="champagneBack">
            <span class="closing-panel__body">
                <strong class="closing-panel__title"><span class="closing-panel__step" aria-hidden="true">5</span><span>シャンパンバック入力</span></strong>
                <small data-closing-message>状態を確認しています。</small>
            </span>
            <span class="closing-panel__badge is-preparing" data-closing-badge>確認中</span>
            <span class="closing-panel__action" data-closing-action>開く</span>
        </a>

        @if (Model.ReceiptsEnabled)
        {
            <a class="closing-panel is-preparing" asp-page="/Closing/Receipts" data-closing-panel="receipts">
                <span class="closing-panel__body">
                    <strong class="closing-panel__title"><span class="closing-panel__step" aria-hidden="true">6</span><span>領収書入力（任意）</span></strong>
                    <small data-closing-message>状態を確認しています。</small>
                </span>
                <span class="closing-panel__badge is-preparing" data-closing-badge>確認中</span>
                <span class="closing-panel__action" data-closing-action>入力</span>
            </a>
        }
    </div>

    <section class="closing-final" aria-label="営業日締め">
        @if (!hasBusinessDay)
        {
            <article class="closing-panel closing-final-panel closing-final-panel--compact is-preparing">
                <div class="closing-panel__form">
                    <label class="form-label" for="closingMemoUnavailable">締めメモ</label>
                    <input id="closingMemoUnavailable" class="form-control form-control-lg" placeholder="営業中の営業日がありません" disabled />
                </div>
                <button class="btn btn-danger closing-panel__submit" type="button" disabled>営業日を締める</button>
            </article>
        }
        else
        {
            <form method="post" asp-page-handler="CloseBusinessDay" class="closing-panel closing-panel--form closing-final-panel closing-final-panel--compact is-preparing" data-closing-final>
                <input asp-for="BusinessDayId" type="hidden" />
                <div class="closing-panel__form">
                    <div>
                        <label asp-for="ClosingMemo" class="form-label"><span class="closing-panel__step" aria-hidden="true">@(Model.ReceiptsEnabled ? "7" : "6")</span><span>締めメモ・営業日締め</span></label>
                        <input asp-for="ClosingMemo" class="form-control form-control-lg" maxlength="500" placeholder="必要なら共有事項を入力" />
                        <span asp-validation-for="ClosingMemo" class="text-danger"></span>
                    </div>
                    @if (Model.IsAdminMode)
                    {
                        <label class="form-check closing-final__override">
                            <input asp-for="IgnoreClosingRequirements" class="form-check-input" type="checkbox" data-closing-override />
                            <span class="form-check-label">締め条件を無視</span>
                        </label>
                    }
                </div>
                <button class="btn btn-danger closing-panel__submit" type="submit" data-closing-close-submit disabled>確認中</button>
                <button class="btn btn-outline-secondary closing-final__retry" type="button" data-closing-retry>再取得</button>
                <output class="terminal-save-status closing-final__status" data-closing-final-status data-save-state="saving" aria-live="polite">締め条件を確認しています。</output>
            </form>
        }
    </section>

    <section class="daily-report"
             aria-labelledby="dailyReportTitle"
             aria-busy="true"
             data-daily-report
             data-report-url="@Url.Page("/Closing/Index", "DailyReport", new { businessDayId = Model.ReportBusinessDayId })">
        <header class="daily-report__header">
            <div>
                <div class="daily-report__eyebrow">DAILY REPORT</div>
                <h2 id="dailyReportTitle">日報</h2>
                <p class="daily-report__subtitle" data-report-subtitle>日報を取得しています。</p>
            </div>
            <div class="daily-report__actions">
                <span class="badge text-bg-secondary" data-report-state>取得中</span>
                <button class="btn btn-outline-secondary btn-sm" type="button" data-report-refresh>再取得</button>
                <button class="btn btn-dark btn-sm" type="button" data-report-print disabled>印刷</button>
            </div>
        </header>

        <div class="alert alert-secondary daily-report__loading" role="status" data-report-status>
            清書した日報を作成しています。
        </div>
        <div class="daily-report__warnings" data-report-warnings hidden></div>

        <div class="daily-report__content" data-report-content hidden>
            <div class="daily-report__pages">
                <article class="daily-report__page daily-report__page--summary" aria-label="1ページ目 日計表">
                    <div class="daily-report__page-content" data-report-page-content>
                    <header class="daily-report__sheet-header">
                        <div class="daily-report__store-name" data-report-department>店舗</div>
                        <h3>①日計表</h3>
                        <div class="daily-report__sheet-date" data-report-sheet-date></div>
                        <span class="daily-report__page-number" aria-hidden="true">1 / 3</span>
                    </header>

                    <div class="daily-report__ledger-grid">
                        <table class="daily-report__form-table" aria-label="日計">
                            <tbody>
                                <tr><th>総売上</th><td data-report-total="sales"></td></tr>
                                <tr><th>現金</th><td data-report-total="cash"></td></tr>
                                <tr><th>支出</th><td data-report-total="expense"></td></tr>
                                <tr class="daily-report__summary-emphasis"><th>現金残高</th><td data-report-total="balance"></td></tr>
                            </tbody>
                        </table>
                        <div class="daily-report__summary-side">
                            <div class="daily-report__count-grid" aria-label="営業集計">
                                <div><span>出勤人数</span><strong data-report-count="attendance"></strong></div>
                                <div><span>組数</span><strong data-report-count="groups"></strong></div>
                                <div><span>客数</span><strong data-report-count="customers"></strong></div>
                            </div>
                            <table class="daily-report__form-table daily-report__payment-table" aria-label="酒代・支払方法">
                                <tbody>
                                    <tr><th>酒代</th><td data-report-total="drink"></td></tr>
                                    <tr><th>支払方法</th><th>金額</th></tr>
                                </tbody>
                                <tbody data-report-payments></tbody>
                            </table>
                        </div>
                    </div>

                    <section class="daily-report__special-notes">
                        <h4>※特記事項</h4>
                        <p data-report-memo>なし</p>
                    </section>

                    <section class="daily-report__sheet-section daily-report__staff-section">
                        <div class="daily-report__staff-grid">
                            <section>
                                <h4 class="daily-report__block-title">社員勤怠</h4>
                                <table class="daily-report__form-table daily-report__staff-table">
                                    <thead><tr><th>名前</th><th>出勤</th><th>退勤</th></tr></thead>
                                    <tbody data-report-staffs="employee" data-min-rows="4"></tbody>
                                </table>
                            </section>
                            <section>
                                <h4 class="daily-report__block-title">バイト勤怠</h4>
                                <table class="daily-report__form-table daily-report__staff-table">
                                    <thead><tr><th>名前</th><th>出勤</th><th>退勤</th></tr></thead>
                                    <tbody data-report-staffs="part_time" data-min-rows="4"></tbody>
                                </table>
                            </section>
                        </div>
                    </section>

                    <section class="daily-report__sheet-section daily-report__cast-section">
                        <h4 class="daily-report__block-title">キャスト</h4>
                        <table class="daily-report__form-table daily-report__cast-table">
                            <thead>
                                <tr>
                                    <th>名前</th><th>出勤</th><th>退勤</th><th>ドリンクバック</th>
                                    <th>担当バック</th><th>売上</th>
                                    <th>前渡金</th><th>送り利用</th>
                                </tr>
                            </thead>
                            <tbody data-report-casts data-min-rows="18"></tbody>
                        </table>
                    </section>
                    </div>
                </article>

                <article class="daily-report__page daily-report__page--visits" aria-label="2ページ目 リスト">
                    <div class="daily-report__page-content" data-report-page-content>
                    <header class="daily-report__sheet-header">
                        <div class="daily-report__store-name" data-report-department>店舗</div>
                        <h3>③リスト</h3>
                        <div class="daily-report__sheet-date" data-report-sheet-date></div>
                        <span class="daily-report__page-number" aria-hidden="true">2 / 3</span>
                    </header>
                    <table class="daily-report__form-table daily-report__visit-table">
                        <thead>
                            <tr>
                                <th>No</th><th>入店</th><th>卓</th><th>客</th>
                                <th>お客様</th><th>担当キャスト</th><th>会計</th><th>備考</th>
                            </tr>
                        </thead>
                        <tbody data-report-visits data-min-rows="26"></tbody>
                    </table>
                    </div>
                </article>

                <article class="daily-report__page daily-report__page--expenses" aria-label="3ページ目 支出内訳">
                    <div class="daily-report__page-content" data-report-page-content>
                    <header class="daily-report__sheet-header">
                        <div class="daily-report__store-name" data-report-department>店舗</div>
                        <h3>②支出内訳</h3>
                        <div class="daily-report__sheet-date" data-report-sheet-date></div>
                        <span class="daily-report__page-number" aria-hidden="true">3 / 3</span>
                    </header>
                    <section class="daily-report__sheet-section">
                        <h4 class="daily-report__block-title">支出内訳（勘定科目別）</h4>
                        <table class="daily-report__form-table daily-report__expense-table">
                            <thead><tr><th>勘定科目</th><th>金額</th></tr></thead>
                            <tbody data-report-expenses data-min-rows="24"></tbody>
                        </table>
                    </section>
                    </div>
                    <footer class="daily-report__footer">
                        <span data-report-captured></span>
                        <span>売上は確定会計のみ。現金残高 = 現金売上 − 領収書支出（酒代納品は別表示）</span>
                    </footer>
                </article>
            </div>
        </div>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/features/daily-report.js" asp-append-version="true"></script>
    <script>
        (() => {
            const root = document.querySelector('[data-closing-panels]');
            if (!root) {
                return;
            }

            const stateClasses = ['is-ready', 'needs-action', 'has-warning', 'is-preparing'];
            const refreshIntervalMs = 30000;
            const initialBusinessDayId = root.dataset.currentBusinessDayId || '';
            const state = {
                hasBusinessDay: root.dataset.hasBusinessDay === 'true',
                businessDayChanged: false,
                receiptsEnabled: root.dataset.receiptsEnabled === 'true',
                shellLoaded: false,
                shellLoadFailed: false,
                openSlipLoaded: false,
                openSlipLoadFailed: false,
                drinkLoaded: false,
                drinkLoadFailed: false,
                attendanceLoaded: false,
                attendanceLoadFailed: false,
                castLoaded: false,
                castLoadFailed: false,
                champagneLoaded: false,
                champagneLoadFailed: false,
                openSlipCount: 0,
                drink: { isEntered: false, amount: 0 },
                attendance: { attendanceCount: 0, missingClockOutCount: 0 },
                cast: { isCompleted: false, requiredSlipCount: 0, completedSlipCount: 0, missingSlipCount: 0 },
                champagne: { isCompleted: false, requiredCastCount: 0, completedCastCount: 0, missingCastCount: 0, totalBackAmount: 0 },
                receipts: { pendingReceiptCount: 0 },
                checkedAt: null
            };
            let refreshInFlight = false;

            const toYen = window.MoneyText.yen;

            const setStateClass = (element, nextClass) => {
                if (!element) {
                    return;
                }

                element.classList.remove(...stateClasses);
                element.classList.add(nextClass);
            };

            const setPanel = (name, nextClass, badgeText, message, actionText = null) => {
                const panel = root.querySelector(`[data-closing-panel="${name}"]`);
                if (!panel) {
                    return;
                }

                setStateClass(panel, nextClass);
                const badge = panel.querySelector('[data-closing-badge]');
                setStateClass(badge, nextClass);
                if (badge) {
                    badge.textContent = badgeText;
                }

                const messageElement = panel.querySelector('[data-closing-message]');
                if (messageElement) {
                    messageElement.textContent = message;
                }

                const action = panel.querySelector('[data-closing-action]');
                if (action && actionText) {
                    action.textContent = actionText;
                }
            };

            const setPanelError = (name) => {
                setPanel(name, 'has-warning', '未取得', '状態を取得できませんでした。時間をおいて再表示してください。');
            };

            const captureBusinessDay = (result) => {
                if (!result || typeof result.hasBusinessDay !== 'boolean') {
                    return true;
                }

                if (!result.hasBusinessDay) {
                    state.hasBusinessDay = false;
                    return true;
                }

                const businessDayId = result.businessDayId === null || result.businessDayId === undefined
                    ? ''
                    : String(result.businessDayId);
                if (initialBusinessDayId && businessDayId && businessDayId !== initialBusinessDayId) {
                    state.businessDayChanged = true;
                    return false;
                }

                state.hasBusinessDay = true;
                return true;
            };

            const updateFinalPanel = () => {
                const finalPanel = document.querySelector('[data-closing-final]');
                if (!finalPanel) {
                    return;
                }

                const submit = finalPanel.querySelector('[data-closing-close-submit]');
                const override = finalPanel.querySelector('[data-closing-override]');
                const status = finalPanel.querySelector('[data-closing-final-status]');
                const setFinal = (nextClass, disabled, buttonText, statusText) => {
                    setStateClass(finalPanel, nextClass);
                    if (submit) {
                        submit.disabled = disabled;
                        submit.textContent = buttonText;
                    }
                    const statusState = nextClass === 'is-ready'
                        ? 'saved'
                        : nextClass === 'has-warning'
                            ? 'dirty'
                            : 'saving';
                    window.TerminalSaveStatus.set(status, statusState, statusText);
                };

                if (state.businessDayChanged) {
                    setFinal('has-warning', true, '営業日を締める', '営業日情報が更新されています。画面を再読み込みしてください。');
                    return;
                }

                if (override?.checked && state.hasBusinessDay) {
                    setFinal('has-warning', false, '条件を無視して締める', '管理者モードで締め条件を無視します。');
                    return;
                }

                const hasLoadFailure = state.shellLoadFailed ||
                    state.openSlipLoadFailed ||
                    state.drinkLoadFailed ||
                    state.attendanceLoadFailed ||
                    state.castLoadFailed ||
                    state.champagneLoadFailed;
                if (hasLoadFailure) {
                    setFinal('has-warning', true, '営業日を締める', '締め条件の一部を取得できませんでした。各手順を確認して、時間をおいて再表示してください。');
                    return;
                }

                if (!state.hasBusinessDay) {
                    setFinal('is-preparing', true, '営業日を締める', '営業中の営業日がありません。');
                    return;
                }

                const loaded = state.shellLoaded &&
                    state.openSlipLoaded &&
                    state.drinkLoaded &&
                    state.attendanceLoaded &&
                    state.castLoaded &&
                    state.champagneLoaded;

                if (!loaded) {
                    setFinal('is-preparing', true, '確認中', '締め条件を確認しています。');
                    return;
                }

                const canClose = state.openSlipCount === 0 &&
                    state.drink.isEntered &&
                    state.attendance.attendanceCount > 0 &&
                    state.attendance.missingClockOutCount === 0 &&
                    state.cast.isCompleted &&
                    state.champagne.isCompleted;
                const canSubmit = canClose;
                const checkedTime = state.checkedAt
                    ? new Intl.DateTimeFormat('ja-JP', { hour: '2-digit', minute: '2-digit', second: '2-digit' })
                        .format(new Date(state.checkedAt))
                    : null;
                const checkedSuffix = checkedTime ? ` 最終確認 ${checkedTime}` : '';
                setFinal(
                    canSubmit ? 'is-ready' : 'has-warning',
                    !canSubmit,
                    '営業日を締める',
                    canSubmit
                        ? `営業日を締められます。${checkedSuffix}`
                        : `締め条件が未完了です。${checkedSuffix}`
                );
            };

            const loadJson = async (url) => {
                const response = await fetch(url, {
                    headers: {
                        'Accept': 'application/json'
                    }
                });
                if (!response.ok) {
                    throw new Error('Closing panel load failed.');
                }

                return response.json();
            };

            const setAllPanelErrors = () => {
                ['openSlip', 'drinkDelivery', 'attendance', 'castSalesAdjustment', 'champagneBack'].forEach(setPanelError);
            };

            const setAllPanelsBusinessDayChanged = () => {
                ['openSlip', 'drinkDelivery', 'attendance', 'castSalesAdjustment', 'champagneBack', 'receipts'].forEach((name) => {
                    setPanel(name, 'has-warning', '要再表示', '営業日情報が更新されています。画面を再読み込みしてください。');
                });
            };

            const loadBusinessDayShell = async () => {
                try {
                    const result = await loadJson(root.dataset.businessDayShellUrl);
                    state.shellLoadFailed = false;
                    state.shellLoaded = true;
                    const canLoadPanels = captureBusinessDay(result);
                    if (!canLoadPanels) {
                        setAllPanelsBusinessDayChanged();
                    }

                    return canLoadPanels;
                } catch {
                    state.shellLoadFailed = true;
                    state.shellLoaded = false;
                    setAllPanelErrors();
                    return false;
                } finally {
                    updateFinalPanel();
                }
            };

            const loadOpenSlipPanel = async () => {
                try {
                    const result = await loadJson(root.dataset.openSlipUrl);
                    if (!captureBusinessDay(result)) {
                        setPanel('openSlip', 'has-warning', '未取得', '営業日情報が更新されています。画面を再読み込みしてください。');
                        return;
                    }

                    state.openSlipCount = Number(result.openSlipCount) || 0;
                    state.openSlipLoaded = true;
                    state.openSlipLoadFailed = false;

                    if (!result.hasBusinessDay) {
                        setPanel('openSlip', 'is-preparing', '未開始', '営業中の営業日がありません。', '営業中を開く');
                    } else if (state.openSlipCount > 0) {
                        setPanel('openSlip', 'has-warning', '会計待ち', `${state.openSlipCount}件の伝票が未会計です。`, '営業中を開く');
                    } else {
                        setPanel('openSlip', 'is-ready', '会計済', '未会計伝票はありません。', '営業中を開く');
                    }
                } catch {
                    state.openSlipLoaded = false;
                    state.openSlipLoadFailed = true;
                    setPanelError('openSlip');
                } finally {
                    updateFinalPanel();
                }
            };

            const loadDrinkDeliveryPanel = async () => {
                try {
                    const result = await loadJson(root.dataset.drinkDeliveryUrl);
                    if (!captureBusinessDay(result)) {
                        setPanel('drinkDelivery', 'has-warning', '要入力', '営業日情報が更新されています。画面を再読み込みしてください。');
                        return;
                    }

                    state.drink = {
                        isEntered: Boolean(result.isEntered),
                        amount: Number(result.amount) || 0
                    };
                    state.drinkLoaded = true;
                    state.drinkLoadFailed = false;

                    if (!result.hasBusinessDay) {
                        setPanel('drinkDelivery', 'has-warning', '要入力', '酒代保存時に営業日を自動作成できます。', '入力');
                    } else if (state.drink.isEntered) {
                        setPanel('drinkDelivery', 'is-ready', '入力済', `営業日ごとの納品額 ${toYen(state.drink.amount)}`);
                    } else {
                        setPanel('drinkDelivery', 'has-warning', '要入力', '納品額が未入力です。', '入力');
                    }
                } catch {
                    state.drinkLoaded = false;
                    state.drinkLoadFailed = true;
                    setPanelError('drinkDelivery');
                } finally {
                    updateFinalPanel();
                }
            };

            const loadAttendancePanel = async () => {
                try {
                    const result = await loadJson(root.dataset.attendanceUrl);
                    if (!captureBusinessDay(result)) {
                        setPanel('attendance', 'has-warning', '要入力', '営業日情報が更新されています。画面を再読み込みしてください。');
                        return;
                    }

                    state.attendance = {
                        attendanceCount: Number(result.attendanceCount) || 0,
                        missingClockOutCount: Number(result.missingClockOutCount) || 0
                    };
                    state.attendanceLoaded = true;
                    state.attendanceLoadFailed = false;

                    if (!result.hasBusinessDay) {
                        setPanel('attendance', 'has-warning', '要入力', '勤怠保存時に営業日を自動作成できます。', '入力');
                    } else if (state.attendance.missingClockOutCount > 0) {
                        setPanel('attendance', 'has-warning', '要入力', `${state.attendance.missingClockOutCount}名の退勤時刻が未入力です。`);
                    } else if (state.attendance.attendanceCount > 0) {
                        setPanel('attendance', 'is-ready', '確認済', `${state.attendance.attendanceCount}名の勤怠を入力済みです。`);
                    } else {
                        setPanel('attendance', 'has-warning', '要入力', '出勤者が登録されていません。', '入力');
                    }
                } catch {
                    state.attendanceLoaded = false;
                    state.attendanceLoadFailed = true;
                    setPanelError('attendance');
                } finally {
                    updateFinalPanel();
                }
            };

            const loadCastSalesAdjustmentPanel = async () => {
                try {
                    const result = await loadJson(root.dataset.castSalesAdjustmentUrl);
                    if (!captureBusinessDay(result)) {
                        setPanel('castSalesAdjustment', 'has-warning', '要入力', '営業日情報が更新されています。画面を再読み込みしてください。');
                        return;
                    }

                    state.cast = {
                        isCompleted: Boolean(result.isCompleted),
                        requiredSlipCount: Number(result.requiredSlipCount) || 0,
                        completedSlipCount: Number(result.completedSlipCount) || 0,
                        missingSlipCount: Number(result.missingSlipCount) || 0
                    };
                    state.castLoaded = true;
                    state.castLoadFailed = false;

                    if (!result.hasBusinessDay) {
                        setPanel('castSalesAdjustment', 'has-warning', '要入力', '会計済み伝票ができたら、指名キャストへの売上額を調整します。');
                    } else if (state.cast.requiredSlipCount === 0) {
                        setPanel('castSalesAdjustment', 'is-ready', '調整済', '調整が必要な会計済み伝票はありません。');
                    } else if (state.cast.isCompleted) {
                        setPanel('castSalesAdjustment', 'is-ready', '調整済', `${state.cast.completedSlipCount}件の伝票を調整済みです。`);
                    } else {
                        setPanel('castSalesAdjustment', 'has-warning', '要入力', `${state.cast.missingSlipCount}件の伝票で売上額調整が未完了です。`);
                    }
                } catch {
                    state.castLoaded = false;
                    state.castLoadFailed = true;
                    setPanelError('castSalesAdjustment');
                } finally {
                    updateFinalPanel();
                }
            };

            const loadReceiptsPanel = async () => {
                if (!state.receiptsEnabled || !root.dataset.receiptsUrl) {
                    updateFinalPanel();
                    return;
                }

                try {
                    const result = await loadJson(root.dataset.receiptsUrl);
                    state.receipts = {
                        pendingReceiptCount: Number(result.pendingReceiptCount) || 0
                    };
                    if (state.receipts.pendingReceiptCount > 0) {
                        setPanel('receipts', 'needs-action', '任意', `未入力領収書が ${state.receipts.pendingReceiptCount} 件あります。締め条件の対象外です。`);
                    } else {
                        setPanel('receipts', 'is-ready', '入力済', '未入力領収書はありません。');
                    }
                } catch {
                    setPanelError('receipts');
                } finally {
                    updateFinalPanel();
                }
            };

            const loadReadiness = async () => {
                try {
                    const result = await loadJson(root.dataset.readinessUrl);
                    state.shellLoaded = true;
                    state.shellLoadFailed = false;
                    if (!captureBusinessDay(result)) {
                        setAllPanelsBusinessDayChanged();
                        return;
                    }

                    state.openSlipCount = Number(result.openSlipCount) || 0;
                    state.drink = {
                        isEntered: Boolean(result.isDrinkDeliveryAmountEntered),
                        amount: Number(result.drinkDeliveryAmount) || 0
                    };
                    state.attendance = {
                        attendanceCount: Number(result.attendanceCount) || 0,
                        missingClockOutCount: Number(result.missingClockOutCount) || 0
                    };
                    state.cast = {
                        isCompleted: (Number(result.castSalesMissingSlipCount) || 0) === 0,
                        requiredSlipCount: Number(result.castSalesRequiredSlipCount) || 0,
                        completedSlipCount: Number(result.castSalesCompletedSlipCount) || 0,
                        missingSlipCount: Number(result.castSalesMissingSlipCount) || 0
                    };
                    state.champagne = {
                        isCompleted: (Number(result.champagneBackMissingCastCount) || 0) === 0,
                        requiredCastCount: Number(result.champagneBackRequiredCastCount) || 0,
                        completedCastCount: Number(result.champagneBackCompletedCastCount) || 0,
                        missingCastCount: Number(result.champagneBackMissingCastCount) || 0,
                        totalBackAmount: Number(result.champagneBackTotalAmount) || 0
                    };
                    state.openSlipLoaded = true;
                    state.drinkLoaded = true;
                    state.attendanceLoaded = true;
                    state.castLoaded = true;
                    state.champagneLoaded = true;
                    state.openSlipLoadFailed = false;
                    state.drinkLoadFailed = false;
                    state.attendanceLoadFailed = false;
                    state.castLoadFailed = false;
                    state.champagneLoadFailed = false;

                    if (!result.hasBusinessDay) {
                        setPanel('openSlip', 'is-preparing', '未開始', '営業中の営業日がありません。', '営業中を開く');
                        setPanel('drinkDelivery', 'has-warning', '要入力', '酒代保存時に営業日を自動作成できます。', '入力');
                        setPanel('attendance', 'has-warning', '要入力', '勤怠保存時に営業日を自動作成できます。', '入力');
                        setPanel('castSalesAdjustment', 'has-warning', '要入力', '会計済み伝票ができたら、指名キャストへの売上額を調整します。');
                        setPanel('champagneBack', 'has-warning', '要入力', '勤怠保存後に出勤キャストごとの追加バックを入力します。');
                        return;
                    }

                    if (state.openSlipCount > 0) {
                        setPanel('openSlip', 'has-warning', '会計待ち', `${state.openSlipCount}件の伝票が未会計です。`, '営業中を開く');
                    } else {
                        setPanel('openSlip', 'is-ready', '会計済', '未会計伝票はありません。', '営業中を開く');
                    }

                    if (state.drink.isEntered) {
                        setPanel('drinkDelivery', 'is-ready', '入力済', `営業日ごとの納品額 ${toYen(state.drink.amount)}`);
                    } else {
                        setPanel('drinkDelivery', 'has-warning', '要入力', '納品額が未入力です。', '入力');
                    }

                    if (state.attendance.missingClockOutCount > 0) {
                        setPanel('attendance', 'has-warning', '要入力', `${state.attendance.missingClockOutCount}名の退勤時刻が未入力です。`);
                    } else if (state.attendance.attendanceCount > 0) {
                        setPanel('attendance', 'is-ready', '確認済', `${state.attendance.attendanceCount}名の勤怠を入力済みです。`);
                    } else {
                        setPanel('attendance', 'has-warning', '要入力', '出勤者が登録されていません。', '入力');
                    }

                    if (state.cast.requiredSlipCount === 0) {
                        setPanel('castSalesAdjustment', 'is-ready', '調整済', '調整が必要な会計済み伝票はありません。');
                    } else if (state.cast.isCompleted) {
                        setPanel('castSalesAdjustment', 'is-ready', '調整済', `${state.cast.completedSlipCount}件の伝票を調整済みです。`);
                    } else {
                        setPanel('castSalesAdjustment', 'has-warning', '要入力', `${state.cast.missingSlipCount}件の伝票で売上額調整が未完了です。`);
                    }

                    if (state.champagne.requiredCastCount === 0) {
                        if (state.attendance.attendanceCount > 0) {
                            setPanel('champagneBack', 'is-ready', '入力済', '追加バック対象の出勤キャストはいません。');
                        } else {
                            setPanel('champagneBack', 'has-warning', '要入力', '出勤キャストを登録してから追加バックを入力します。');
                        }
                    } else if (state.champagne.isCompleted) {
                        setPanel('champagneBack', 'is-ready', '入力済', `${state.champagne.completedCastCount}名分の追加バックを保存済みです。合計 ${toYen(state.champagne.totalBackAmount)}`);
                    } else {
                        setPanel('champagneBack', 'has-warning', '要入力', `${state.champagne.missingCastCount}名分の追加バックが未入力です。`);
                    }

                } catch {
                    state.shellLoaded = false;
                    state.shellLoadFailed = true;
                    state.openSlipLoaded = false;
                    state.drinkLoaded = false;
                    state.attendanceLoaded = false;
                    state.castLoaded = false;
                    state.champagneLoaded = false;
                    state.champagneLoadFailed = true;
                    setAllPanelErrors();
                } finally {
                    updateFinalPanel();
                }
            };

            const loadPanels = async () => {
                if (refreshInFlight) {
                    return;
                }

                refreshInFlight = true;
                try {
                    await Promise.all([
                        loadReadiness(),
                        loadReceiptsPanel()
                    ]);
                } finally {
                    refreshInFlight = false;
                }
            };

            window.addEventListener('focus', () => {
                if (document.visibilityState === 'visible') {
                    void loadPanels();
                }
            });
            document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'visible') {
                    void loadPanels();
                }
            });
            window.setInterval(() => {
                if (document.visibilityState === 'visible') {
                    void loadPanels();
                }
            }, refreshIntervalMs);
            document.querySelector('[data-closing-retry]')?.addEventListener('click', () => {
                void loadPanels();
            });
            document.querySelector('[data-closing-override]')?.addEventListener('change', updateFinalPanel);
            document.querySelector('[data-closing-final]')?.addEventListener('submit', (event) => {
                const override = event.currentTarget.querySelector('[data-closing-override]');
                if (override?.checked && !window.confirm('締め条件を無視して営業日を締めます。未完了の手順が残っていても続行しますか？')) {
                    event.preventDefault();
                }
            });

            updateFinalPanel();
            void loadPanels();
        })();
    </script>
}
