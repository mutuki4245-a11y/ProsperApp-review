@page
@model ClosingModel
@{
    ViewData["Title"] = "締め作業";
    ViewData["HasCurrentBusinessDay"] = false;
}

<section class="store-home terminal-page terminal-page--closing">
    <div class="page-section-heading">
        <h1>締め作業</h1>
    </div>

    <div class="closing-list"
         data-closing-panels
         data-dashboard-url="@Url.Page("/Closing/Index", "Dashboard")"
         data-department-id="@Model.DepartmentId"
         data-receipts-enabled="@Model.ReceiptsEnabled.ToString().ToLowerInvariant()">
        <a class="closing-panel is-preparing" asp-page="/Index" data-closing-panel="openSlip">
            <span class="closing-panel__body">
                <strong class="closing-panel__title"><span class="closing-panel__step" aria-hidden="true">1</span><span>会計確認</span></strong>
                <small data-closing-message>状態を確認しています。</small>
            </span>
            <span class="closing-panel__badge is-preparing" data-closing-badge>確認中</span>
            <span class="closing-panel__action" data-closing-action>営業中を開く</span>
        </a>

        <button class="closing-panel is-preparing" type="button" data-closing-panel="drinkDelivery" data-bs-toggle="modal" data-bs-target="#drinkDeliveryEditorModal">
            <span class="closing-panel__body">
                <strong class="closing-panel__title"><span class="closing-panel__step" aria-hidden="true">2</span><span>酒代入力</span></strong>
                <small data-closing-message>状態を確認しています。</small>
            </span>
            <span class="closing-panel__badge is-preparing" data-closing-badge>確認中</span>
            <span class="closing-panel__action" data-closing-action>開く</span>
        </button>

        <button class="closing-panel is-preparing" type="button" data-closing-panel="attendance" data-bs-toggle="modal" data-bs-target="#attendanceEditorModal">
            <span class="closing-panel__body">
                <strong class="closing-panel__title"><span class="closing-panel__step" aria-hidden="true">3</span><span>勤怠確認</span></strong>
                <small data-closing-message>状態を確認しています。</small>
            </span>
            <span class="closing-panel__badge is-preparing" data-closing-badge>確認中</span>
            <span class="closing-panel__action" data-closing-action>確認/修正</span>
        </button>

        <button class="closing-panel is-preparing" type="button" data-closing-panel="castSalesAdjustment" data-bs-toggle="modal" data-bs-target="#castSalesAdjustmentShellModal">
            <span class="closing-panel__body">
                <strong class="closing-panel__title"><span class="closing-panel__step" aria-hidden="true">4</span><span>キャスト売上額調整</span></strong>
                <small data-closing-message>状態を確認しています。</small>
            </span>
            <span class="closing-panel__badge is-preparing" data-closing-badge>確認中</span>
            <span class="closing-panel__action" data-closing-action>開く</span>
        </button>

        <button class="closing-panel is-preparing" type="button" data-closing-panel="drinkBack" data-bs-toggle="modal" data-bs-target="#drinkBackEditorModal">
            <span class="closing-panel__body">
                <strong class="closing-panel__title"><span class="closing-panel__step" aria-hidden="true">5</span><span>ドリンクバック調整</span></strong>
                <small data-closing-message>状態を確認しています。</small>
            </span>
            <span class="closing-panel__badge is-preparing" data-closing-badge>確認中</span>
            <span class="closing-panel__action" data-closing-action>開く</span>
        </button>

        @if (Model.ReceiptsEnabled)
        {
            <a class="closing-panel is-preparing" asp-page="/Closing/Receipts" data-closing-panel="receipts">
                <span class="closing-panel__body">
                    <strong class="closing-panel__title"><span class="closing-panel__step" aria-hidden="true">6</span><span>領収書入力（任意）</span></strong>
                    <small data-closing-message>状態を確認しています。</small>
                </span>
                <span class="closing-panel__badge is-preparing" data-closing-badge>確認中</span>
                <span class="closing-panel__action" data-closing-action>入力</span>
            </a>
        }
    </div>

    <section class="closing-final" aria-label="営業日締め">
        <form method="post" asp-page-handler="CloseV2" class="closing-panel closing-panel--form closing-final-panel closing-final-panel--compact is-preparing" data-closing-final>
            <input name="CloseOperationId" type="hidden" value="@(Guid.NewGuid().ToString("D"))" />
            <input name="BusinessDayId" type="hidden" />
            <input name="BusinessDayRevision" type="hidden" />
            <div class="closing-panel__form">
                <div>
                    <label for="ClosingMemo" class="form-label"><span class="closing-panel__step" aria-hidden="true">@(Model.ReceiptsEnabled ? "7" : "6")</span><span>締めメモ・営業日締め</span></label>
                    <input id="ClosingMemo" name="ClosingMemo" class="form-control form-control-lg" maxlength="500" placeholder="営業日を確認しています" disabled data-closing-memo />
                </div>
                @if (Model.IsAdminMode)
                {
                    <label class="form-check closing-final__override">
                        <input name="IgnoreClosingRequirements" class="form-check-input" type="checkbox" data-closing-override />
                        <span class="form-check-label">締め条件を無視</span>
                    </label>
                }
            </div>
            <button class="btn btn-danger closing-panel__submit" type="submit" data-closing-close-submit disabled>確認中</button>
            <button class="btn btn-outline-secondary closing-final__retry" type="button" data-closing-retry>再取得</button>
            <output class="terminal-save-status closing-final__status" data-closing-final-status data-save-state="saving" aria-live="polite">締め条件を確認しています。</output>
        </form>
    </section>

    @if (Model.AttendanceModal is not null)
    {
        <partial name="_AttendanceEditorModal" model="Model.AttendanceModal" />
    }

    <div class="modal fade" id="drinkDeliveryEditorModal" tabindex="-1" aria-labelledby="drinkDeliveryEditorModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <section class="modal-body terminal-page--closing-entry"
                         data-drink-delivery-editor
                         data-department-id="@Model.DepartmentId"
                         data-current-business-date="@Model.CurrentBusinessDate.ToString("yyyy-MM-dd")"
                         data-editor-url="@Url.Page("/Closing/Index", "DrinkDeliveryEditor")"
                         data-save-url="@Url.Page("/Closing/Index", "DrinkDeliverySaveV2")">
                    <div class="modal-header px-0 pt-0">
                        <div>
                            <p class="store-home__eyebrow mb-1">DRINK COST</p>
                            <h2 class="modal-title fs-4" id="drinkDeliveryEditorModalLabel">酒代入力</h2>
                            <p class="text-muted small mb-0" data-drink-business-date>営業日を確認しています</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                    </div>

                    <div class="alert alert-danger" role="alert" data-drink-error hidden></div>
                    <div class="alert alert-success" role="status" data-drink-success hidden></div>
                    <div class="text-muted small mb-2" data-drink-updated>状態を復元しています。</div>
                    <div class="alert alert-info" data-drink-guidance>
                        酒代がない場合も 0 円で保存してください。
                    </div>

                    <form method="post" class="closing-entry-panel" data-drink-form>
                        @Html.AntiForgeryToken()
                        <div class="closing-entry-panel__body">
                            <label for="drinkDeliveryAmount" class="form-label">納品額</label>
                            <div class="closing-amount-input">
                                <input id="drinkDeliveryAmount"
                                       class="form-control form-control-lg"
                                       type="text"
                                       inputmode="numeric"
                                       autocomplete="off"
                                       disabled
                                       data-drink-amount />
                                <span>円</span>
                            </div>
                        </div>
                        <div class="closing-entry-panel__actions">
                            <button class="btn btn-primary btn-lg" type="submit" disabled data-drink-submit>保存</button>
                        </div>
                        <output class="terminal-save-status" data-drink-status data-save-state="idle" aria-live="polite">状態を復元しています。</output>
                    </form>
                </section>
            </div>
        </div>
    </div>

    <div class="modal fade" id="castSalesAdjustmentShellModal" tabindex="-1" aria-labelledby="castSalesAdjustmentShellModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen-lg-down modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <section class="modal-body cast-sales-editor"
                         data-cast-sales-editor
                         data-department-id="@Model.DepartmentId"
                         data-overview-url="@Url.Page("/Closing/Index", "CastSalesOverview")"
                         data-save-url="@Url.Page("/Closing/Index", "CastSalesSaveV2")"
                         data-confirm-url="@Url.Page("/Closing/Index", "CastSalesConfirmAllV2")">
                    <div class="modal-header px-0 pt-0">
                        <div>
                            <p class="store-home__eyebrow mb-1">CAST SALES</p>
                            <h2 class="modal-title fs-4" id="castSalesAdjustmentShellModalLabel">キャスト売上額調整</h2>
                            <p class="text-muted small mb-0" data-cast-sales-summary>現在の営業日を確認しています</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                    </div>

                    <form class="d-none" aria-hidden="true" data-cast-sales-token-form>
                        @Html.AntiForgeryToken()
                    </form>

                    <div class="alert alert-danger" role="alert" data-cast-sales-error hidden>
                        <span data-cast-sales-error-message></span>
                        <button class="btn btn-outline-danger btn-sm ms-2" type="button" data-cast-sales-retry>再試行</button>
                    </div>
                    <div class="alert alert-success" role="status" data-cast-sales-success hidden></div>
                    <div class="text-muted small mb-2" data-cast-sales-updated>状態を取得しています。</div>

                    <div class="cast-sales-editor__loading" data-cast-sales-loading aria-live="polite">
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>調整対象を取得しています</span>
                    </div>

                    <div class="cast-sales-editor__empty" data-cast-sales-empty hidden>
                        <strong data-cast-sales-empty-title>調整対象はありません</strong>
                        <span data-cast-sales-empty-message>会計済みかつ指名キャストがいる伝票が対象です。</span>
                    </div>

                    <div class="cast-sales-editor__list" data-cast-sales-list aria-label="キャスト売上額調整対象伝票" hidden></div>

                    <div class="cast-sales-editor__actions" data-cast-sales-actions hidden>
                        <span data-cast-sales-missing></span>
                        <button class="btn btn-primary btn-lg" type="button" data-cast-sales-confirm>全件確認</button>
                    </div>

                    <output class="terminal-save-status cast-sales-editor__status"
                            data-cast-sales-status
                            data-save-state="idle"
                            aria-live="polite">状態を取得しています。</output>

                    <div class="modal fade" id="castSalesAdjustmentModal" tabindex="-1" aria-labelledby="castSalesAdjustmentModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg modal-dialog-scrollable">
                            <div class="modal-content">
                                <form data-cast-sales-form>
                                    <div class="modal-header">
                                        <div>
                                            <p class="store-home__eyebrow mb-1" data-cast-sales-base></p>
                                            <h2 class="modal-title fs-4" id="castSalesAdjustmentModalLabel">売上額調整</h2>
                                        </div>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                                    </div>
                                    <div class="modal-body cast-sales-editor__modal-body">
                                        <p class="text-muted small mb-3" data-cast-sales-guidance></p>
                                        <div class="cast-sales-editor__cast-table">
                                            <div class="cast-sales-editor__cast-row cast-sales-editor__cast-row--header" aria-hidden="true">
                                                <span>指名キャスト</span>
                                                <span>区分</span>
                                                <span>売上額</span>
                                            </div>
                                            <div data-cast-sales-casts></div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">閉じる</button>
                                        <button type="submit" class="btn btn-primary" data-cast-sales-save>保存</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <div class="modal fade" id="drinkBackEditorModal" tabindex="-1" aria-labelledby="drinkBackEditorModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen-lg-down modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <section class="modal-body terminal-page--closing-entry drink-back-editor"
                         data-drink-back-editor
                         data-department-id="@Model.DepartmentId"
                         data-current-business-date="@Model.CurrentBusinessDate.ToString("yyyy-MM-dd")"
                         data-editor-url="@Url.Page("/Closing/Index", "DrinkBackEditor")"
                         data-save-url="@Url.Page("/Closing/Index", "DrinkBackSave")">
                    <div class="modal-header px-0 pt-0">
                        <div>
                            <p class="store-home__eyebrow mb-1">DRINK BACK</p>
                            <h2 class="modal-title fs-4" id="drinkBackEditorModalLabel">ドリンクバック調整</h2>
                            <p class="text-muted small mb-0" data-drink-back-business-date>状態を復元しています。</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                    </div>

                    <div class="alert alert-danger" role="alert" data-drink-back-error hidden></div>
                    <div class="alert alert-success" role="status" data-drink-back-success hidden></div>
                    <div class="alert alert-info" role="status" data-drink-back-guidance>状態を復元しています。</div>

                    <form method="post" class="closing-entry-panel drink-back-editor__form" data-drink-back-form>
                        @Html.AntiForgeryToken()
                        <div class="closing-entry-panel__body">
                            <div class="drink-back-editor__summary">
                                <div>
                                    <h2>出勤キャスト</h2>
                                </div>
                                <div class="drink-back-editor__totals">
                                    <strong data-drink-back-total>合計 0円</strong>
                                </div>
                            </div>

                            <div class="drink-back-editor__rows" data-drink-back-required-rows></div>

                            <div class="drink-back-editor__optional-control">
                                <label class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" data-drink-back-show-optional />
                                    <span class="form-check-label">出勤していないキャストを表示</span>
                                </label>
                            </div>

                            <section class="drink-back-editor__optional" data-drink-back-optional-section hidden>
                                <h2>出勤外の任意調整</h2>
                                <div class="drink-back-editor__rows" data-drink-back-optional-rows></div>
                            </section>

                            <div class="terminal-save-status" data-drink-back-status data-save-state="idle">状態を復元しています。</div>
                            <div class="text-muted small" data-drink-back-updated></div>
                        </div>
                        <div class="closing-entry-panel__actions d-grid gap-2">
                            <button class="btn btn-primary btn-lg" type="submit" data-drink-back-submit disabled>保存</button>
                        </div>
                    </form>
                </section>
            </div>
        </div>
    </div>

    <section class="daily-report"
             aria-labelledby="dailyReportTitle"
             aria-busy="true"
             data-daily-report
             data-report-url="@Url.Page("/Closing/Index", "DailyReport", new { businessDayId = Model.ReportBusinessDayId })">
        <header class="daily-report__header">
            <div>
                <div class="daily-report__eyebrow">DAILY REPORT</div>
                <h2 id="dailyReportTitle">日報</h2>
                <p class="daily-report__subtitle" data-report-subtitle>日報を取得しています。</p>
            </div>
            <div class="daily-report__actions">
                <span class="badge text-bg-secondary" data-report-state>取得中</span>
                <button class="btn btn-outline-secondary btn-sm" type="button" data-report-refresh>再取得</button>
                <button class="btn btn-dark btn-sm" type="button" data-report-print disabled>印刷</button>
            </div>
        </header>

        <div class="alert alert-secondary daily-report__loading" role="status" data-report-status>
            清書した日報を作成しています。
        </div>
        <div class="daily-report__warnings" data-report-warnings hidden></div>

        <div class="daily-report__content" data-report-content hidden>
            <div class="daily-report__pages">
                <article class="daily-report__page daily-report__page--summary" aria-label="1ページ目 日計表">
                    <div class="daily-report__page-content" data-report-page-content>
                    <header class="daily-report__sheet-header">
                        <div class="daily-report__store-name" data-report-department>店舗</div>
                        <h3>①日計表</h3>
                        <div class="daily-report__sheet-date" data-report-sheet-date></div>
                        <span class="daily-report__page-number" aria-hidden="true">1 / 3</span>
                    </header>

                    <div class="daily-report__ledger-grid">
                        <table class="daily-report__form-table" aria-label="日計">
                            <tbody>
                                <tr><th>総売上</th><td data-report-total="sales"></td></tr>
                                <tr><th>現金</th><td data-report-total="cash"></td></tr>
                                <tr><th>支出</th><td data-report-total="expense"></td></tr>
                                <tr class="daily-report__summary-emphasis"><th>現金残高</th><td data-report-total="balance"></td></tr>
                            </tbody>
                        </table>
                        <div class="daily-report__summary-side">
                            <div class="daily-report__count-grid" aria-label="営業集計">
                                <div><span>出勤人数</span><strong data-report-count="attendance"></strong></div>
                                <div><span>組数</span><strong data-report-count="groups"></strong></div>
                                <div><span>客数</span><strong data-report-count="customers"></strong></div>
                            </div>
                            <table class="daily-report__form-table daily-report__payment-table" aria-label="酒代・支払方法">
                                <tbody>
                                    <tr><th>酒代</th><td data-report-total="drink"></td></tr>
                                    <tr><th>支払方法</th><th>金額</th></tr>
                                </tbody>
                                <tbody data-report-payments></tbody>
                            </table>
                        </div>
                    </div>

                    <section class="daily-report__special-notes">
                        <h4>※特記事項</h4>
                        <p data-report-memo>なし</p>
                    </section>

                    <section class="daily-report__sheet-section daily-report__staff-section">
                        <div class="daily-report__staff-grid">
                            <section>
                                <h4 class="daily-report__block-title">社員勤怠</h4>
                                <table class="daily-report__form-table daily-report__staff-table">
                                    <thead><tr><th>名前</th><th>出勤</th><th>退勤</th></tr></thead>
                                    <tbody data-report-staffs="employee" data-min-rows="4"></tbody>
                                </table>
                            </section>
                            <section>
                                <h4 class="daily-report__block-title">バイト勤怠</h4>
                                <table class="daily-report__form-table daily-report__staff-table">
                                    <thead><tr><th>名前</th><th>出勤</th><th>退勤</th></tr></thead>
                                    <tbody data-report-staffs="part_time" data-min-rows="4"></tbody>
                                </table>
                            </section>
                        </div>
                    </section>

                    <section class="daily-report__sheet-section daily-report__cast-section">
                        <h4 class="daily-report__block-title">キャスト</h4>
                        <table class="daily-report__form-table daily-report__cast-table">
                            <thead>
                                <tr>
                                    <th>名前</th><th>出勤</th><th>退勤</th><th>ドリンクバック</th>
                                    <th>担当バック</th><th>売上</th>
                                    <th>前渡金</th><th>送り利用</th>
                                </tr>
                            </thead>
                            <tbody data-report-casts data-min-rows="18"></tbody>
                        </table>
                    </section>
                    </div>
                </article>

                <article class="daily-report__page daily-report__page--visits" aria-label="2ページ目 リスト">
                    <div class="daily-report__page-content" data-report-page-content>
                    <header class="daily-report__sheet-header">
                        <div class="daily-report__store-name" data-report-department>店舗</div>
                        <h3>③リスト</h3>
                        <div class="daily-report__sheet-date" data-report-sheet-date></div>
                        <span class="daily-report__page-number" aria-hidden="true">2 / 3</span>
                    </header>
                    <table class="daily-report__form-table daily-report__visit-table">
                        <thead>
                            <tr>
                                <th>No</th><th>入店</th><th>卓</th><th>客</th>
                                <th>お客様</th><th>担当キャスト</th><th>会計</th><th>備考</th>
                            </tr>
                        </thead>
                        <tbody data-report-visits data-min-rows="31"></tbody>
                    </table>
                    </div>
                </article>

                <article class="daily-report__page daily-report__page--expenses" aria-label="3ページ目 支出内訳">
                    <div class="daily-report__page-content" data-report-page-content>
                    <header class="daily-report__sheet-header">
                        <div class="daily-report__store-name" data-report-department>店舗</div>
                        <h3>②支出内訳</h3>
                        <div class="daily-report__sheet-date" data-report-sheet-date></div>
                        <span class="daily-report__page-number" aria-hidden="true">3 / 3</span>
                    </header>
                    <section class="daily-report__sheet-section">
                        <h4 class="daily-report__block-title">支出内訳（勘定科目別）</h4>
                        <table class="daily-report__form-table daily-report__expense-table">
                            <thead><tr><th>勘定科目</th><th>摘要</th><th>金額</th></tr></thead>
                            <tbody data-report-expenses data-min-rows="29"></tbody>
                        </table>
                    </section>
                    </div>
                    <footer class="daily-report__footer">
                        <span data-report-captured></span>
                        <span>売上は確定会計のみ。現金残高 = 現金売上 − 当営業日に入力した領収書支出（酒代納品は別表示）</span>
                    </footer>
                </article>
            </div>
        </div>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.AttendanceModal?.State.LoadIssues.Count == 0 &&
        Model.AttendanceModal.State.Input.Entries.Count > 0)
    {
        <script src="~/js/features/attendance-editor.js" asp-append-version="true"></script>
    }
    <script src="~/js/features/daily-report.js" asp-append-version="true"></script>
    <script src="~/js/features/drink-delivery-editor.js" asp-append-version="true"></script>
    <script src="~/js/features/cast-sales-adjustment.js" asp-append-version="true"></script>
    <script src="~/js/features/drink-back-editor.js" asp-append-version="true"></script>
    <script src="~/js/features/closing-dashboard.js" asp-append-version="true"></script>
}
