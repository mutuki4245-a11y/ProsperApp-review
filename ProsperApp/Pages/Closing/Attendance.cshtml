@page
@model ClosingAttendanceModel
@{
    ViewData["Title"] = "勤怠入力";
    ViewData["HasCurrentBusinessDay"] = Model.CurrentBusinessDay is not null;
}

<section class="store-home">
    <div class="business-status-bar">
        <div>
            <strong>営業中 / 勤怠入力</strong>
            @if (Model.CurrentBusinessDay is null)
            {
                <span>営業日 @Model.CurrentBusinessDate.ToString("yyyy-MM-dd") / 保存時に自動作成</span>
            }
            else
            {
                <span>@Model.CurrentBusinessDay.BusinessDate.ToString("yyyy-MM-dd")</span>
            }
        </div>
        <div class="business-status-bar__actions">
            <a class="btn btn-outline-secondary" asp-page="/Index">営業中へ戻る</a>
            <a class="btn btn-outline-secondary" asp-page="/Closing/Index">締め作業へ</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (Model.Input.Entries.Count == 0)
    {
        <div class="alert alert-secondary">
            キャスト情報が未登録です。
            <a class="alert-link" asp-page="/Opening/Casts">キャスト情報へ</a>
        </div>
    }
    else
    {
        @if (Model.CurrentBusinessDay is null)
        {
            <div class="alert alert-info">
                保存すると営業日 @Model.CurrentBusinessDate.ToString("yyyy-MM-dd") を自動作成します。
            </div>
        }

        <form method="post" class="closing-attendance-form">
            <input asp-for="Input.BusinessDayId" type="hidden" />
            <div class="closing-entry-panel">
                <div class="closing-entry-panel__body">
                    <label class="form-label">勤怠入力</label>
                    <span class="text-muted">出勤者、出勤時刻、退勤時刻、送り利用を営業中に随時保存できます。退勤時刻が空のままでも保存できます。</span>
                </div>
                <div class="closing-entry-panel__actions">
                    <button class="btn btn-primary btn-lg" type="submit">勤怠を保存</button>
                </div>
            </div>

            <div class="closing-attendance-table">
                <div class="closing-attendance-table__row closing-attendance-table__row--header">
                    <span>出勤</span>
                    <span>出勤時刻</span>
                    <span>退勤時刻</span>
                    <span>送り</span>
                </div>
                @for (var i = 0; i < Model.Input.Entries.Count; i++)
                {
                    <div class="closing-attendance-table__row">
                        <input asp-for="Input.Entries[i].CastId" type="hidden" />
                        <input asp-for="Input.Entries[i].AttendanceId" type="hidden" />
                        <input asp-for="Input.Entries[i].DisplayName" type="hidden" />
                        <input asp-for="Input.Entries[i].DepartmentName" type="hidden" />
                        <input asp-for="Input.Entries[i].IsRegistered" type="hidden" />
                        <label class="closing-attendance-table__cast form-check">
                            <input class="form-check-input" asp-for="Input.Entries[i].IsSelected" />
                            <span class="form-check-label">
                                @Model.Input.Entries[i].DisplayName
                                @if (Model.Input.Entries[i].IsRegistered)
                                {
                                    <small>登録済み</small>
                                }
                            </span>
                        </label>
                        <label class="closing-attendance-table__field">
                            <span>出勤時刻</span>
                            <select class="form-select" asp-for="Input.Entries[i].ClockInTime">
                                <option value="">選択</option>
                                @foreach (var time in Model.TimeOptions)
                                {
                                    <option value="@time">@time</option>
                                }
                            </select>
                            <span asp-validation-for="Input.Entries[i].ClockInTime" class="text-danger"></span>
                        </label>
                        <label class="closing-attendance-table__field">
                            <span>退勤時刻</span>
                            <select class="form-select" asp-for="Input.Entries[i].ClockOutTime">
                                <option value="">未入力</option>
                                @foreach (var time in Model.TimeOptions)
                                {
                                    <option value="@time">@time</option>
                                }
                            </select>
                            <span asp-validation-for="Input.Entries[i].ClockOutTime" class="text-danger"></span>
                        </label>
                        <label class="closing-attendance-table__send form-check">
                            <input class="form-check-input" asp-for="Input.Entries[i].UsesSendService" />
                            <span class="form-check-label">利用</span>
                        </label>
                    </div>
                }
            </div>

            <div class="closing-entry-panel__actions closing-attendance-actions">
                <button class="btn btn-primary btn-lg" type="submit">勤怠を保存</button>
            </div>
        </form>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
