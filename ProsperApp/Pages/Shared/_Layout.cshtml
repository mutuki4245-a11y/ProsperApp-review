@inject IFeatureGate FeatureGate
@inject ILocalSettingsProvider LocalSettingsProvider
@{
    var localSettings = LocalSettingsProvider.GetCurrent();
    var isDarkTheme = localSettings.ThemeMode != LocalSettings.ThemeModeWhite;
    var bootstrapTheme = isDarkTheme ? "dark" : "light";
    var themeColor = isDarkTheme ? "#101318" : "#f8fafc";
    var appleStatusBarStyle = isDarkTheme ? "black-translucent" : "default";
    var currentPath = Context.Request.Path.Value ?? "/";
    var isOrdersPage = currentPath.StartsWith("/Orders", StringComparison.OrdinalIgnoreCase);
    var isManagementActive = currentPath.StartsWith("/Management", StringComparison.OrdinalIgnoreCase);
    var isSalesActive = currentPath == "/";
    var isClosingActive = currentPath.StartsWith("/Closing", StringComparison.OrdinalIgnoreCase);
    var isSalesHistoryActive = currentPath.StartsWith("/SalesHistory", StringComparison.OrdinalIgnoreCase);
    var isSettingsActive = currentPath.StartsWith("/Settings", StringComparison.OrdinalIgnoreCase);
    var bodyClass = isOrdersPage
        ? "order-terminal"
        : currentPath == "/" ? "sales-hub-page" : string.Empty;
}
<!DOCTYPE html>
<html lang="ja" data-bs-theme="@bootstrapTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="@themeColor" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="店舗アプリ" />
    <meta name="apple-mobile-web-app-status-bar-style" content="@appleStatusBarStyle" />
    <title>@ViewData["Title"] - 店舗用アプリ</title>
    <script type="importmap"></script>
    <link rel="manifest" href="~/site.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="~/icons/store-app-icon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/icons/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isDarkTheme)
    {
        <link rel="stylesheet" href="~/css/dark-theme.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/ProsperApp.styles.css" asp-append-version="true" />
</head>
<body class="@bodyClass">
    @if (!isOrdersPage)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow app-main-nav">
                <div class="container">
                    <a class="navbar-brand" asp-area="" asp-page="/Index">店舗用アプリ</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="ナビゲーション切り替え">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1 app-main-nav__tabs">
                            <li class="nav-item">
                                <a class="nav-link app-main-nav__link @(isSalesActive ? "is-active" : null)"
                                   asp-area=""
                                   asp-page="/Index"
                                   data-loading-lock="false"
                                   aria-current="@(isSalesActive ? "page" : null)">営業中</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-main-nav__link @(isClosingActive ? "is-active" : null)" asp-area="" asp-page="/Closing/Index">締め作業</a>
                            </li>
                            @if (FeatureGate.IsEnabled(FeatureNames.SalesHistory))
                            {
                                <li class="nav-item">
                                    <a class="nav-link app-main-nav__link @(isSalesHistoryActive ? "is-active" : null)"
                                       asp-area=""
                                       asp-page="/SalesHistory/Index"
                                       aria-current="@(isSalesHistoryActive ? "page" : null)">営業履歴</a>
                                </li>
                            }
                            @if (FeatureGate.IsEnabled(FeatureNames.Opening))
                            {
                                <li class="nav-item">
                                    <a class="nav-link app-main-nav__link @(isManagementActive ? "is-active" : null)" asp-area="" asp-page="/Management/Index">店舗設定</a>
                                </li>
                            }
                            @if (FeatureGate.IsEnabled(FeatureNames.Settings))
                            {
                                <li class="nav-item">
                                    <a class="nav-link app-main-nav__link @(isSettingsActive ? "is-active" : null)" asp-area="" asp-page="/Settings/Index">管理者設定</a>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                var storeName = localSettings.StoreName;
                                <li class="nav-item">
                                    <span class="navbar-text text-dark">@storeName</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="/logout">ログアウト</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Login">ログイン</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="container-fluid app-shell">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <div class="app-loading-overlay" id="appLoadingOverlay" role="status" aria-live="polite" aria-hidden="true">
        <div class="app-loading-overlay__panel">
            <div class="spinner-border text-primary" aria-hidden="true"></div>
            <strong>処理中です</strong>
        </div>
    </div>

    @if (!isOrdersPage)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - 店舗用アプリ
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const key = "ProsperApp.LocalSettings";
            const cookieValue = document.cookie
                .split("; ")
                .find((part) => part.startsWith(`${key}=`))
                ?.slice(key.length + 1);

            if (cookieValue) {
                try {
                    localStorage.setItem(key, decodeURIComponent(cookieValue));
                } catch {
                    // Keep the server cookie authoritative if browser storage is unavailable.
                }

                return;
            }

            const value = localStorage.getItem(key);
            if (!value) {
                return;
            }

            document.cookie = `${key}=${encodeURIComponent(value)}; path=/; max-age=31536000; samesite=lax`;
        })();
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/save-response.js" asp-append-version="true"></script>
    <script src="~/js/local-state.js" asp-append-version="true"></script>
    <script src="~/js/sync-store.js" asp-append-version="true"></script>
    @if (isManagementActive)
    {
        <script>
            window.ProsperManagementMasterConfig = {
                departmentId: @localSettings.StoreDepartmentId,
                snapshotUrl: '@Url.Page("/Management/Index", "MasterSnapshot")',
                mutationUrl: '@Url.Page("/Management/Index", "MasterMutation")'
            };
        </script>
        <script src="~/js/features/management-master.js" asp-append-version="true"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
