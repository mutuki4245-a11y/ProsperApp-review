@model ProsperApp.Features.DailyReports.DailyReportPartialViewModel

<section class="daily-report"
         aria-labelledby="@Model.TitleId"
         aria-busy="true"
         data-daily-report
         data-report-url="@Model.ReportUrl"
         data-report-auto-load="@Model.AutoLoad.ToString().ToLowerInvariant()">
    <header class="daily-report__header">
        <div>
            <div class="daily-report__eyebrow">DAILY REPORT</div>
            <h2 id="@Model.TitleId">日報</h2>
            <p class="daily-report__subtitle" data-report-subtitle>日報を取得しています。</p>
        </div>
        <div class="daily-report__actions">
            <span class="badge text-bg-secondary" data-report-state>取得中</span>
            <button class="btn btn-outline-secondary btn-sm" type="button" data-report-refresh>再取得</button>
            <button class="btn btn-dark btn-sm" type="button" data-report-print disabled>印刷</button>
        </div>
    </header>

    <div class="alert alert-secondary daily-report__loading" role="status" data-report-status>
        清書した日報を作成しています。
    </div>
    <div class="daily-report__warnings" data-report-warnings hidden></div>

    <div class="daily-report__content" data-report-content hidden>
        <div class="daily-report__pages">
            <article class="daily-report__page daily-report__page--summary" aria-label="1ページ目 日計表">
                <div class="daily-report__page-content" data-report-page-content>
                    <header class="daily-report__sheet-header">
                        <div class="daily-report__store-name" data-report-department>店舗</div>
                        <h3>①日計表</h3>
                        <div class="daily-report__sheet-date" data-report-sheet-date></div>
                        <span class="daily-report__page-number" aria-hidden="true">1 / 3</span>
                    </header>

                    <div class="daily-report__ledger-grid">
                        <table class="daily-report__form-table" aria-label="日計">
                            <tbody>
                                <tr><th>総売上</th><td data-report-total="sales"></td></tr>
                                <tr><th>現金</th><td data-report-total="cash"></td></tr>
                                <tr><th>支出</th><td data-report-total="expense"></td></tr>
                                <tr class="daily-report__summary-emphasis"><th>現金残高</th><td data-report-total="balance"></td></tr>
                            </tbody>
                        </table>
                        <div class="daily-report__summary-side">
                            <div class="daily-report__count-grid" aria-label="営業集計">
                                <div><span>出勤人数</span><strong data-report-count="attendance"></strong></div>
                                <div><span>組数</span><strong data-report-count="groups"></strong></div>
                                <div><span>客数</span><strong data-report-count="customers"></strong></div>
                            </div>
                            <table class="daily-report__form-table daily-report__payment-table" aria-label="酒代・支払方法">
                                <tbody>
                                    <tr><th>酒代</th><td data-report-total="drink"></td></tr>
                                    <tr><th>支払方法</th><th>金額</th></tr>
                                </tbody>
                                <tbody data-report-payments></tbody>
                            </table>
                        </div>
                    </div>

                    <section class="daily-report__special-notes">
                        <h4>※特記事項</h4>
                        <p data-report-memo>なし</p>
                    </section>

                    <section class="daily-report__sheet-section daily-report__staff-section">
                        <div class="daily-report__staff-grid">
                            <section>
                                <h4 class="daily-report__block-title">社員勤怠</h4>
                                <table class="daily-report__form-table daily-report__staff-table">
                                    <thead><tr><th>名前</th><th>出勤</th><th>退勤</th></tr></thead>
                                    <tbody data-report-staffs="employee" data-min-rows="4"></tbody>
                                </table>
                            </section>
                            <section>
                                <h4 class="daily-report__block-title">バイト勤怠</h4>
                                <table class="daily-report__form-table daily-report__staff-table">
                                    <thead><tr><th>名前</th><th>出勤</th><th>退勤</th></tr></thead>
                                    <tbody data-report-staffs="part_time" data-min-rows="4"></tbody>
                                </table>
                            </section>
                        </div>
                    </section>

                    <section class="daily-report__sheet-section daily-report__cast-section">
                        <h4 class="daily-report__block-title">キャスト</h4>
                        <table class="daily-report__form-table daily-report__cast-table">
                            <thead>
                                <tr>
                                    <th>名前</th><th>出勤</th><th>退勤</th><th>ドリンクバック</th>
                                    <th>担当バック</th><th>売上</th>
                                    <th>前渡金</th><th>送り利用</th>
                                </tr>
                            </thead>
                            <tbody data-report-casts data-min-rows="18"></tbody>
                        </table>
                    </section>
                </div>
            </article>

            <article class="daily-report__page daily-report__page--visits" aria-label="2ページ目 リスト">
                <div class="daily-report__page-content" data-report-page-content>
                    <header class="daily-report__sheet-header">
                        <div class="daily-report__store-name" data-report-department>店舗</div>
                        <h3>③リスト</h3>
                        <div class="daily-report__sheet-date" data-report-sheet-date></div>
                        <span class="daily-report__page-number" aria-hidden="true">2 / 3</span>
                    </header>
                    <table class="daily-report__form-table daily-report__visit-table">
                        <thead>
                            <tr>
                                <th>No</th><th>入店</th><th>卓</th><th>客</th>
                                <th>お客様</th><th>担当キャスト</th><th>会計</th><th>備考</th>
                            </tr>
                        </thead>
                        <tbody data-report-visits data-min-rows="31"></tbody>
                    </table>
                </div>
            </article>

            <article class="daily-report__page daily-report__page--expenses" aria-label="3ページ目 支出内訳">
                <div class="daily-report__page-content" data-report-page-content>
                    <header class="daily-report__sheet-header">
                        <div class="daily-report__store-name" data-report-department>店舗</div>
                        <h3>②支出内訳</h3>
                        <div class="daily-report__sheet-date" data-report-sheet-date></div>
                        <span class="daily-report__page-number" aria-hidden="true">3 / 3</span>
                    </header>
                    <section class="daily-report__sheet-section">
                        <h4 class="daily-report__block-title">支出内訳（勘定科目別）</h4>
                        <table class="daily-report__form-table daily-report__expense-table">
                            <thead><tr><th>勘定科目</th><th>摘要</th><th>金額</th></tr></thead>
                            <tbody data-report-expenses data-min-rows="35"></tbody>
                        </table>
                    </section>
                </div>
                <footer class="daily-report__footer">
                    <span data-report-captured></span>
                    <span>売上は確定会計のみ。現金残高 = 現金売上 − 当営業日に入力した領収書支出（酒代納品は別表示）</span>
                </footer>
            </article>
        </div>
    </div>
</section>
